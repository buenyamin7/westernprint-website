---
import Base from './Base.astro';
interface Props { title: string; description: string; html: string }
const { title, description, html } = Astro.props;
---
<Base title={title} description={description} noindex={false}>
  <section class="section">
    <div class="container">
      <h1>{title}</h1>
      <div class="prose" set:html={html} />
    </div>
  </section>
</Base>
<style>
  /* Lange deutsche Komposita wie „Datenschutzerklärung“ auf schmalen Displays trennen statt überlaufen lassen (lang="de" ist gesetzt).
     overflow-wrap greift nur, wenn der Browser für Deutsch keine Silbentrennung kann. */
  h1 { margin-bottom: 24px; -webkit-hyphens: auto; hyphens: auto; overflow-wrap: anywhere; }
  @media (max-width: 480px) { h1 { font-size: 1.875rem; } }
</style>
