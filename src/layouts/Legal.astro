---
import Base from './Base.astro';
interface Props { title: string; description: string; html: string }
const { title, description, html } = Astro.props;
---
<Base title={title} description={description} noindex={false}>
  <section class="section">
    <div class="container">
      <h1>{title}</h1>
      <div class="prose" set:html={html} />
    </div>
  </section>
</Base>
<style>
  h1 { margin-bottom: 24px; }
</style>
