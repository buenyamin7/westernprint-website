---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href.split('#')[0].split('?')[0]);
---
<header class="nav" id="top" data-nav>
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="westernprint Startseite">
      <img src="/img/logo.png" alt="westernprint" width="150" height="57" />
    </a>

    <nav class="nav-links" aria-label="Hauptnavigation">
      <ul class="nav-list">
        {nav.map((n) => n.groups ? (
          <li class="has-menu">
            <a href={n.href} class="nav-link" aria-current={isActive(n.href) ? 'page' : undefined} aria-haspopup="true" aria-expanded="false">
              {n.label}<Icon name="caret-down" size={12} weight="bold" class="caret" />
            </a>
            <div class="menu" role="group" aria-label={`${n.label} Untermenü`}>
              <div class="menu-inner" data-cols={n.groups.length + (n.cta ? 1 : 0)}>
                {n.groups.map((g) => (
                  <div class="menu-col">
                    <div class="menu-title">{g.title}</div>
                    <ul>
                      {g.items.map((it) => (
                        <li><a href={it.href} class="menu-item">
                          <span class="menu-label">{it.label}</span>
                          {it.hint && <span class="menu-hint">{it.hint}</span>}
                        </a></li>
                      ))}
                    </ul>
                  </div>
                ))}
                {n.cta && (
                  <a href={n.cta.href} class="menu-cta">
                    <span class="menu-cta-label">{n.cta.label}<Icon name="arrow-right" size={16} weight="bold" /></span>
                    <span class="menu-cta-text">{n.cta.text}</span>
                  </a>
                )}
              </div>
            </div>
          </li>
        ) : (
          <li><a href={n.href} class="nav-link" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href={site.phoneHref} class="phone" aria-label="Anrufen"><Icon name="phone" size={16} /><span>0176 55412198</span></a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Farbschema wechseln" data-theme-toggle>
        <span class="only-dark"><Icon name="sun" size={18} /></span>
        <span class="only-light"><Icon name="moon" size={18} /></span>
      </button>
      <a href="/kontakt" class="btn btn-primary btn-sm nav-cta">Angebot in 24h</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="when-closed"><Icon name="list" size={22} /></span>
        <span class="when-open"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="container">
      {nav.map((n) => n.groups ? (
        <details class="m-group">
          <summary><span>{n.label}</span><Icon name="caret-down" size={14} weight="bold" /></summary>
          <div class="m-body">
            <a href={n.href} class="m-all">Alle {n.label === 'Für wen' ? 'Zielgruppen' : n.label} ansehen<Icon name="arrow-right" size={14} /></a>
            {n.groups.map((g) => (
              <div class="m-col">
                <div class="menu-title">{g.title}</div>
                {g.items.map((it) => <a href={it.href}>{it.label}</a>)}
              </div>
            ))}
          </div>
        </details>
      ) : (
        <a href={n.href} class="m-link">{n.label}</a>
      ))}
      <a href="/kontakt" class="m-link">Kontakt</a>
      <div class="m-actions">
        <a href={site.phoneHref} class="btn btn-secondary"><Icon name="phone" size={16} /> Anrufen</a>
        <a href="/kontakt" class="btn btn-primary">Angebot in 24h</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Desktop-Menüs: Hover öffnet per CSS, Tastatur/Touch per Klick auf den Elternlink (erster Klick öffnet, zweiter folgt dem Link).
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('[data-nav] .has-menu'));
  const closeAll = (except?: HTMLLIElement) => items.forEach((li) => { if (li !== except) { li.classList.remove('open'); li.querySelector('.nav-link')?.setAttribute('aria-expanded', 'false'); } });
  // Panel mittig unter dem Link, aber immer innerhalb der Header-Breite (Container-Kante).
  const bounds = document.querySelector<HTMLElement>('[data-nav] .nav-inner')!;
  const place = (li: HTMLLIElement) => {
    const menu = li.querySelector<HTMLElement>('.menu')!;
    const b = bounds.getBoundingClientRect(), l = li.getBoundingClientRect(), w = menu.offsetWidth;
    const pad = parseFloat(getComputedStyle(bounds).paddingLeft) || 0;
    let x = l.width / 2 - w / 2;
    x = Math.min(x, b.right - pad - l.left - w);
    x = Math.max(x, b.left + pad - l.left);
    menu.style.setProperty('--mx', `${Math.round(x)}px`);
  };
  const coarse = window.matchMedia('(hover: none)').matches;
  items.forEach((li) => {
    const link = li.querySelector<HTMLAnchorElement>('.nav-link')!;
    link.addEventListener('click', (e) => {
      const open = li.classList.contains('open');
      if (!open && (coarse || !li.matches(':hover'))) { e.preventDefault(); closeAll(li); place(li); li.classList.add('open'); link.setAttribute('aria-expanded', 'true'); }
    });
    li.addEventListener('mouseenter', () => { closeAll(); place(li); link.setAttribute('aria-expanded', 'true'); });
    li.addEventListener('mouseleave', () => { if (!li.classList.contains('open')) link.setAttribute('aria-expanded', 'false'); });
    li.addEventListener('focusin', () => place(li));
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) { li.classList.remove('open'); link.setAttribute('aria-expanded', 'false'); } });
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-nav] .has-menu')) closeAll(); });
  // Header: kompakter nach dem ersten Scroll
  const header = document.querySelector('[data-nav]')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(130%); -webkit-backdrop-filter: blur(16px) saturate(130%);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .nav.scrolled { border-bottom-color: var(--line); background: color-mix(in srgb, var(--bg) 86%, transparent); }
  .nav-inner { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .brand { flex: none; }
  .brand img { height: 38px; width: auto; filter: brightness(0) invert(1); opacity: 0.94; }
  :global([data-theme="light"]) .brand img { filter: none; opacity: 1; }

  /* Desktop-Links */
  .nav-list { display: flex; align-items: center; gap: 2px; }
  .nav-list > li { position: relative; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 5px; padding: 9px 13px; border-radius: 999px;
    font-size: 14.5px; font-weight: 600; color: var(--text-2); letter-spacing: -0.005em;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .nav-link .caret { transition: transform 0.25s var(--ease); opacity: 0.7; }
  .nav-link:hover, .nav-link[aria-current="page"], .has-menu.open > .nav-link { color: var(--text); background: var(--surface-2); }
  .has-menu.open > .nav-link .caret { transform: rotate(180deg); }

  /* Mega-Menü: liegt unter dem Header, öffnet mit leichtem Slide + Fade */
  .menu {
    position: absolute; top: calc(100% + 10px); left: var(--mx, 0px); transform: translateY(-6px);
    min-width: 280px; padding: 0; opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.22s var(--ease), transform 0.3s var(--ease), visibility 0s linear 0.22s;
  }
  .has-menu.open > .menu, .has-menu:focus-within > .menu { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); transition-delay: 0s; }
  @media (hover: hover) { .has-menu:hover > .menu { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); transition-delay: 0s; } .has-menu:hover > .nav-link { color: var(--text); background: var(--surface-2); } .has-menu:hover > .nav-link .caret { transform: rotate(180deg); } }
  .menu::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  .menu-inner {
    display: grid; gap: 28px; padding: 22px; border-radius: 16px;
    background: var(--surface); border: 1px solid var(--line-strong);
    box-shadow: 0 24px 60px -24px rgba(0,0,0,0.55), 0 0 0 1px rgba(0,0,0,0.2);
  }
  :global([data-theme="light"]) .menu-inner { box-shadow: 0 24px 60px -30px rgba(15,21,18,0.35); }
  .menu-inner[data-cols="1"] { grid-template-columns: 300px; }
  .menu-inner[data-cols="2"] { grid-template-columns: 300px 240px; }
  .menu-inner[data-cols="3"] { grid-template-columns: 280px 280px 230px; }
  .menu-inner[data-cols="4"] { grid-template-columns: repeat(4, 200px); }
  .menu-col ul { display: grid; gap: 2px; }
  .menu-title { font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); padding: 0 10px; margin-bottom: 8px; }
  .menu-item { display: grid; gap: 2px; padding: 8px 10px; border-radius: 10px; transition: background 0.18s var(--ease); }
  .menu-item:hover { background: var(--surface-2); }
  .menu-label { font-weight: 600; font-size: 14.5px; color: var(--text); }
  .menu-item:hover .menu-label { color: var(--accent); }
  .menu-hint { font-size: 12.5px; color: var(--text-2); line-height: 1.4; }
  .menu-cta {
    display: grid; align-content: end; gap: 8px; padding: 18px; border-radius: 12px;
    background: var(--accent-soft); border: 1px solid var(--accent-line); transition: background 0.2s var(--ease);
  }
  .menu-cta:hover { background: color-mix(in srgb, var(--accent) 18%, transparent); }
  .menu-cta-label { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--accent); font-size: 15px; }
  .menu-cta-text { font-size: 13px; color: var(--text-2); line-height: 1.45; }

  /* Actions */
  .nav-actions { display: flex; align-items: center; gap: 8px; flex: none; }
  .phone { display: inline-flex; align-items: center; gap: 7px; padding: 9px 12px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .phone:hover { color: var(--text); background: var(--surface-2); }
  .icon-btn {
    position: relative; width: 42px; height: 42px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent;
    display: grid; place-items: center; cursor: pointer; color: var(--text-2); transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--text-3); background: var(--surface-2); }
  .cart-count { position: absolute; top: -5px; right: -5px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: 11px; font-weight: 700; display: grid; place-items: center; }
  .cart-count[hidden] { display: none; }
  .only-light, :global([data-theme="light"]) .only-dark { display: none; }
  :global([data-theme="light"]) .only-light { display: block; }
  .menu-btn { display: none; }
  .when-open { display: none; }
  .menu-btn[aria-expanded="true"] .when-open { display: block; }
  .menu-btn[aria-expanded="true"] .when-closed { display: none; }

  /* Mobile-Menü */
  .mobile-menu { border-top: 1px solid var(--line); background: var(--bg); max-height: calc(100dvh - var(--nav-h)); overflow-y: auto; }
  .mobile-menu .container { display: flex; flex-direction: column; padding-top: 6px; padding-bottom: 24px; }
  .m-link, .m-group summary { padding: 15px 4px; border-bottom: 1px solid var(--line); font-weight: 600; font-size: 16px; display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .m-group summary { list-style: none; cursor: pointer; }
  .m-group summary::-webkit-details-marker { display: none; }
  .m-group summary .icon { transition: transform 0.25s var(--ease); color: var(--text-3); }
  .m-group[open] summary .icon { transform: rotate(180deg); }
  .m-body { display: grid; gap: 16px; padding: 6px 4px 18px; border-bottom: 1px solid var(--line); }
  .m-all { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--accent); font-size: 14.5px; }
  .m-col { display: grid; gap: 2px; }
  .m-col .menu-title { padding: 0; margin-bottom: 4px; }
  .m-col a { padding: 8px 0; color: var(--text-2); font-size: 15px; }
  .m-col a:hover { color: var(--text); }
  .m-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }

  @media (max-width: 1279px) { .phone span { display: none; } .phone { width: 42px; height: 42px; padding: 0; justify-content: center; border: 1px solid var(--line-strong); } }
  @media (max-width: 1099px) {
    .nav-links, .nav-cta, .phone { display: none; }
    .menu-btn { display: grid; }
  }
</style>
