---
// Google Ads Conversion-Tag mit Consent Mode v2 (Basic): das Tag wird erst nach Zustimmung geladen.
// Ohne site.googleAds.id wird nichts gerendert, die Seite bleibt komplett cookielos.
import { site } from '../data/site';
const ads = site.googleAds;
const enabled = Boolean(ads?.id);
---
{enabled && (
  <Fragment>
    <script is:inline define:vars={{ id: ads.id, conv: ads.conversions }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      gtag('js', new Date());
      gtag('config', id);
      var choice = null; try { choice = localStorage.getItem('wp-consent'); } catch (e) {}
      function loadTag() { if (window.__wpTag) return; window.__wpTag = 1; var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id; document.head.appendChild(s); }
      function grant() { gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' }); loadTag(); }
      window.wpConsent = function (v) { try { localStorage.setItem('wp-consent', v); } catch (e) {} if (v === 'all') grant(); var b = document.getElementById('consent'); if (b) b.hidden = true; };
      window.wpTrack = function (name, value) { var label = conv && conv[name]; if (!label || !window.__wpTag) return; gtag('event', 'conversion', { send_to: id + '/' + label, value: value || 0, currency: 'EUR' }); };
      if (choice === 'all') grant();
      document.addEventListener('DOMContentLoaded', function () {
        if (!choice) { var b = document.getElementById('consent'); if (b) b.hidden = false; }
        document.addEventListener('click', function (e) { var a = e.target && e.target.closest && e.target.closest('a[href*="wa.me"]'); if (a) window.wpTrack('whatsapp'); });
      });
    </script>
    <div id="consent" class="consent" hidden role="dialog" aria-label="Hinweis zur Conversion-Messung">
      <p><strong>Kurze Frage.</strong> Dürfen wir messen, ob unsere Google-Anzeigen zu Anfragen führen? Dafür setzt Google ein Cookie. Ohne Zustimmung funktioniert die Seite genauso, nur ohne Messung. <a href="/datenschutz">Details</a></p>
      <div class="consent-btns">
        <button type="button" class="btn btn-secondary" onclick="wpConsent('none')">Nur notwendige</button>
        <button type="button" class="btn btn-primary" onclick="wpConsent('all')">Einverstanden</button>
      </div>
    </div>
    <style>
      .consent { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 60; margin: 0 auto; max-width: 720px; display: grid; gap: 14px; padding: 18px 20px; border-radius: 16px; border: 1px solid var(--line-strong); background: color-mix(in srgb, var(--surface) 96%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 30px 60px -30px rgba(0,0,0,0.7); font-size: 14.5px; line-height: 1.5; color: var(--text-2); }
      .consent strong { color: var(--text); }
      .consent a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
      .consent-btns { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
      @media (max-width: 900px) { .consent { bottom: 78px; } }
    </style>
  </Fragment>
)}
