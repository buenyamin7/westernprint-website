---
// Google Ads Conversion-Tag mit Consent Mode v2 (Basic): das Tag wird erst nach Zustimmung geladen.
// Ohne site.googleAds.id wird nichts gerendert, die Seite bleibt komplett cookielos.
import { site } from '../data/site';
const ads = site.googleAds;
const meta = site.metaPixel;
const enabled = Boolean(ads?.id);
---
{enabled && (
  <Fragment>
    <script is:inline define:vars={{ id: ads.id, conv: ads.conversions, metaId: meta?.id || '' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      gtag('js', new Date());
      gtag('config', id);
      var choice = null; try { choice = localStorage.getItem('wp-consent'); } catch (e) {}
      // Google-Klick-ID (gclid) nur mit Einwilligung ('all') 90 Tage merken, damit Anfragen später als Offline-Conversion importiert werden können.
      // Ohne Einwilligung bleibt eine gclid aus der URL nur in dieser Variable (verfällt mit der Seite) und wird erst nach Zustimmung gespeichert.
      var GCLID_MAX = 90 * 864e5, pendingGclid = null;
      try { var g = new URLSearchParams(location.search).get('gclid'); if (g) pendingGclid = { id: g, t: Date.now() }; } catch (e) {}
      function dropGclid() { try { localStorage.removeItem('wp-gclid'); } catch (e) {} }
      function storeGclid() { if (!pendingGclid) return; try { localStorage.setItem('wp-gclid', JSON.stringify(pendingGclid)); } catch (e) {} }
      function readGclid() { try { var o = JSON.parse(localStorage.getItem('wp-gclid') || 'null'); if (o && o.id && Date.now() - o.t < GCLID_MAX) return o.id; if (o) dropGclid(); } catch (e) { dropGclid(); } return ''; }
      if (choice === 'all') { storeGclid(); readGclid(); } else dropGclid();
      // Einwilligung bei jedem Abruf frisch lesen: Ein Widerruf in einem anderen Tab gilt sofort auch hier.
      function currentChoice() { try { return localStorage.getItem('wp-consent'); } catch (e) { return choice; } }
      window.wpGclid = function () { if (currentChoice() !== 'all') return ''; return readGclid() || (pendingGclid ? pendingGclid.id : ''); };
      function loadTag() { if (window.__wpTag) return; window.__wpTag = 1; var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id; document.head.appendChild(s); }
      // Meta-Pixel: erst nach Einwilligung laden. PageView auf jeder Seite, Lead bei Anfrage, plus eigenes Event für Streetwear/POD-Seiten (Retargeting-Zielgruppen).
      function loadMeta() {
        if (!metaId || window.__wpMeta) return; window.__wpMeta = 1;
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaId); fbq('track', 'PageView');
        var p = location.pathname; if (/\/fuer\/streetwear-brands/.test(p)) fbq('trackCustom', 'StreetwearSeite'); if (/\/print-on-demand|\/b2b-partner/.test(p)) fbq('trackCustom', 'PODSeite');
      }
      function grant() { gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' }); loadTag(); loadMeta(); }
      // First-Party-Cookies von Google Ads und Meta auf unserer Domain ablaufen lassen (host-only und .westernprint.de).
      function dropAdCookies() {
        var h = location.hostname.split('.'), doms = [''];
        for (var i = 0; i < h.length - 1; i++) doms.push('; domain=.' + h.slice(i).join('.'));
        ['_gcl_au', '_gcl_aw', '_fbp', '_fbc'].forEach(function (n) { doms.forEach(function (d) { document.cookie = n + '=; Max-Age=0; path=/' + d; }); });
      }
      // Consent zurück auf denied, Werbe-Cookies entfernen, Meta-Pixel widerrufen.
      function deny() {
        gtag('consent', 'update', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
        dropAdCookies();
        if (window.fbq) { try { fbq('consent', 'revoke'); } catch (e) {} }
      }
      // Widerruf: zusätzlich eigene Klick-ID löschen und neu laden, damit bereits geladene Tags beendet sind.
      function revoke() { deny(); dropGclid(); location.reload(); }
      window.wpConsent = function (v) {
        var prev = choice; choice = v;
        try { localStorage.setItem('wp-consent', v); } catch (e) {}
        var b = document.getElementById('consent'); if (b) b.hidden = true;
        if (v === 'all') { storeGclid(); grant(); return; }
        dropGclid();
        if (prev === 'all') revoke();
      };
      window.wpTrack = function (name, value) { if (window.__wpMeta && window.fbq) { try { fbq('track', name === 'lead' ? 'Lead' : 'Contact', { content_name: name }); } catch (e) {} } var label = conv && conv[name]; if (!label || !window.__wpTag) return; gtag('event', 'conversion', { send_to: id + '/' + label, value: value || 0, currency: 'EUR' }); };
      // Banner erst per Script bauen und nur, wenn noch keine Wahl gespeichert ist. So lesen Text-Extraktoren (KI-Crawler) den Hinweis nicht als Seitentext.
      var consentAt = document.currentScript;
      function showConsent() {
        function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text) n.textContent = text; return n; }
        var box = el('div', 'consent'); box.id = 'consent'; box.setAttribute('role', 'dialog'); box.setAttribute('aria-label', 'Hinweis zur Conversion-Messung');
        var p = el('p');
        p.appendChild(document.createTextNode('Dürfen wir messen, ob unsere Anzeigen bei Google und Meta (Facebook, Instagram) zu Anfragen führen, und dir dort passende Anzeigen zeigen? Dafür setzen Google und Meta Cookies. Kommst du über eine Google-Anzeige, speichern wir außerdem die Klick-ID in deinem Browser und senden sie mit deiner Anfrage mit. Ohne Zustimmung funktioniert die Seite genauso, nur ohne Messung. Widerrufen kannst du jederzeit unten auf jeder Seite unter „Datenschutzeinstellungen“. '));
        var more = el('a', '', 'Details'); more.setAttribute('href', '/datenschutz'); p.appendChild(more);
        var btns = el('div', 'consent-btns');
        [['none', 'btn btn-secondary', 'Nur notwendige'], ['all', 'btn btn-primary', 'Einverstanden']].forEach(function (d) {
          var btn = el('button', d[1], d[2]); btn.type = 'button';
          btn.addEventListener('click', function () { window.wpConsent(d[0]); });
          btns.appendChild(btn);
        });
        box.appendChild(p); box.appendChild(btns);
        if (consentAt && consentAt.parentNode) consentAt.parentNode.insertBefore(box, consentAt.nextSibling); else document.body.appendChild(box);
        return box;
      }
      // Footer-Link „Datenschutzeinstellungen“: Hinweis jederzeit erneut öffnen, um die Wahl zu ändern oder zu widerrufen.
      window.wpOpenConsent = function () {
        var box = document.getElementById('consent') || showConsent();
        box.hidden = false;
        var first = box.querySelector('button'); if (first) first.focus();
      };
      if (choice === 'all') grant();
      // Wahl in einem anderen Tab geändert: hier übernehmen. Kein Neuladen, damit ein halb ausgefülltes Formular nicht verloren geht.
      window.addEventListener('storage', function (e) {
        if (e.key !== null && e.key !== 'wp-consent') return;
        var v = currentChoice(); if (v === choice) return;
        var prev = choice; choice = v;
        var b = document.getElementById('consent'); if (b && v) b.hidden = true;
        if (v === 'all') { storeGclid(); grant(); return; }
        pendingGclid = null;
        if (prev === 'all') deny();
      });
      document.addEventListener('DOMContentLoaded', function () {
        if (!choice) showConsent();
        // Support-Links auf Status- und Danke-Seiten tragen data-no-track und zählen nicht als Conversion.
        document.addEventListener('click', function (e) { var a = e.target && e.target.closest && e.target.closest('a[href*="wa.me"]:not([data-no-track])'); if (a) window.wpTrack('whatsapp'); var b = e.target && e.target.closest && e.target.closest('a[href*="apps.shopify.com"]'); if (b) window.wpTrack('appstore'); });
        document.addEventListener('click', function (e) { var o = e.target && e.target.closest && e.target.closest('[data-consent-open]'); if (o) { e.preventDefault(); window.wpOpenConsent(); } });
      });
    </script>
    <style>
      .consent { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 60; margin: 0 auto; max-width: 720px; display: grid; gap: 14px; padding: 18px 20px; border-radius: 16px; border: 1px solid var(--line-strong); background: color-mix(in srgb, var(--surface) 96%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 30px 60px -30px rgba(0,0,0,0.7); font-size: 14.5px; line-height: 1.5; color: var(--text-2); }
      .consent a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
      .consent-btns { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
      @media (max-width: 900px) { .consent { bottom: 78px; } }
    </style>
  </Fragment>
)}
