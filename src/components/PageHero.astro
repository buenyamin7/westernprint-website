---
// Kompakter Seitenkopf für Unterseiten. Optional mit Bild rechts.
import Icon from './Icon.astro';
import { imgInfo } from '../lib/imgsize.mjs';
interface Props { eyebrow?: string; title: string; lede: string; image?: string; imageAlt?: string; cta?: { label: string; href: string }; cta2?: { label: string; href: string } }
const { eyebrow, title, lede, image, imageAlt = '', cta, cta2 } = Astro.props;
// Echte Maße und WebP-Varianten (640/960/1400, scripts/make-image-variants.mjs).
const img = image ? await imgInfo(image) : null;
// sizes für object-fit: cover. Desktop: Spalte 50vw, Höhe meist um 620 px (min. clamp(440px, 60vh, 720px), sonst Texthöhe),
// Querformate werden deshalb breiter gezeichnet als die Spalte. Mobil: 4:3-Box über die volle Breite.
function heroSizes(w: number, h: number) {
  const ar = w / h;
  const mobile = Math.max(100, Math.round(75 * ar));
  const k = Math.round(620 * ar);
  return `(max-width: 900px) ${mobile}vw, ${ar > 1 ? `(max-width: ${2 * k}px) ${k}px, ` : ''}50vw`;
}
const sizes = img?.srcset && img.width && img.height ? heroSizes(img.width, img.height) : undefined;
---
<section class={`phero ${image ? 'has-image' : ''}`}>
  <div class="container phero-grid">
    <div class="phero-text">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 set:html={title} />
      <p class="lede">{lede}</p>
      {(cta || cta2) && (
        <div class="phero-cta">
          {cta && <a href={cta.href} class="btn btn-primary btn-lg">{cta.label} <Icon name="arrow-right" size={18} /></a>}
          {cta2 && <a href={cta2.href} class="btn btn-secondary btn-lg">{cta2.label}</a>}
        </div>
      )}
    </div>
    {image && <div class="phero-img"><img src={image} srcset={sizes && img?.srcset} sizes={sizes} alt={imageAlt} width={img?.width ?? 1400} height={img?.height ?? 1050} loading="eager" fetchpriority="high" /></div>}
  </div>
</section>

<style>
  .phero { padding: clamp(56px, 7vw, 96px) 0 clamp(40px, 5vw, 64px); border-bottom: 1px solid var(--line); background: radial-gradient(900px 400px at 15% 0%, var(--accent-soft), transparent 70%); }
  .phero-grid { display: grid; gap: 40px; align-items: center; }
  .phero-text .lede { margin-top: 18px; }
  .phero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  /* Mit Bild: Bild läuft randlos bis zur rechten Kante, Text bleibt auf der Container-Linie. */
  .has-image { padding: 0; border-bottom: 0; background: none; }
  .has-image .phero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; max-width: none; padding: 0; align-items: stretch; }
  .has-image .phero-text { align-self: center; padding: clamp(64px, 9vw, 140px) clamp(32px, 5vw, 80px) clamp(64px, 9vw, 140px) max(24px, calc((100vw - var(--container)) / 2 + 24px)); }
  .has-image .phero-img { position: relative; min-height: clamp(440px, 60vh, 720px); }
  .has-image .phero-img::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, var(--bg) 0%, transparent 22%); }
  .has-image .phero-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; border-radius: 0; border: 0; aspect-ratio: auto; }
  @media (max-width: 900px) {
    .has-image .phero-grid { grid-template-columns: 1fr; }
    .has-image .phero-text { padding: clamp(40px, 8vw, 64px) 24px 40px; }
    .has-image .phero-img { min-height: 0; aspect-ratio: 4 / 3; }
    .has-image .phero-img::before { background: linear-gradient(180deg, var(--bg) 0%, transparent 18%); }
  }
</style>
