---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';

// Vergleich nach § 6 UWG: nur nachprüfbare Angaben aus den offiziellen Seiten der Anbieter, mit Quelle und Stichtag.
// Bei Aktualisierung jede Zeile neu prüfen und STAND anpassen.
const STAND = '15.09.2026';

const rows = [
  { name: 'westernprint', us: true, sitz: 'Oberhausen (DE)', produktion: 'Eigene Produktion in Deutschland', zeit: '1–3 Werktage bis zum Kunden in Deutschland', neck: 'Ja, 3,00 € netto', fee: 'Keine', verfahren: 'DTF, DTG', extra: 'Sample ab 1 Stück, Kleinserie ab 50 mit Lagerung und Einzelversand, Ansprechpartner per WhatsApp und Telefon', src: [] },
  { name: 'Printful', sitz: 'Charlotte (USA), EU-Gesellschaft in Riga (LV)', produktion: 'Eigene Fulfillment-Center, in Europa in Spanien und Lettland', zeit: 'Produktion 2–5 Werktage', neck: 'Ja, Innenetikett 0,99 $', fee: 'Free-Plan 0 $, Growth-Plan 24,99 $/Monat', verfahren: 'DTG, DTF, Stick, All-over', extra: 'Sehr großer Produktkatalog, Versand weltweit', src: [
    ['Deutschland-Seite', 'https://www.printful.com/print-on-demand-germany'], ['Versand', 'https://www.printful.com/shipping'], ['Innenetiketten', 'https://www.printful.com/custom-inside-labels'], ['Preise', 'https://www.printful.com/pricing'] ] },
  { name: 'Printify', sitz: 'Wilmington (USA), Riga (LV), Tallinn (EE)', produktion: 'Netzwerk aus Partnerdruckereien, in Europa u. a. UK, DE, CZ, PL, LV', zeit: 'Meist Versand nach 2–7 Werktagen, je nach Partner', neck: 'Ab 0,55 $, nur bei ausgewählten Partnern', fee: 'Free 0 $, Premium ab 24,99 $/Monat', verfahren: 'DTG, DTF, Stick, Sublimation (je nach Partner)', extra: 'Preis und Qualität hängen vom gewählten Druckpartner ab', src: [
    ['Europa', 'https://printify.com/print-on-demand/europe/'], ['Branding', 'https://printify.com/custom-branding/'], ['Preise', 'https://printify.com/pricing/'] ] },
  { name: 'Gelato', sitz: 'Lysaker (Norwegen)', produktion: 'Netzwerk mit über 140 Partnerstandorten in 32 Ländern', zeit: 'Produktion im Schnitt 1–4 Werktage', neck: 'Ja, bei ausgewählten Artikeln', fee: 'Free 0 $, Gelato+ kostenpflichtig', verfahren: 'DTG, DTF je Standort, Stick', extra: 'Produktion möglichst nah am Endkunden, weltweit', src: [
    ['Shopify App Store', 'https://apps.shopify.com/gelato-print-on-demand'], ['Lieferzeiten', 'https://support.gelato.com/en/articles/8996050-how-quickly-do-you-deliver'] ] },
  { name: 'Shirtee Cloud', sitz: 'Köln (DE)', produktion: 'Eigene Produktion in Köln', zeit: 'Je nach Seite 1–2 Tage bis 3–4 Werktage angegeben', neck: 'Ja, als Branding-Option', fee: 'Keine', verfahren: 'Digitaldruck (DTG), Stick', extra: 'Zusätzlich eigener Marktplatz shirtee.com', src: [
    ['Print-on-Demand', 'https://www.shirtee.com/en/print-on-demand'], ['FAQ', 'https://www.shirtee.com/en/faq'], ['Branding', 'https://shirtee.cloud/de/welche-individuellen-branding-optionen-habe-ich-bei-der-produkterstellung-2/'] ] },
  { name: 'Spreadconnect', sitz: 'Leipzig (DE)', produktion: 'Eigene Standorte in Leipzig, Krupka (CZ) und Legnica (PL)', zeit: 'Unter 48 Stunden für 95 % der Bestellungen', neck: 'Keine Angabe gefunden', fee: 'Keine', verfahren: 'DTG, DTF, Sublimation, Flex, Flock', extra: 'Neutrale Verpackung, eigenes Händler-Branding laut Anbieter noch nicht verfügbar', src: [
    ['Spreadconnect für Shopify', 'https://www.spreadshop.com/spreadconnect-shopify/'], ['Druckverfahren', 'https://www.spreadshop.com/helpcenter/design-products-printing/what-are-spreadconnects-printing-techniques/'] ] },
];

const fits = [
  { icon: 'globe', t: 'Du verkaufst weltweit', d: 'Printful, Printify und Gelato haben Standorte oder Partner auf mehreren Kontinenten und sehr große Kataloge. Sinnvoll, wenn ein großer Teil deiner Kunden außerhalb Europas sitzt.' },
  { icon: 'map-pin', t: 'Deine Kunden sitzen in Deutschland, Österreich und der Schweiz', d: 'Dann spielt kurze Lieferzeit die größte Rolle. Anbieter mit Produktion in Deutschland liefern ohne Umweg über andere Länder, das merkt man besonders im Weihnachtsgeschäft.' },
  { icon: 't-shirt', t: 'Du baust eine Brand auf', d: 'Achte auf Nackenprint statt Herstelleretikett, schwere Blanks, Samples vor dem Launch und die Möglichkeit, Bestseller als Kleinserie günstiger zu produzieren. Genau diese Kombination bieten wir.' },
];

const faqs = [
  { q: 'Welcher Print-on-Demand-Anbieter produziert in Deutschland?', a: `Mit eigener Produktion in Deutschland arbeiten unter anderem westernprint (Oberhausen), Shirtee Cloud (Köln) und Spreadconnect (Leipzig, zusätzlich Tschechien und Polen). Printful produziert für Europa in Spanien und Lettland, Printify und Gelato vermitteln an Partnerdruckereien. Stand: ${STAND}.` },
  { q: 'Welcher POD-Anbieter liefert am schnellsten nach Deutschland?', a: 'Entscheidend ist, wo produziert wird. Bei Produktion in Deutschland kommen Bestellungen in der Regel innerhalb weniger Werktage an. westernprint liefert an Kunden in Deutschland in 1 bis 3 Werktagen per DHL mit Tracking.' },
  { q: 'Kosten Print-on-Demand-Anbieter eine monatliche Gebühr?', a: `Die meisten haben einen kostenlosen Einstieg. Printful, Printify und Gelato bieten zusätzlich kostenpflichtige Pläne mit Rabatten oder Zusatzfunktionen an. Bei westernprint, Shirtee Cloud und Spreadconnect gibt es laut Anbieter keine Grundgebühr. Stand: ${STAND}.` },
  { q: 'Gibt es eine Printful-Alternative aus Deutschland?', a: 'Ja. Wer vor allem an Kunden in Deutschland, Österreich und der Schweiz verkauft, kann zu einem Anbieter mit Produktion in Deutschland wechseln. Bei westernprint verbindest du deinen Shopify-Shop über unsere kostenlose App und legst deine Produkte mit Live-Mockup neu an.' },
  { q: 'Kann ich meinen Nackenprint oder mein eigenes Label nutzen?', a: 'Bei westernprint ja: Wir drucken dein Logo mit Größenangabe als Nackenprint direkt ins Textil, 3,00 € netto pro Teil. Bei den anderen Anbietern ist ein Innenetikett teils möglich, die Konditionen stehen in der Tabelle.' },
  { q: 'Wie wechsle ich den Print-on-Demand-Anbieter?', a: 'App installieren, Textilien auswählen, Motive hochladen und die Produkte in deinem Shop anlegen. Am besten bestellst du vorher ein Sample deines Bestsellers, damit du Stoff und Druck vergleichen kannst. Beim Umzug helfen wir dir persönlich.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'Print-on-Demand-Anbieter in Deutschland im Vergleich', dateModified: '2026-09-15', inLanguage: 'de-DE', author: { '@id': `${site.url}/#organization` }, publisher: { '@id': `${site.url}/#organization` }, mainEntityOfPage: `${site.url}/print-on-demand-anbieter-deutschland` },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Print-on-Demand-Anbieter Deutschland im Vergleich: Printful, Printify, Gelato, Shirtee" description={`Print-on-Demand-Anbieter für Shopify im Vergleich: Wo wird produziert, wie schnell, was kostet Nackenprint und Grundgebühr? westernprint, Printful, Printify, Gelato, Shirtee Cloud und Spreadconnect. Stand ${STAND}.`} jsonLd={ld}>
  <PageHero
    eyebrow="Anbieter-Vergleich"
    title="Print-on-Demand-Anbieter in Deutschland <span class='hl'>im Vergleich.</span>"
    lede={`Wo wird gedruckt, wie schnell ist die Ware beim Kunden, was kosten Nackenprint und Grundgebühr? Sechs Anbieter mit Shopify-App, nebeneinander. Alle Angaben stammen von den offiziellen Seiten der Anbieter, Stand ${STAND}.`}
    cta={{ label: 'Unsere Shopify-App', href: '/print-on-demand#app' }}
    cta2={{ label: 'Sample anfragen', href: '/kontakt' }}
  />

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Die wichtigsten Punkte auf einen Blick</h2>
        <p>Preise pro Produkt vergleichen wir bewusst nicht: Sie hängen vom Textil, der Druckgröße und dem Versandziel ab und ändern sich laufend. Frag uns für deinen Bestseller nach einem konkreten Preis.</p>
      </div>
      <div class="tbl-wrap reveal">
        <table class="cmp">
          <thead>
            <tr><th>Anbieter</th><th>Sitz</th><th>Produktion für Deutschland</th><th>Tempo</th><th>Nackenprint / Innenetikett</th><th>Grundgebühr</th><th>Druckverfahren</th><th>Besonderheit</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class={r.us ? 'is-us' : ''}>
                <th scope="row">{r.name}</th>
                <td data-l="Sitz">{r.sitz}</td>
                <td data-l="Produktion">{r.produktion}</td>
                <td data-l="Tempo">{r.zeit}</td>
                <td data-l="Nackenprint">{r.neck}</td>
                <td data-l="Grundgebühr">{r.fee}</td>
                <td data-l="Verfahren">{r.verfahren}</td>
                <td data-l="Besonderheit">{r.extra}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small note">Tempo ist so angegeben, wie es der jeweilige Anbieter selbst angibt: teils als reine Produktionszeit, teils bis zur Zustellung. Alle Shops haben eine offizielle App im Shopify App Store. Preise in US-Dollar laut Anbieter.</p>
    </div>
  </section>

  <section class="section-tight fit-section">
    <div class="container">
      <div class="section-head reveal"><h2>Welcher Anbieter passt zu deinem Shop?</h2></div>
      <div class="grid grid-3">
        {fits.map((f, i) => (
          <div class={`fit reveal reveal-d${i}`}>
            <div class="icon-box"><Icon name={f.icon} size={22} /></div>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container why">
      <div class="reveal">
        <h2>Warum Shops aus ganz Deutschland zu westernprint wechseln</h2>
        <p class="muted">Wir haben westernprint gegründet, nachdem wir selbst jahrelang Kunde bei Print-on-Demand-Anbietern waren. Deshalb machen wir die Dinge anders, die uns damals gefehlt haben.</p>
      </div>
      <ul class="why-list reveal reveal-d1">
        <li><Icon name="check" weight="bold" size={18} /><div><strong>Eigene Produktion in Deutschland</strong><span>Keine Weitergabe an wechselnde Partner. 1 bis 3 Werktage bis zu deinem Kunden in Deutschland.</span></div></li>
        <li><Icon name="check" weight="bold" size={18} /><div><strong>Sample, Kleinserie und Print-on-Demand aus einer Hand</strong><span>Erst ein Muster, dann Bestseller ab 50 Stück zu Staffelpreisen, der Rest einzeln auf Bestellung.</span></div></li>
        <li><Icon name="check" weight="bold" size={18} /><div><strong>Nackenprint statt Herstelleretikett</strong><span>Dein Logo mit Größenangabe im Nacken, 3,00 € netto pro Teil.</span></div></li>
        <li><Icon name="check" weight="bold" size={18} /><div><strong>Ein fester Ansprechpartner</strong><span>WhatsApp, Telefon, E-Mail. Kein Ticketsystem.</span></div></li>
        <li><Icon name="check" weight="bold" size={18} /><div><strong>Keine Grundgebühr</strong><span>Kostenlose Shopify-App, du zahlst nur, was produziert wird.</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <details class="sources reveal">
        <summary>Quellen der Angaben (Stand {STAND})</summary>
        <ul>
          {rows.filter((r) => !r.us).map((r) => (
            <li><strong>{r.name}:</strong> {r.src.map(([l, u], i) => (<>{i > 0 && ', '}<a href={u} target="_blank" rel="nofollow noopener">{l}</a></>))}</li>
          ))}
        </ul>
        <p class="muted small">Du hast eine veraltete Angabe gefunden? Schreib uns an {site.email}, wir korrigieren sie umgehend.</p>
      </details>
    </div>
  </section>

  <Faq items={faqs} title="Fragen zu Print-on-Demand-Anbietern" />
  <CtaBand title="Teste uns mit deinem Bestseller" text="Schick uns dein Motiv, wir drucken ein Sample und du vergleichst Stoff, Druck und Lieferzeit selbst mit deinem jetzigen Anbieter." />
</Base>

<style>
  .tbl-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .cmp { width: 100%; min-width: 1080px; border-collapse: collapse; font-size: 14px; line-height: 1.45; }
  .cmp th, .cmp td { text-align: left; vertical-align: top; padding: 14px 16px; border-top: 1px solid var(--line); }
  .cmp thead th { border-top: 0; background: var(--bg-2); color: var(--text-3); font-size: 12.5px; font-weight: 600; white-space: nowrap; }
  .cmp tbody th { font-family: var(--font-display); font-size: 15px; white-space: nowrap; }
  .cmp td { color: var(--text-2); }
  .cmp tr.is-us { background: var(--accent-soft); }
  .cmp tr.is-us th { color: var(--accent); }
  .cmp tr.is-us td { color: var(--text); }
  .note { margin-top: 14px; max-width: 80ch; }
  .fit-section { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .fit { display: grid; gap: 12px; padding: 26px; border-radius: var(--radius-card); border: 1px solid var(--line); background: var(--surface); }
  .fit p { color: var(--text-2); font-size: 15px; }
  .why { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .why .muted { margin-top: 14px; max-width: 52ch; }
  .why-list { display: grid; gap: 18px; }
  .why-list li { display: flex; gap: 14px; }
  .why-list :global(.icon) { color: var(--accent); flex: none; margin-top: 3px; }
  .why-list div { display: grid; gap: 3px; }
  .why-list span { color: var(--text-2); font-size: 15px; }
  .sources { border: 1px solid var(--line); border-radius: var(--radius-card); padding: 18px 22px; background: var(--surface); }
  .sources summary { cursor: pointer; font-weight: 600; }
  .sources ul { display: grid; gap: 8px; margin: 16px 0; font-size: 14px; color: var(--text-2); }
  .sources a { color: var(--accent); }
  @media (max-width: 900px) { .why { grid-template-columns: 1fr; } }
</style>
