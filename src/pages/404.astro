---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht mehr oder die Adresse ist falsch." noindex={true}>
  <section class="section">
    <div class="container" style="max-width:640px">
      <h1>Diese Seite gibt es nicht.</h1>
      <p class="lede" style="margin-top:16px">Vielleicht ist der Link alt. Die wichtigsten Seiten findest du hier.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href="/print-on-demand" class="btn btn-secondary">Print-on-Demand</a>
        <a href="/preise" class="btn btn-secondary">Preise</a>
        <a href="/kontakt" class="btn btn-secondary">Kontakt</a>
      </div>
    </div>
  </section>
</Base>
