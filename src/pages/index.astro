---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, stats, faqs } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const prints = [
  { src: '/img/referenz-live2luv.jpg', alt: 'Zwei bedruckte Shirts von live2luv auf dem Werkstattboden: hellblau mit Blumenmotiv, weiß mit pinkem Herz' },
  { src: '/img/lager-regal-werkstatt.jpg', alt: 'Lager bei westernprint: Regal mit gefalteten Rohware-Shirts und Hoodies, Kleiderstange, Heißpressen und Packtisch vor der Ziegelwand' },
  { src: '/img/druck-outside.jpg', alt: 'Nahaufnahme eines mehrfarbigen DTF-Drucks mit Bergmotiv auf grau meliertem Sweatshirt' },
  { src: '/img/druck-makro.jpg', alt: 'Nahaufnahme eines DTF-Drucks auf grau meliertem Shirt, jede Masche und die matte Druckoberfläche sichtbar' },
  { src: '/img/lager-rohware.jpg', alt: 'Regal mit gefalteten Rohware-Shirts und Hoodies nach Farben sortiert, davor eine Heißpresse' },
  { src: '/img/werkstatt-heisspresse.jpg', alt: 'Werkstatt von westernprint: Mitarbeiter an der Heißpresse, Ziegelwand, Regale mit Textilien' },
  { src: '/img/packtisch.jpg', alt: 'Frisch bedruckte Shirts auf dem Packtisch mit Klebeband, Schere und Versandkarton' },
];
---
<Base
  title="Textildruck Oberhausen: DTF- und DTG-Druck ab 1 Stück | westernprint"
  description="Textildruck aus Oberhausen: T-Shirts, Hoodies und Workwear per DTF und DTG bedrucken lassen. Ab 1 Stück, Staffelpreise ab 50, Angebot in 24 Stunden, Produktion in 1 bis 3 Werktagen."
  jsonLd={faqLd}
>
  <!-- Hero: vollflächiges Bild, Text links, Bewertung rechts, Kennzahlen unten (stoff3-Stil) -->
  <section class="hero">
    <img class="hero-bg" src="/img/hero-rack.jpg" alt="" width="1672" height="941" loading="eager" fetchpriority="high" aria-hidden="true" />
    <div class="container hero-grid">
      <div class="hero-text">
        <span class="badge">Inhouse-Produktion in Oberhausen. Ab 1 Stück.</span>
        <h1>Textildruck aus Oberhausen, <span class="hl">der hält.</span> Vom Einzelstück bis zur Großauflage.</h1>
        <p class="lede">T-Shirts, Hoodies, Polos und Workwear mit deinem Motiv. DTF und DTG auf Stanley/Stella und Stedman, gedruckt auf eigenen Maschinen. Angebot in 24 Stunden, fertig in 1 bis 3 Werktagen.</p>
        <div class="hero-cta">
          <a href="/kontakt" class="btn btn-primary btn-lg">Angebot in 24h <Icon name="arrow-right" size={18} /></a>
          <a href="/shop" class="btn btn-secondary btn-lg">Einzelstück selbst gestalten</a>
        </div>
      </div>
      <div class="hero-visual">
        <figure class="review card">
          <div class="stars" aria-label="5 von 5 Sternen">{Array.from({ length: 5 }).map(() => <Icon name="star" weight="fill" size={14} />)}</div>
          <blockquote>„Seit dem Wechsel hat sich mein Retourenanteil halbiert. Kunden loben endlich wieder die Qualität.“</blockquote>
          <figcaption>Tim R., POD-Shop-Betreiber</figcaption>
        </figure>
      </div>
    </div>

    <div class="container hero-stats">
      <div class="stats-grid">
        {stats.map((s, i) => (
          <div class="stat">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leistungen: bento with 5 cells -->
  <section class="section" id="leistungen">
    <div class="container">
      <div class="section-head reveal">
        <h2>Druck, der nach 50 Wäschen noch sitzt</h2>
        <p>Ob ein einzelnes Geschenk, 30 Shirts für den Verein oder 500 Teile für die Firma: Wir drucken alles selbst in Oberhausen, auf eigenen Epson-Maschinen.</p>
      </div>
      <div class="bento">
        <a href="/druckverfahren" class="cell cell-big reveal" style="background-image:url('/img/druck-outside.jpg')">
          <div class="cell-body">
            <span class="tag">Unser Standard</span>
            <h3>DTF-Transferdruck</h3>
            <p>Brillante Farben, feine Linien, Farbverläufe. Hält auf Baumwolle, Mischgewebe und Polyester, waschbeständig bis 60 °C. Ab 1 Stück.</p>
            <span class="more">So funktioniert DTF <Icon name="arrow-right" size={16} /></span>
          </div>
        </a>
        <a href="/druckverfahren" class="cell reveal reveal-d1">
          <div class="icon-box"><Icon name="printer" size={22} /></div>
          <h3>DTG-Direktdruck</h3>
          <p>Fotorealistische Motive direkt ins Gewebe gedruckt. Weicher Griff, ideal für Einzelstücke und Bio-Baumwolle.</p>
          <span class="more">Verfahren vergleichen <Icon name="arrow-right" size={16} /></span>
        </a>
        <a href="/grossauflagen" class="cell reveal reveal-d2">
          <div class="icon-box"><Icon name="buildings" size={22} /></div>
          <h3>Großauflagen ab 50 Stück</h3>
          <p>Vereine, Firmen, Schulen, Events. Staffelpreise, Korrekturabzug vor dem Druck, fester Liefertermin.</p>
          <span class="more">Angebot in 24h <Icon name="arrow-right" size={16} /></span>
        </a>
        <a href="/textilien" class="cell reveal reveal-d3">
          <div class="icon-box"><Icon name="t-shirt" size={22} /></div>
          <h3>Textilien ab Lager</h3>
          <p>Stanley/Stella Bio-Baumwolle und Stedman Basics in über 500 Farben, oder du lieferst eigene Ware an.</p>
          <span class="more">Sortiment ansehen <Icon name="arrow-right" size={16} /></span>
        </a>
        <a href="/shop" class="cell cell-img reveal reveal-d4">
          <img src="/img/prod-drummer.jpg" alt="Stanley/Stella Drummer 2.0 Hoodie" width="720" height="900" loading="lazy" />
          <div class="cell-body">
            <h3>Einzelstück im Shop</h3>
            <p>Motiv hochladen, Position wählen, bestellen. In 1 bis 3 Werktagen bei dir.</p>
            <span class="more">Zum Shop <Icon name="arrow-right" size={16} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Prozess: 4 Schritte + Beispielrechnung -->
  <section class="section process-section">
    <div class="container">
      <div class="section-head reveal">
        <h2>In drei Schritten zu deinen Textilien</h2>
        <p>Kein Ticketsystem, kein Warten. Du schreibst uns, wir antworten innerhalb von 24 Stunden mit einem festen Preis.</p>
      </div>
      <div class="process-grid">
        <ol class="steps">
          {[
            { icon: 'chat-circle-dots', t: 'Anfrage senden', d: 'Motiv, Textil, Stückzahl und Wunschtermin. Per Formular, WhatsApp oder Mail, auch als Skizze.' },
            { icon: 'file-text', t: 'Angebot in 24 Stunden', d: 'Fester Preis, Korrekturabzug mit deinem Motiv auf dem Textil, Liefertermin. Du gibst frei.' },
            { icon: 'package', t: 'Druck und Versand', d: 'Produktion in 1 bis 3 Werktagen, jedes Teil geprüft. Versand mit DHL oder Abholung in Oberhausen.' },
          ].map((s, i) => (
            <li class={`step reveal reveal-d${i}`}>
              <div class="icon-box"><Icon name={s.icon} size={22} /></div>
              <div>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="calc card card-pad reveal reveal-d2" aria-label="Was wir für ein Angebot brauchen">
          <h3>Das brauchen wir für dein Angebot</h3>
          <dl>
            <div><dt>Motiv</dt><dd>PNG, PDF oder Skizze</dd></div>
            <div><dt>Textil</dt><dd>Shirt, Hoodie, Polo, eigene Ware</dd></div>
            <div><dt>Stückzahl</dt><dd>ab 1, Staffel ab 50</dd></div>
            <div><dt>Druckposition</dt><dd>Brust, Rücken, Ärmel</dd></div>
            <div class="total"><dt>Antwort</dt><dd>in 24 Stunden</dd></div>
          </dl>
          <p class="muted">Kein Motiv? Wir setzen Schriftzüge und einfache Logos kostenlos für dich.</p>
          <a href="/kontakt" class="btn btn-primary">Angebot in 24h</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Galerie: echte Drucke, horizontal scroll-snap -->
  <section class="section-tight gallery-section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Echte Drucke, keine Mockups</h2>
      </div>
    </div>
    <div class="marquee reveal" aria-label="Galerie mit Druckbeispielen, läuft endlos durch">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <div class="marquee-group" aria-hidden={copy === 1}>
            {prints.map((p) => (
              <figure>
                <img src={p.src} alt={copy === 0 ? p.alt : ''} width="1400" height="1050" loading="lazy" draggable="false" />
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Über uns: text + USP-Liste, Bild links -->
  <section class="section about">
    <div class="container about-grid">
      <div class="about-img reveal">
        <img src="/img/werkstatt-heisspresse.jpg" alt="Die westernprint Werkstatt in Oberhausen: Heißpressen, Regale mit Rohware, Packtisch" width="1024" height="1536" loading="lazy" />
      </div>
      <div class="about-text">
        <h2 class="reveal">Aus Frust gegründet. Aus Erfahrung gewachsen.</h2>
        <p class="muted reveal reveal-d1">2021 haben wir selbst drucken lassen: lange Lieferzeiten, keine Antwort auf Mails, Drucke, die nach drei Wäschen rissen. Also haben wir die Druckerei gebaut, die wir damals gebraucht hätten. Heute haben über 80.000 bedruckte Teile unsere Werkstatt in Oberhausen verlassen.</p>
        <ul class="usps">
          {[
            { icon: 'factory', t: 'Inhouse in Oberhausen', d: 'Eigene Epson-Maschinen, keine Fremdvergabe.' },
            { icon: 'clock', t: '1 bis 3 Werktage', d: 'Produktion, auch im Weihnachtsgeschäft. Express auf Anfrage.' },
            { icon: 'chat-circle-dots', t: 'Direkter Draht', d: 'WhatsApp und Telefon statt Ticketsystem.' },
            { icon: 'seal-check', t: 'Stanley/Stella und Stedman', d: 'Bio-Baumwolle und Basics, über 500 Farben ab Lager.' },
          ].map((u, i) => (
            <li class={`reveal reveal-d${i + 1}`}>
              <div class="icon-box"><Icon name={u.icon} size={20} /></div>
              <div><strong>{u.t}</strong><span>{u.d}</span></div>
            </li>
          ))}
        </ul>
        <div class="about-links reveal"><a href="/ueber-uns" class="btn btn-secondary">Mehr über uns</a> <a href="/textildruck-oberhausen" class="btn btn-secondary">Textildruck in Oberhausen</a></div>
      </div>
    </div>
  </section>

  <!-- Einsatzbereiche -->
  <section class="section-tight" id="einsatzbereiche">
    <div class="container">
      <div class="section-head reveal">
        <h2>Für wen wir drucken</h2>
        <p>Vom Vereinstrikot bis zur Firmenjacke. Sag uns, was du brauchst, wir sagen dir, was hält.</p>
      </div>
      <div class="areas">
        {[
          { icon: 'trophy', t: 'Vereine und Teams', d: 'Trikots, Trainingsshirts, Fan-Merch mit Namen und Nummern. Mischgrößen ohne Aufpreis.', href: '/grossauflagen' },
          { icon: 'buildings', t: 'Firmen und Workwear', d: 'Poloshirts, Hoodies und Jacken mit Logo. Nachbestellung jederzeit zu Staffelpreisen.', href: '/grossauflagen' },
          { icon: 'confetti', t: 'Events und Abschluss', d: 'Abishirts, JGA, Festival-Crew, Messe. Ein Motiv, viele Größen, fester Termin.', href: '/grossauflagen' },
          { icon: 'storefront', t: 'Gastro und Handel', d: 'Schürzen, Shirts und Caps fürs Team. Einheitlich, waschfest, schnell nachbestellt.', href: '/grossauflagen' },
          { icon: 'gift', t: 'Einzelstücke und Geschenke', d: 'Ein Shirt, ein Hoodie, ein Motiv. Im Shop selbst gestalten, in 1 bis 3 Werktagen da.', href: '/shop' },
          { icon: 'shopping-cart', t: 'Shop-Betreiber', d: 'Print-on-Demand: Wir drucken und versenden deine Shop-Bestellungen neutral in deinem Namen.', href: '/print-on-demand' },
        ].map((a, i) => (
          <a href={a.href} class={`area reveal reveal-d${i % 3}`}>
            <div class="icon-box"><Icon name={a.icon} size={22} /></div>
            <h3>{a.t}</h3>
            <p>{a.d}</p>
            <span class="more">Mehr <Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <Faq items={faqs} intro="Alles, was du vor dem ersten Auftrag wissen willst." />

  <!-- Kontakt -->
  <section class="section contact" id="kontakt">
    <div class="container contact-grid">
      <div class="contact-text reveal">
        <h2>Lass uns dein Projekt starten</h2>
        <p class="muted">Kostenlose Beratung, Angebot meist noch am selben Werktag. Für schnelle Fragen sind wir auf WhatsApp.</p>
        <ul class="channels">
          <li><a href={site.whatsapp} target="_blank" rel="noopener"><div class="icon-box"><Icon name="whatsapp-logo" size={20} /></div><div><strong>WhatsApp</strong><span>{site.phone}</span></div></a></li>
          <li><a href={`mailto:${site.email}`}><div class="icon-box"><Icon name="envelope" size={20} /></div><div><strong>E-Mail</strong><span>{site.email}</span></div></a></li>
          <li><a href={site.phoneHref}><div class="icon-box"><Icon name="phone" size={20} /></div><div><strong>Telefon</strong><span>{site.phone}</span></div></a></li>
          <li><div class="icon-box"><Icon name="map-pin" size={20} /></div><div><strong>Druckerei</strong><span>{site.address.street}, {site.address.zip} {site.address.city}</span></div></li>
        </ul>
      </div>
      <div class="card card-pad reveal reveal-d1">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; min-height: min(94vh, 920px); display: grid; grid-template-rows: 1fr auto; padding-top: calc(var(--nav-h) + clamp(40px, 7vh, 80px)); color: #fff; background: #0b0d0c; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; z-index: 0; animation: hero-bg 1.6s var(--ease) both; }
  @keyframes hero-bg { from { transform: scale(1.06); opacity: 0.6; } to { transform: none; opacity: 1; } }
  @keyframes hero-up { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  .hero .badge, .hero h1, .hero .lede, .hero-cta, .hero .review, .hero-stats .stat { animation: hero-up 0.9s var(--ease) both; }
  .hero .badge { animation-delay: 0.05s; } .hero h1 { animation-delay: 0.15s; } .hero .lede { animation-delay: 0.3s; } .hero-cta { animation-delay: 0.4s; } .hero .review { animation-delay: 0.55s; }
  .hero-stats .stat:nth-child(1) { animation-delay: 0.6s; } .hero-stats .stat:nth-child(2) { animation-delay: 0.68s; } .hero-stats .stat:nth-child(3) { animation-delay: 0.76s; } .hero-stats .stat:nth-child(4) { animation-delay: 0.84s; }
  @media (prefers-reduced-motion: reduce) { .hero-bg, .hero .badge, .hero h1, .hero .lede, .hero-cta, .hero .review, .hero-stats .stat { animation: none; } }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgba(8,10,9,.94) 0%, rgba(8,10,9,.82) 38%, rgba(8,10,9,.45) 70%, rgba(8,10,9,.25) 100%), linear-gradient(180deg, rgba(8,10,9,.35) 0%, rgba(8,10,9,0) 30%, rgba(8,10,9,.55) 75%, rgba(8,10,9,.92) 100%); }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(32px, 5vw, 72px); align-items: center; position: relative; z-index: 2; padding-bottom: clamp(32px, 5vh, 56px); }
  .hero-text h1 { color: #fff; font-size: clamp(2.3rem, 4.9vw, 3.9rem); }
  .hero-text .badge { margin-bottom: 22px; background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); color: #fff; }
  .hero-text .lede { margin-top: 22px; color: rgba(255,255,255,.78); max-width: 560px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .hero-cta .btn-secondary { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.2); color: #fff; }
  .hero-visual { display: flex; justify-content: flex-end; }
  .review { max-width: 360px; padding: 22px 24px; margin: 0; display: grid; gap: 10px; background: rgba(20,24,22,.55); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .review .stars { display: flex; gap: 2px; color: var(--accent); }
  .review blockquote { margin: 0; font-size: 14.5px; line-height: 1.5; font-style: italic; color: #fff; }
  .review figcaption { font-size: 13px; color: rgba(255,255,255,.6); }
  .hero-stats { position: relative; z-index: 2; border-top: 1px solid rgba(255,255,255,.14); padding: 6px 0 clamp(28px, 4vh, 44px); }
  @media (max-width: 1000px) { .hero { min-height: 0; } .hero-grid { grid-template-columns: 1fr; } .hero-visual { justify-content: flex-start; } .review { max-width: none; } .hero-bg { object-position: 60% 50%; } }

  /* Stats */
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 26px 24px 0 0; display: grid; gap: 4px; }
  .stat + .stat { border-left: 1px solid rgba(255,255,255,.14); padding-left: 24px; }
  .stat strong { font-size: clamp(1.7rem, 2.6vw, 2.2rem); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1; color: #fff; }
  .stat span { color: rgba(255,255,255,.65); font-size: 14px; }
  @media (max-width: 800px) { .stats-grid { grid-template-columns: 1fr 1fr; } .stat:nth-child(3) { border-left: 0; padding-left: 0; } .stat:nth-child(n+3) { border-top: 1px solid rgba(255,255,255,.14); padding-top: 18px; margin-top: 18px; } }

  /* Bento */
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .cell { position: relative; display: flex; flex-direction: column; gap: 12px; padding: 28px; border-radius: var(--radius-card); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); transition: transform 0.35s var(--ease), border-color 0.35s var(--ease); overflow: hidden; }
  .cell:hover { transform: translateY(-3px); border-color: var(--accent-line); }
  .cell p { color: var(--text-2); font-size: 15px; }
  .cell .more { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; color: var(--accent); }
  .cell-big { grid-column: 1 / 3; grid-row: 1; min-height: 360px; padding: 0; background-size: cover; background-position: center 30%; justify-content: flex-end; }
  .cell-big .cell-body { padding: 28px; background: linear-gradient(to top, rgba(8,10,9,0.95) 30%, rgba(8,10,9,0.55) 70%, transparent); display: flex; flex-direction: column; gap: 10px; color: #f1f4f2; }
  .cell-big .cell-body p { color: #c9d0cc; max-width: 46ch; }
  .cell-big .tag { align-self: flex-start; background: rgba(255,255,255,0.1); color: #f1f4f2; border-color: rgba(255,255,255,0.15); }
  .cell-big .more { color: #6fe39a; }
  .cell-img { grid-column: 3; grid-row: 1; padding: 0; min-height: 360px; }
  .cell-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .cell-img .cell-body { position: relative; margin-top: auto; padding: 28px; background: linear-gradient(to top, rgba(8,10,9,0.95) 30%, transparent); color: #f1f4f2; display: flex; flex-direction: column; gap: 8px; }
  .cell-img .cell-body p { color: #c9d0cc; }
  .cell-img .more { color: #6fe39a; }
  @media (max-width: 900px) { .bento { grid-template-columns: 1fr 1fr; } .cell-big { grid-column: 1 / 3; grid-row: auto; } .cell-img { grid-column: auto; grid-row: auto; min-height: 320px; } }
  @media (max-width: 600px) { .bento { grid-template-columns: 1fr; } .cell-big { grid-column: auto; } }

  /* Process */
  .process-section { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .process-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: start; }
  .calc h3 { font-size: 17px; margin-bottom: 4px; }
  .areas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .area { display: flex; flex-direction: column; gap: 10px; padding: 26px; border-radius: var(--radius-card); border: 1px solid var(--line); background: var(--surface); transition: transform 0.3s var(--ease), border-color 0.3s var(--ease); }
  .area:hover { transform: translateY(-3px); border-color: var(--accent-line); }
  .area h3 { font-size: 17px; }
  .area p { color: var(--text-2); font-size: 15px; }
  .area .more { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; color: var(--accent); }
  @media (max-width: 900px) { .areas { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .areas { grid-template-columns: 1fr; } }
  .steps { display: grid; gap: 0; counter-reset: step; }
  .step { display: grid; grid-template-columns: auto 1fr; gap: 18px; padding: 22px 0; border-top: 1px solid var(--line); }
  .step:last-child { border-bottom: 1px solid var(--line); }
  .step h3 { margin-bottom: 4px; }
  .step p { color: var(--text-2); font-size: 15px; max-width: 52ch; }
  .calc { display: grid; gap: 14px; position: sticky; top: calc(var(--nav-h) + 24px); }
  .calc dl { margin: 0; display: grid; }
  .calc dl div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .calc dt { color: var(--text-2); }
  .calc dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 500; }
  .calc .total { border-bottom: 0; padding-top: 14px; }
  .calc .total dt { color: var(--text); font-weight: 600; }
  .calc .total dd { color: var(--accent); font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
