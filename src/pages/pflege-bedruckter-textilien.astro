---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site, oeffnungszeiten } from '../data/site';
import { imgInfo } from '../lib/imgsize.mjs';

// Pflegeanleitung vom Inhaber (Bünyamin Dursun): 30 Grad, auf links gedreht, kein Weichspüler, nicht in den Trockner.
// Als Empfehlung formulieren, nicht als Grenze. Keine höhere Temperatur nennen, keine Waschzyklen, keine Haltbarkeitszusagen.
// Bügeln bewusst nicht erwähnt: dazu gibt es auf der Website noch keine Aussage des Inhabers.
// Presskanten (leichte Abdrücke der Heißpresse rund um den Druck): verschwinden nach der ersten Wäsche, kein Mangel
// (vom Inhaber am 28.09.2026 bestätigt). Keine Temperaturgrenze und keine Bügelregel dazuschreiben.
const regeln = [
  { icon: 'thermometer-simple', t: 'Bei 30 Grad waschen',
    d: 'westernprint empfiehlt für DTF- und DTG-Drucke eine Wäsche bei 30 Grad. Eine niedrige Temperatur belastet den Druck weniger als eine heiße Wäsche. Das gilt auch für das Textil selbst, also für Stoff, Farbe und Form.' },
  { icon: 'flip-horizontal', t: 'Auf links gedreht waschen',
    d: 'Dreh das Shirt vor dem Waschen auf links, also mit der Innenseite nach außen. Dann liegt der Druck innen und reibt nicht an der Trommel oder an anderen Teilen in der Maschine.' },
  { icon: 'drop-slash', t: 'Kein Weichspüler',
    d: 'Weichspüler legt sich als dünne Schicht auf die Fasern des Textils. Diese Schicht kann sich auch auf dem Druck absetzen. Wasch bedruckte Textilien deshalb ohne Weichspüler.' },
  { icon: 'prohibit', t: 'Nicht in den Trockner',
    d: 'Im Trockner wirken Hitze und Reibung gleichzeitig auf den Druck. Der DTF-Transfer wird mit Schmelzkleber auf der Heißpresse aufs Textil gebracht. Viel Hitze kann diese Verbindung belasten. Baumwolle kann im Trockner außerdem einlaufen.' },
];

const faqs = [
  { q: 'Wie wasche ich ein bedrucktes T-Shirt richtig?', a: 'westernprint aus Oberhausen empfiehlt für bedruckte T-Shirts eine Wäsche bei 30 Grad. Dreh das Shirt vorher auf links, damit der Druck innen liegt. Nimm keinen Weichspüler und gib das Shirt nicht in den Trockner. Diese Pflegeanleitung gilt für DTF- und DTG-Drucke von westernprint.' },
  { q: 'Gilt die Pflegeanleitung für DTF- und DTG-Druck gleichermaßen?', a: 'Ja. Die Pflegeanleitung von westernprint gilt für DTF- und DTG-Drucke. Beim DTF-Druck wird das Motiv auf eine Folie gedruckt und mit der Heißpresse aufs Textil gepresst. Beim DTG-Druck geht die Tinte direkt in die Textilfaser. Für beide Verfahren empfiehlt westernprint dieselbe schonende Wäsche.' },
  { q: 'Warum soll ich bedruckte Textilien ohne Weichspüler waschen?', a: 'Weichspüler legt sich als dünne Schicht auf die Fasern des Textils. Diese Schicht kann sich auch auf dem Druck absetzen. westernprint empfiehlt deshalb, bedruckte Textilien ohne Weichspüler zu waschen. Das gilt für DTF- und DTG-Drucke.' },
  { q: 'Darf ein bedrucktes T-Shirt in den Trockner?', a: 'westernprint empfiehlt, bedruckte T-Shirts nicht in den Trockner zu geben. Im Trockner wirken Hitze und Reibung gleichzeitig auf den Druck. Baumwolle kann dort außerdem einlaufen. Die Empfehlung gilt für DTF- und DTG-Drucke.' },
  { q: 'Was sind die Abdrücke rund um den Druck?', a: 'Die leichten Abdrücke rund um den Druck sind Presskanten, also Abdrücke der Heißpresse. Sie entstehen beim Pressen in der Produktion von westernprint. Presskanten verschwinden nach der ersten Wäsche und sind kein Mangel. Wasch das Teil wie empfohlen bei 30 Grad, auf links gedreht.' },
  { q: 'Kann ich die Pflegeanleitung an die Kunden meines Shops weitergeben?', a: 'Ja. Die Pflegeanleitung von westernprint für deine Kunden lautet: bei 30 Grad auf links gedreht waschen, kein Weichspüler, nicht in den Trockner. Du kannst sie zum Beispiel in deine Produktbeschreibungen übernehmen.' },
];

const werkstattImg = await imgInfo('/img/werkstatt-heisspresse.jpg');
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Bedruckte T-Shirts richtig waschen: Pflegehinweise für DTF- und DTG-Druck" description="Pflegeanleitung von westernprint aus Oberhausen für DTF- und DTG-Drucke: bei 30 Grad auf links waschen, ohne Weichspüler, nicht in den Trockner. Mit Begründung." jsonLd={[faqLd]}>
  <PageHero
    eyebrow="Pflegehinweise"
    title="Bedruckte T-Shirts richtig waschen. <span class='hl'>Vier Regeln für DTF- und DTG-Drucke.</span>"
    lede="Die Pflegeanleitung von westernprint aus Oberhausen: 30 Grad, auf links gedreht, kein Weichspüler, nicht in den Trockner. Hier steht, warum jede Regel den Druck schont."
    image="/img/druck-makro.jpg"
    imageAlt="Nahaufnahme eines mehrfarbigen Drucks auf grau meliertem Sweatstoff"
  />
  <div class="container">
    <p class="byline">Von <a href="/ueber-uns#inhaber" rel="author">Bünyamin Dursun</a>, Gründer und Geschäftsführer von westernprint</p>
  </div>

  <section class="section-tight">
    <div class="container intro">
      <p class="answer reveal">
        Bedruckte T-Shirts und Hoodies aus der Produktion von westernprint in Oberhausen wäschst du bei 30 Grad.
        Dreh die Teile vor dem Waschen auf links.
        Dann reibt der Druck nicht an der Trommel und nicht an anderen Teilen.
        Nimm keinen Weichspüler und gib die Textilien nicht in den Trockner.
        Diese Pflegeanleitung stammt von Bünyamin Dursun, dem Gründer und Geschäftsführer von <a class="accent" href="/ueber-uns">westernprint</a>.
        Sie gilt für DTF- und DTG-Drucke gleichermaßen.
        Die vier Regeln schonen Druck und Textil bei jeder Wäsche.
        westernprint druckt DTF und DTG in der eigenen Produktion in Oberhausen und versendet deutschlandweit mit DHL.
        Wer einen Shop betreibt, kann die Anleitung an die eigenen Kunden weitergeben.
        Wie die Verfahren funktionieren, erklärt die Seite <a class="accent" href="/druckverfahren">Druckverfahren</a>.
      </p>
      <div class="glance reveal reveal-d1">
        <h2 class="glance-title">Pflege auf einen Blick</h2>
        <ul class="facts">
          {regeln.map((r) => <li><Icon name={r.icon} size={18} /> {r.t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section rules-section" id="regeln">
    <div class="container">
      <div class="section-head reveal">
        <h2>Warum diese vier Regeln?</h2>
        <p>Jede Regel hat einen Grund. Hier steht kurz, was hinter der Empfehlung steckt.</p>
      </div>
      <ol class="rules">
        {regeln.map((r, i) => (
          <li class={`rule reveal reveal-d${i}`}>
            <span class="icon-box"><Icon name={r.icon} size={22} /></span>
            <span class="rule-no">Regel {i + 1}</span>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight method-section" id="dtf-dtg">
    <div class="container method-grid">
      <div class="method-img reveal">
        <img src="/img/werkstatt-heisspresse.jpg" srcset={werkstattImg.srcset} sizes={werkstattImg.srcset ? '(max-width: 900px) 100vw, 40vw' : undefined} alt="Bünyamin Dursun an der Heißpresse in der westernprint-Werkstatt in Oberhausen" width={werkstattImg.width ?? 933} height={werkstattImg.height ?? 1400} loading="lazy" />
      </div>
      <div class="reveal reveal-d1">
        <span class="eyebrow">DTF und DTG</span>
        <h2>Eine Pflegeanleitung für beide Verfahren</h2>
        <p class="muted">Beim DTF-Druck wird das Motiv auf eine Folie gedruckt und mit der Heißpresse aufs Textil gepresst. Beim DTG-Druck geht die Tinte direkt in die Textilfaser. Beide Drucke entstehen in der eigenen Produktion von westernprint in Oberhausen. Für beide gilt dieselbe schonende Wäsche. Welches Verfahren zu deinem Motiv und Textil passt, steht auf der Seite <a href="/druckverfahren">Druckverfahren</a>.</p>
        <p class="muted">Du hast eine Frage zur Pflege oder zu einem besonderen Material? Schreib uns über die <a href="/kontakt">Kontaktseite</a>, per <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a> oder ruf an unter <a href={site.phoneHref}>{site.phone}</a>. westernprint ist {oeffnungszeiten.text} erreichbar.</p>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Fragen zur Pflege" />

  <CtaBand title="Motiv im Kopf, Textil noch offen?" text="Schick uns dein Motiv und das Wunschtextil. Wir sagen dir, welches Verfahren passt, und schicken dir ein Angebot." />
</Base>

<style>
  .byline { padding-top: 20px; font-size: 14px; color: var(--text-3); }
  .byline a { color: var(--text-2); text-decoration: underline; text-underline-offset: 3px; }
  .byline a:hover { color: var(--accent); }
  .intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .answer { max-width: 68ch; font-size: 1.12rem; color: var(--text); }
  .glance-title { font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3); margin-bottom: 14px; }
  .facts { display: grid; gap: 10px; }
  .facts li { display: flex; gap: 10px; align-items: center; color: var(--text-2); font-size: 15px; }
  .facts :global(svg) { color: var(--accent); flex: none; }
  .rules-section { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .rule { display: grid; gap: 12px; align-content: start; padding: clamp(24px, 3vw, 32px); border-radius: var(--radius-card); border: 1px solid var(--line); background: var(--surface); }
  .rule-no { font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3); }
  .rule h3 { font-family: var(--font-display); font-size: clamp(1.25rem, 1.6vw, 1.5rem); line-height: 1.15; letter-spacing: -0.01em; }
  .rule p { color: var(--text-2); font-size: 15.5px; line-height: 1.6; max-width: 58ch; }
  .method-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .method-grid .muted { margin-top: 14px; max-width: 58ch; font-size: 1.05rem; }
  .method-grid .muted a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .method-img img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 45%; border-radius: 20px; border: 1px solid var(--line); }
  @media (max-width: 900px) {
    .intro, .method-grid { grid-template-columns: 1fr; }
    .method-img { order: 2; }
    .method-img img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 640px) { .rules { grid-template-columns: 1fr; } }
</style>
