---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Deine Bestellung" description="Bestellstatus und Bestätigung." noindex={true} hideCta={true}>
  <section class="section">
    <div class="container done" data-endpoint={site.checkoutApi} data-state="loading" aria-busy="true">
      <div class="icon-box big">
        <span data-icon="loading" class="spin"><Icon name="circle-notch" weight="bold" size={28} /></span>
        <span data-icon="ok" hidden><Icon name="check" weight="bold" size={28} /></span>
        <span data-icon="pending" hidden><Icon name="hourglass" weight="bold" size={28} /></span>
        <span data-icon="problem" hidden><Icon name="warning" weight="bold" size={28} /></span>
      </div>
      <h1 data-h1>Wir prüfen deine Bestellung...</h1>
      <p class="lede" data-msg aria-live="polite">Einen Moment bitte.</p>
      <div class="card card-pad summary" data-summary hidden>
        <p><strong>Bestellnummer:</strong> <span data-no></span></p>
        <ul data-items></ul>
        <p class="muted small">Bestätigung geht an <span data-email></span>.</p>
      </div>
      <div class="card card-pad bank" data-bank hidden>
        <h2>Bitte jetzt überweisen</h2>
        <p class="muted">Wir starten den Druck, sobald das Geld da ist. Die Daten hast du auch per E-Mail von Mollie bekommen.</p>
        <dl class="bankdata">
          <div><dt>Betrag</dt><dd data-bank-amount></dd></div>
          <div><dt>IBAN</dt><dd data-bank-iban></dd></div>
          <div><dt>BIC</dt><dd data-bank-bic></dd></div>
          <div><dt>Empfänger</dt><dd data-bank-holder></dd></div>
          <div><dt>Verwendungszweck</dt><dd data-bank-ref></dd></div>
        </dl>
        <p class="muted small">Bitte den Verwendungszweck genau so angeben, sonst kann die Zahlung nicht zugeordnet werden. Zahlbar bis <span data-bank-until></span>.</p>
      </div>
      <div class="card card-pad track" data-track hidden>
        <h2>Deine Sendung</h2>
        <p>Sendungsnummer: <strong data-track-no></strong> <span class="muted" data-track-carrier></span></p>
        <a data-track-link class="btn btn-primary" target="_blank" rel="noopener"><Icon name="truck" size={18} /> Sendung verfolgen</a>
      </div>
      <div class="card card-pad upload-hint" data-upload-hint hidden>
        <h2>Motiv nachreichen</h2>
        <p class="muted">Für mindestens eine Position fehlt noch das Druckmotiv. Schick es uns als PNG mit deiner Bestellnummer:</p>
        <div class="actions">
          <a data-wa class="btn btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} /> Per WhatsApp</a>
          <a data-mail class="btn btn-secondary"><Icon name="envelope" size={18} /> Per E-Mail</a>
        </div>
      </div>
      <div class="card card-pad contact" data-contact hidden>
        <div class="actions">
          <a href={site.whatsapp} data-contact-wa data-no-track class="btn btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} /> Per WhatsApp</a>
          <a href={`mailto:${site.email}`} data-contact-mail class="btn btn-secondary"><Icon name="envelope" size={18} /> Per E-Mail</a>
        </div>
        <p class="muted small">WhatsApp {site.phone} · {site.email}</p>
      </div>
      <div class="actions">
        <a href="/warenkorb" class="btn btn-primary" data-retry hidden><Icon name="shopping-cart" size={18} /> Zurück zum Warenkorb</a>
        <button type="button" class="btn btn-secondary" data-reload hidden><Icon name="arrow-clockwise" size={18} /> Status neu laden</button>
        <a href="/shop" class="btn btn-secondary">Zurück zum Shop</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { clearCartFor } from '../scripts/cart';
  const root = document.querySelector<HTMLElement>('.done')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const id = new URLSearchParams(location.search).get('order');
  const orderNo = id && /^WP-[A-Z0-9-]{6,20}$/.test(id) ? id : ''; // Format wie im Kassen-Worker (ORDER_RE)

  // Statuswerte aus dem Kassen-Worker bzw. Airtable "Shop-Bestellungen" (Feld Status).
  // ok = bezahlt. pending = Zahlung läuft noch. failed = Zahlung nicht abgeschlossen.
  // Warenkorb wird bei ok und bei „Wartet auf Überweisung“ geleert (Bestellung steht, Bankdaten sind da), aber nur für die Bestellung aus dieser Kasse.
  type State = 'ok' | 'pending' | 'failed' | 'cancelled' | 'unclear';
  const STATUS: Record<string, [State, string, string]> = {
    'Neu': ['ok', 'Danke, deine Bestellung ist da.', 'Wir prüfen deine Daten und starten die Produktion. Die Bestätigung kommt per E-Mail.'],
    'In Produktion': ['ok', 'Deine Bestellung wird gerade gedruckt.', 'Sobald das Paket unterwegs ist, bekommst du die Sendungsnummer per E-Mail.'],
    'Versendet': ['ok', 'Deine Bestellung ist unterwegs.', 'Das Paket wurde übergeben. Mit der Sendungsnummer kannst du es verfolgen.'],
    'Zahlung offen': ['pending', 'Deine Zahlung wird noch verarbeitet.', 'Sobald sie bestätigt ist, bekommst du die Bestätigung per E-Mail. Bitte bestell in der Zwischenzeit nicht noch einmal.'],
    'Wartet auf Überweisung': ['pending', 'Deine Bestellung ist gespeichert.', 'Sobald deine Überweisung bei uns eingeht, bekommst du die Bestätigung per E-Mail und wir starten den Druck.'],
    'Abgebrochen': ['failed', 'Die Zahlung wurde nicht abgeschlossen.', 'Du kannst es im Warenkorb erneut versuchen.'],
    'Storniert': ['cancelled', 'Diese Bestellung wurde storniert.', 'Falls schon bezahlt wurde, erstatten wir den Betrag über den genutzten Zahlungsweg.'],
  };

  function show(state: State, title: string, text: string, reload = state === 'pending' || (state === 'unclear' && !!orderNo)) {
    root.dataset.state = state; root.removeAttribute('aria-busy');
    const icon = state === 'ok' ? 'ok' : state === 'pending' ? 'pending' : 'problem';
    root.querySelectorAll<HTMLElement>('[data-icon]').forEach((el) => (el.hidden = el.dataset.icon !== icon));
    $('[data-h1]').textContent = title; $('[data-msg]').textContent = text;
    $('[data-retry]').hidden = state !== 'failed';
    $('[data-reload]').hidden = !reload;
    $('[data-contact]').hidden = !(state === 'unclear' || state === 'cancelled');
  }

  // Kontaktknöpfe mit Bestellnummer vorbefüllen.
  function prefillContact() {
    const text = encodeURIComponent(`Hallo, ich habe eine Frage zu meiner Bestellung ${orderNo}.`);
    $<HTMLAnchorElement>('[data-contact-wa]').href += `?text=${text}`;
    $<HTMLAnchorElement>('[data-contact-mail]').href += `?subject=${encodeURIComponent('Bestellung ' + orderNo)}&body=${text}`;
  }

  // Keine Nummer, unbekannte Bestellung, Fehler: nichts behaupten, Kontaktweg zeigen, Warenkorb bleibt.
  function unclear() {
    if (!orderNo) return show('unclear', 'Wir können diesen Link keiner Bestellung zuordnen.', 'Wenn du gerade bezahlt hast oder eine Frage zu deiner Bestellung hast, schreib uns per WhatsApp oder E-Mail.');
    show('unclear', 'Wir können deine Bestellung gerade nicht abrufen.', `Wenn du gerade bezahlt hast, bestell bitte nicht noch einmal, sondern schreib uns per WhatsApp oder E-Mail mit deiner Bestellnummer ${orderNo}. Dann sehen wir nach.`);
    prefillContact();
  }

  // Bestellung gefunden, aber Status nicht in der Tabelle: neutral bleiben, Neuladen hilft hier nicht.
  function otherStatus() {
    show('unclear', `Deine Bestellung ${orderNo}`, 'Den genauen Stand können wir dir hier nicht anzeigen. Schreib uns per WhatsApp oder E-Mail mit deiner Bestellnummer, dann sehen wir für dich nach.', false);
    prefillContact();
  }

  function render(o: any) {
    const entry = STATUS[o.status];
    if (!entry) return otherStatus();
    const [state, title, text] = entry;
    show(state, title, text);
    if (state === 'ok' || state === 'pending') {
      $('[data-no]').textContent = o.orderNo;
      $('[data-email]').textContent = o.email;
      const list = $('[data-items]'); list.replaceChildren(...(o.items || []).map((l: string) => { const li = document.createElement('li'); li.textContent = l.split(' | ')[0]; return li; }));
      $('[data-summary]').hidden = false;
    }
    if (o.bank) {
      const b = $('[data-bank]'); b.hidden = false;
      const set = (k: string, v: string) => (b.querySelector(`[data-bank-${k}]`)!.textContent = v);
      set('amount', String(o.bank.amount).replace('.', ',') + ' €'); set('iban', (o.bank.iban || '').replace(/(.{4})/g, '$1 ').trim()); set('bic', o.bank.bic || ''); set('holder', o.bank.holder || ''); set('ref', o.bank.reference || '');
      set('until', o.bank.until ? new Date(o.bank.until).toLocaleDateString('de-DE') : '');
    }
    if (o.tracking) {
      const t = $('[data-track]'); t.hidden = false;
      t.querySelector('[data-track-no]')!.textContent = o.tracking; t.querySelector('[data-track-carrier]')!.textContent = o.carrier ? `(${o.carrier})` : '';
      const a = t.querySelector<HTMLAnchorElement>('[data-track-link]')!; if (o.trackingUrl) a.href = o.trackingUrl; else a.hidden = true;
    }
    if (o.needsUpload && (state === 'ok' || state === 'pending')) {
      const hint = $('[data-upload-hint]'); hint.hidden = false;
      const text = encodeURIComponent(`Hallo, hier mein Motiv zur Bestellung ${o.orderNo}.`);
      (hint.querySelector('[data-wa]') as HTMLAnchorElement).href = `https://wa.me/4917655412198?text=${text}`;
      (hint.querySelector('[data-mail]') as HTMLAnchorElement).href = `mailto:info@westernprint.de?subject=${encodeURIComponent('Motiv zur Bestellung ' + o.orderNo)}&body=${text}`;
    }
    // Erst wenn die Bestellung steht (bezahlt oder Überweisung angelegt), ist der Warenkorb erledigt.
    if (state === 'ok' || o.status === 'Wartet auf Überweisung') clearCartFor(orderNo);
  }

  $('[data-reload]').addEventListener('click', () => location.reload());
  if (!orderNo) unclear();
  else fetch(`${root.dataset.endpoint}/order?order=${encodeURIComponent(orderNo)}`, { signal: AbortSignal.timeout?.(15000) })
    .then(async (r) => { const o = await r.json(); if (!r.ok || !o.orderNo) throw new Error('Bestellung nicht gefunden'); return o; })
    .then(render)
    .catch(unclear);
</script>

<style>
  .done { max-width: 640px; display: grid; gap: 22px; justify-items: start; }
  .big { width: 60px; height: 60px; border-radius: 16px; }
  .big > span { display: grid; place-items: center; }
  .done[data-state="loading"] .big, .done[data-state="pending"] .big, .done[data-state="unclear"] .big { color: var(--text-2); }
  .done[data-state="failed"] .big, .done[data-state="cancelled"] .big { color: var(--danger); }
  .spin { animation: wp-spin 1s linear infinite; }
  @keyframes wp-spin { to { transform: rotate(360deg); } }
  .summary, .upload-hint, .bank, .track, .contact { width: 100%; display: grid; gap: 10px; justify-items: start; }
  .bankdata { display: grid; gap: 6px; margin: 0; width: 100%; }
  .bankdata div { display: grid; grid-template-columns: 150px 1fr; gap: 12px; font-size: 15px; }
  .bankdata dt { color: var(--text-3); } .bankdata dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .summary ul { display: grid; gap: 4px; color: var(--text-2); font-size: 14.5px; }
  .small { font-size: 13px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
