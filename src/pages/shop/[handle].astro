---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProducts, euro, PRINT_SIZES } from '../../lib/shopify';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle }, props: { product: p } }));
}
const { product: p } = Astro.props;
const gallery = [p.image, p.modelImage, ...p.extraImages].filter((x, i, a) => x && a.indexOf(x) === i) as string[];
const clientData = { product: { id: p.id, handle: p.handle, title: p.title, price: p.price, image: p.image, colors: p.colors, sizes: p.sizes, variants: p.variants }, sizes: PRINT_SIZES, cloud: site.cloudinary };
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: `${p.title} bedrucken`, image: gallery.map((g) => `${site.url}${g}`), description: `${p.title} von ${p.brand} mit eigenem Motiv bedrucken. ${p.colors.length} Farben, Größen ${p.sizes[0]} bis ${p.sizes[p.sizes.length - 1]}.`, brand: { '@type': 'Brand', name: p.brand }, offers: { '@type': 'Offer', priceCurrency: 'EUR', price: (p.price + 5).toFixed(2), availability: 'https://schema.org/InStock', url: `${site.url}/shop/${p.handle}` } };
const details = [
  p.grammage && ['Grammatur', p.grammage], p.fit && ['Passform', p.fit], p.composition && ['Material', p.composition],
  ['Marke', p.brand], ['Für', p.gender], ['Farben', `${p.colors.length}`], ['Größen', `${p.sizes[0]} bis ${p.sizes[p.sizes.length - 1]}`],
].filter(Boolean) as [string, string][];
---
<Base title={`${p.title} bedrucken lassen`} description={`${p.title} von ${p.brand} mit eigenem Motiv per DTF bedrucken. ${p.colors.length} Farben, Größen ${p.sizes[0]} bis ${p.sizes[p.sizes.length - 1]}, ab 1 Stück, Versand in 1-3 Werktagen.`} ogImage={p.image ?? undefined} jsonLd={ld} hideCta={true}>
  <section class="pp">
    <div class="container">
      <nav class="crumbs muted" aria-label="Pfad"><a href="/shop">Shop</a> <span>/</span> <a href={`/shop?kategorie=${encodeURIComponent(p.category)}`}>{p.category}</a> <span>/</span> <span>{p.title}</span></nav>
      <div class="pgrid">
        <!-- Vorschau -->
        <div class="pvisual">
          <div class="stage" data-stage>
            <img src={p.image} alt={`${p.title} ${p.colors[0]?.name ?? ''}`} width="900" height="1125" data-stage-img />
            <img class="motif" data-motif hidden alt="" draggable="false" />
            <div class="stage-tabs" data-side-tabs>
              <button type="button" class="is-on" data-view="front">Vorne</button>
              <button type="button" data-view="back">Hinten</button>
            </div>
            <span class="stage-hint" data-stage-hint hidden><Icon name="arrows-out-cardinal" size={14} /> Motiv verschieben</span>
          </div>
          <div class="thumbs">
            {gallery.map((g, i) => <button type="button" class={i === 0 ? 'is-on' : ''} data-thumb={g}><img src={g} alt="" width="120" height="150" loading="lazy" /></button>)}
          </div>
        </div>

        <!-- Konfigurator -->
        <form class="config" data-config novalidate>
          <div class="ptitle">
            <span class="pbrand">{p.brand} <span>{p.gender}</span> {p.brand === 'Stanley/Stella' && <em class="bio">Bio-Baumwolle</em>}</span>
            <h1>{p.title}</h1>
            <p class="pprice"><strong data-total>{euro(p.price + 5)}</strong> <span class="muted">inkl. Druck und MwSt., zzgl. Versand</span></p>
          </div>

          <div class="step">
            <div class="step-h"><span class="num">1</span><h2>Farbe <span data-color-label class="muted">{p.colors[0]?.name}</span></h2></div>
            <div class="swatches">
              {p.colors.map((c, i) => (
                <label class={`swatch ${c.image ? 'has-img' : ''}`} title={c.name} style={`--sw:${c.hex || '#e6e6e6'}`}>
                  <input type="radio" name="color" value={c.id} checked={i === 0} data-image={c.image} data-back={c.back} data-name={c.name} />
                  {c.image ? <img src={c.image} alt={c.name} width="64" height="80" loading="lazy" /> : <i style={`background:${c.hex || '#ccc'}`}></i>}
                </label>
              ))}
            </div>
          </div>

          <div class="step">
            <div class="step-h"><span class="num">2</span><h2>Größe</h2><a href="#groessen" class="muted small">Passform und Details</a></div>
            <div class="chips" data-sizes>
              {p.sizes.map((s) => <label class="chip"><input type="radio" name="size" value={s} /> <span>{s}</span></label>)}
            </div>
            <span class="error" data-size-error hidden>Bitte eine Größe wählen.</span>
          </div>

          <div class="step">
            <div class="step-h"><span class="num">3</span><h2>Druck</h2></div>
            <div class="sides">
              {[['Vorderseite', 'Nur vorne'], ['Rückseite', 'Nur hinten'], ['Beide Seiten', 'Vorne und hinten']].map(([v, l], i) => (
                <label class="side-opt"><input type="radio" name="side" value={v} checked={i === 0} /><span>{l}</span></label>
              ))}
            </div>
            {['front', 'back'].map((k) => (
              <fieldset class="print-side" data-side={k}>
                <legend>{k === 'front' ? 'Vorderseite' : 'Rückseite'}</legend>
                <div class="chips chips-size">
                  {PRINT_SIZES.map((s, i) => <label class="chip"><input type="radio" name={`size_${k}`} value={s.key} checked={i === 2} /> <span>{s.label} <small>{s.hint}, +{s.surcharge} €</small></span></label>)}
                </div>
                <label class="upload" data-upload>
                  <input type="file" name={`file_${k}`} accept=".png,image/png" />
                  <span class="upload-box">
                    <span class="upload-thumb" data-upload-thumb><Icon name="upload-simple" size={22} /></span>
                    <span class="upload-text"><strong data-upload-label>Motiv hochladen</strong><small data-upload-sub>PNG mit transparentem Hintergrund, max. 10 MB. Du kannst es auch nach der Bestellung schicken.</small></span>
                  </span>
                </label>
                <span class="error" data-upload-error hidden></span>
              </fieldset>
            ))}
          </div>

          <div class="buy">
            <div class="qty-row">
              <span>Menge</span>
              <div class="qty"><button type="button" data-qty="-1" aria-label="Weniger">−</button><input id="qty" name="qty" type="number" min="1" max="99" value="1" /><button type="button" data-qty="1" aria-label="Mehr">+</button></div>
            </div>
            <ul class="calc" data-calc></ul>
            <button type="submit" class="btn btn-primary btn-lg" data-add>In den Warenkorb <Icon name="shopping-cart" size={18} /></button>
            <p class="form-note" data-note hidden></p>
            <ul class="trust">
              <li><Icon name="printer" size={16} /> DTF-Druck in Oberhausen, waschfest</li>
              <li><Icon name="truck" size={16} /> Versand 4,90 €, 1 bis 3 Werktage</li>
              <li><Icon name="shield-check" size={16} /> PayPal, Klarna, Karte, Apple Pay</li>
            </ul>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section-tight pdetails" id="groessen">
    <div class="container details-grid">
      <div class="card card-pad">
        <h2>Produktdetails</h2>
        <dl class="specs">{details.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        {p.description.length > 0 && <ul class="feat-list">{p.description.slice(0, 8).map((d) => <li>{d}</li>)}</ul>}
      </div>
      <div class="card card-pad">
        <h2>So wird gedruckt</h2>
        <p class="muted">Wir drucken per DTF (Direct to Film): deckend auf hellen und dunklen Stoffen, dehnbar, waschfest bei 30 bis 40 Grad. Das Motiv sollte als PNG mit transparentem Hintergrund und mindestens 300 dpi vorliegen. Wir prüfen jede Datei vor dem Druck und melden uns, wenn etwas nicht passt.</p>
        <h3>Druckgrößen</h3>
        <ul class="sizes-list">{PRINT_SIZES.map((s) => <li><strong>{s.label}</strong> {s.hint}, +{s.surcharge} € je Seite</li>)}</ul>
        <h3>Größen</h3>
        <p class="muted">{p.sizes.join(', ')}. Die Maßtabelle des Herstellers schicken wir dir auf Anfrage per WhatsApp, oder du orientierst dich an deiner üblichen Größe: {p.fit ? `${p.fit}.` : 'Die Basics fallen normal aus.'}</p>
      </div>
    </div>
  </section>
  <script type="application/json" id="pdata" set:html={JSON.stringify(clientData)} />
</Base>

<script>
  import { addItem, euro } from '../../scripts/cart';
  const data = JSON.parse(document.getElementById('pdata')!.textContent!);
  const { product, sizes: SIZES, cloud } = data;
  const form = document.querySelector<HTMLFormElement>('[data-config]')!;
  const $ = <T extends HTMLElement>(s: string, root: ParentNode = form) => root.querySelector<T>(s)!;
  const stage = $<HTMLElement>('[data-stage]', document);
  const stageImg = $<HTMLImageElement>('[data-stage-img]', document);
  const motif = $<HTMLImageElement>('[data-motif]', document);
  const hint = $<HTMLElement>('[data-stage-hint]', document);
  const tabs = $<HTMLElement>('[data-side-tabs]', document);
  type Side = 'front' | 'back';
  const uploads: Record<Side, { url: string; name: string } | null> = { front: null, back: null };
  const pos: Record<Side, { x: number; y: number }> = { front: { x: 50, y: 40 }, back: { x: 50, y: 38 } };
  let view: Side = 'front';

  const val = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
  const active = () => { const s = val('side'); return { front: s !== 'Rückseite', back: s !== 'Vorderseite' }; };
  const colorEl = () => form.querySelector<HTMLInputElement>('input[name="color"]:checked')!;
  const variant = () => product.variants.find((v: any) => v.color === val('color') && v.size === val('size'));
  const qty = () => Math.max(1, Math.min(99, Number($<HTMLInputElement>('#qty').value) || 1));
  const sizeInfo = (key: string) => SIZES.find((s: any) => s.key === key);

  function updateAvailability() {
    form.querySelectorAll<HTMLInputElement>('input[name="size"]').forEach((inp) => {
      const v = product.variants.find((x: any) => x.color === val('color') && x.size === inp.value);
      const ok = !!v && v.available; inp.disabled = !ok; inp.closest('label')!.classList.toggle('is-off', !ok);
      if (!ok && inp.checked) inp.checked = false;
    });
  }
  function updateSides() {
    const a = active();
    (['front', 'back'] as Side[]).forEach((k) => { const fs = $<HTMLFieldSetElement>(`[data-side="${k}"]`); fs.hidden = !a[k]; fs.disabled = !a[k]; });
    if (!a[view]) view = a.front ? 'front' : 'back';
    renderStage();
  }
  function total() {
    const a = active(); const v = variant(); const base = v ? v.price : product.price;
    const sf = a.front ? sizeInfo(val('size_front')).surcharge : 0, sb = a.back ? sizeInfo(val('size_back')).surcharge : 0;
    return { base, sf, sb, unit: base + sf + sb, sum: (base + sf + sb) * qty() };
  }
  function renderCalc() {
    const t = total(); const a = active(); const n = qty();
    $('[data-total]').textContent = euro(t.sum);
    $('[data-calc]').innerHTML = [
      `<li><span>${product.title} ${colorEl().dataset.name} ${val('size') ? '/ ' + val('size') : ''}</span><b>${euro(t.base)}</b></li>`,
      a.front ? `<li><span>Druck vorne ${val('size_front')}</span><b>+ ${euro(t.sf)}</b></li>` : '',
      a.back ? `<li><span>Druck hinten ${val('size_back')}</span><b>+ ${euro(t.sb)}</b></li>` : '',
      n > 1 ? `<li><span>x ${n} Stück</span><b>${euro(t.sum)}</b></li>` : '',
    ].join('');
  }
  function renderStage() {
    const c = colorEl(); const a = active();
    const backAvailable = !!c.dataset.back && c.dataset.back !== 'null';
    tabs.hidden = !(a.front && a.back) && !(view === 'back');
    tabs.querySelectorAll<HTMLButtonElement>('button').forEach((b) => { b.classList.toggle('is-on', b.dataset.view === view); b.hidden = (b.dataset.view === 'front' && !a.front) || (b.dataset.view === 'back' && !a.back); });
    const src = view === 'back' && backAvailable ? c.dataset.back! : (c.dataset.image && c.dataset.image !== 'null' ? c.dataset.image : product.image);
    if (stageImg.src !== location.origin + src) stageImg.src = src;
    document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) => b.classList.toggle('is-on', b.dataset.thumb === src));
    const up = uploads[view];
    if (!up) { motif.hidden = true; hint.hidden = true; return; }
    const pct = sizeInfo(val(`size_${view}`)).pct; const pp = pos[view];
    motif.src = up.url; motif.hidden = false; hint.hidden = false;
    motif.style.width = pct + '%'; motif.style.left = pp.x + '%'; motif.style.top = pp.y + '%';
  }
  function updateUI() { $('[data-color-label]').textContent = colorEl().dataset.name || ''; renderCalc(); renderStage(); }

  // Motiv auf der Vorschau verschieben
  let dragging = false;
  motif.addEventListener('pointerdown', (e) => { dragging = true; motif.setPointerCapture(e.pointerId); e.preventDefault(); });
  motif.addEventListener('pointermove', (e) => { if (!dragging) return; const r = stage.getBoundingClientRect(); pos[view] = { x: Math.min(92, Math.max(8, ((e.clientX - r.left) / r.width) * 100)), y: Math.min(92, Math.max(8, ((e.clientY - r.top) / r.height) * 100)) }; renderStage(); });
  motif.addEventListener('pointerup', () => (dragging = false));
  motif.addEventListener('pointercancel', () => (dragging = false));
  tabs.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return; view = b.dataset.view as Side; renderStage(); });
  document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) => b.addEventListener('click', () => { stageImg.src = b.dataset.thumb!; motif.hidden = true; hint.hidden = true; document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((x) => x.classList.toggle('is-on', x === b)); }));

  // Upload je Seite
  async function uploadFile(file: File): Promise<string> {
    if (!cloud?.cloudName || !cloud?.uploadPreset) return URL.createObjectURL(file);
    const fd = new FormData(); fd.append('file', file); fd.append('upload_preset', cloud.uploadPreset); fd.append('folder', 'westernprint-shop');
    const res = await fetch(`https://api.cloudinary.com/v1_1/${cloud.cloudName}/image/upload`, { method: 'POST', body: fd });
    if (!res.ok) throw new Error('Upload fehlgeschlagen, bitte nochmal versuchen');
    return (await res.json()).secure_url;
  }
  // Mockup (Packshot + Motiv an der gewählten Position) als Bild für die Produktion speichern
  const loadImg = (src: string) => new Promise<HTMLImageElement>((ok, no) => { const im = new Image(); im.crossOrigin = 'anonymous'; im.onload = () => ok(im); im.onerror = () => no(new Error('Bild konnte nicht geladen werden')); im.src = src; });
  async function renderMockup(k: Side): Promise<string | null> {
    const up = uploads[k]; if (!up || up.url.startsWith('blob:') || !cloud?.cloudName) return null;
    const c = colorEl(); const backAvailable = !!c.dataset.back && c.dataset.back !== 'null';
    const shirtSrc = k === 'back' && backAvailable ? c.dataset.back! : (c.dataset.image && c.dataset.image !== 'null' ? c.dataset.image : product.image);
    const [shirt, art] = await Promise.all([loadImg(shirtSrc), loadImg(up.url)]);
    const W = 900, H = 1125, pad = W * 0.04; // gleiche Geometrie wie die Vorschau (4:5, object-fit: contain, 4 % Rand)
    const cv = document.createElement('canvas'); cv.width = W; cv.height = H; const ctx = cv.getContext('2d')!;
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, W, H);
    const sc = Math.min((W - 2 * pad) / shirt.naturalWidth, (H - 2 * pad) / shirt.naturalHeight);
    const sw = shirt.naturalWidth * sc, sh = shirt.naturalHeight * sc;
    ctx.drawImage(shirt, (W - sw) / 2, (H - sh) / 2, sw, sh);
    const pct = sizeInfo(val(`size_${k}`)).pct; const pp = pos[k];
    const mw = (pct / 100) * W, mh = mw * (art.naturalHeight / art.naturalWidth);
    ctx.drawImage(art, (pp.x / 100) * W - mw / 2, (pp.y / 100) * H - mh / 2, mw, mh);
    // Positionsmarker klein in die Ecke: Seite, Druckgröße, Position
    ctx.fillStyle = 'rgba(0,0,0,.65)'; ctx.fillRect(0, H - 34, W, 34);
    ctx.fillStyle = '#fff'; ctx.font = '600 18px Inter, Arial, sans-serif';
    ctx.fillText(`${product.title} ${c.dataset.name} · ${k === 'front' ? 'Vorne' : 'Hinten'} ${val(`size_${k}`)} · Mitte bei ${pp.x.toFixed(0)} % / ${pp.y.toFixed(0)} % · Breite ${pct} %`, 14, H - 11);
    const blob = await new Promise<Blob | null>((r) => cv.toBlob(r, 'image/jpeg', 0.86)); if (!blob) return null;
    const fd = new FormData(); fd.append('file', new File([blob], `mockup-${k}.jpg`, { type: 'image/jpeg' })); fd.append('upload_preset', cloud.uploadPreset); fd.append('folder', 'westernprint-shop/mockups');
    const res = await fetch(`https://api.cloudinary.com/v1_1/${cloud.cloudName}/image/upload`, { method: 'POST', body: fd });
    if (!res.ok) return null;
    return (await res.json()).secure_url as string;
  }

  form.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((inp) => {
    inp.addEventListener('change', async () => {
      const k = inp.name.replace('file_', '') as Side; const box = inp.closest('fieldset')!;
      const err = $<HTMLElement>('[data-upload-error]', box), label = $<HTMLElement>('[data-upload-label]', box), sub = $<HTMLElement>('[data-upload-sub]', box), thumb = $<HTMLElement>('[data-upload-thumb]', box);
      err.hidden = true; const file = inp.files?.[0]; if (!file) return;
      if (file.type !== 'image/png') { err.textContent = 'Bitte eine PNG-Datei hochladen.'; err.hidden = false; inp.value = ''; return; }
      if (file.size > 10 * 1024 * 1024) { err.textContent = 'Datei ist größer als 10 MB.'; err.hidden = false; inp.value = ''; return; }
      label.textContent = 'Wird hochgeladen...'; sub.textContent = file.name;
      try {
        const url = await uploadFile(file); uploads[k] = { url, name: file.name };
        label.textContent = 'Motiv hochgeladen'; sub.textContent = `${file.name}. Zum Ändern erneut klicken.`;
        thumb.innerHTML = `<img src="${url}" alt="">`; box.classList.add('has-file');
        view = k; renderStage();
      } catch (e) { err.textContent = (e as Error).message; err.hidden = false; label.textContent = 'Motiv hochladen'; }
    });
  });

  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'color') updateAvailability();
    if (t.name === 'side') updateSides();
    if (t.name === 'size_front') view = 'front'; if (t.name === 'size_back') view = 'back';
    updateUI();
  });
  form.addEventListener('input', renderCalc);
  form.querySelectorAll<HTMLButtonElement>('[data-qty]').forEach((b) => b.addEventListener('click', () => { const i = $<HTMLInputElement>('#qty'); i.value = String(Math.max(1, Math.min(99, qty() + Number(b.dataset.qty)))); renderCalc(); }));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const note = $<HTMLElement>('[data-note]'); note.hidden = true; note.className = 'form-note';
    const v = variant();
    if (!v) { $('[data-size-error]').hidden = false; $<HTMLElement>('[data-sizes]').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
    $('[data-size-error]').hidden = true;
    const a = active(); const t = total(); const c = colorEl();
    const up = (k: Side) => (uploads[k] ? (uploads[k]!.url.startsWith('blob:') ? `${uploads[k]!.name} (wird nachgereicht)` : uploads[k]!.url) : '');
    const btn = $<HTMLButtonElement>('[data-add]'); const btnHtml = btn.innerHTML;
    btn.disabled = true; btn.textContent = 'Vorschau wird gespeichert...';
    const mock: Record<Side, string | null> = { front: null, back: null };
    try { [mock.front, mock.back] = await Promise.all([a.front ? renderMockup('front').catch(() => null) : null, a.back ? renderMockup('back').catch(() => null) : null]); } catch {}
    btn.disabled = false; btn.innerHTML = btnHtml;
    addItem({ variantId: v.id, handle: product.handle, title: product.title, color: c.dataset.name || '', size: val('size'), image: (c.dataset.image && c.dataset.image !== 'null' ? c.dataset.image : product.image),
      quantity: qty(), base: t.base, side: val('side') as any, surcharge: t.sf + t.sb,
      sizeFront: a.front ? val('size_front') : undefined, sizeBack: a.back ? val('size_back') : undefined,
      uploadFront: a.front ? up('front') : undefined, uploadBack: a.back ? up('back') : undefined,
      posFront: a.front ? `${pos.front.x.toFixed(0)}% / ${pos.front.y.toFixed(0)}%` : undefined, posBack: a.back ? `${pos.back.x.toFixed(0)}% / ${pos.back.y.toFixed(0)}%` : undefined,
      mockupFront: mock.front || undefined, mockupBack: mock.back || undefined });
    note.className = 'form-note ok'; note.hidden = false;
    note.innerHTML = `Im Warenkorb. <a href="/warenkorb" class="accent"><b>Zum Warenkorb</b></a> oder weiter stöbern.`;
    if (!(a.front ? uploads.front : true) || !(a.back ? uploads.back : true)) note.innerHTML += ' <span class="muted">Ohne Motiv? Kein Problem, wir fragen es nach der Bestellung an.</span>';
  });

  updateAvailability(); updateSides(); updateUI();
</script>

<style>
  .pp { padding: 24px 0 clamp(40px, 5vw, 64px); }
  .crumbs { font-size: 14px; margin-bottom: 18px; display: flex; gap: 8px; flex-wrap: wrap; } .crumbs a:hover { color: var(--text); }
  .pgrid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .pvisual { position: sticky; top: calc(var(--nav-h) + 16px); }
  .stage { position: relative; border-radius: var(--radius-card); overflow: hidden; background: #f4f4f4; border: 1px solid var(--line); }
  .stage img[data-stage-img] { width: 100%; aspect-ratio: 4 / 5; object-fit: contain; padding: 4%; box-sizing: border-box; }
  .motif { position: absolute; transform: translate(-50%, -50%); cursor: grab; touch-action: none; filter: drop-shadow(0 1px 1px rgba(0,0,0,.25)); max-width: none; }
  .motif:active { cursor: grabbing; }
  .stage-tabs { position: absolute; top: 12px; right: 12px; display: flex; background: rgba(255,255,255,.92); border-radius: 999px; padding: 3px; box-shadow: 0 2px 10px rgba(0,0,0,.12); }
  .stage-tabs button { border: 0; background: transparent; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; color: #333; cursor: pointer; }
  .stage-tabs button.is-on { background: #111; color: #fff; }
