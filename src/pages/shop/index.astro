---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProducts, euro, CATEGORY_ORDER } from '../../lib/shopify';
const products = await getProducts();
const cats = CATEGORY_ORDER.filter((c) => products.some((p) => p.category === c));
const count = (c: string) => products.filter((p) => p.category === c).length;
---
<Base title="Textilien mit eigenem Motiv bedrucken" description={`${products.length} Textilien von Stanley/Stella und Stedman mit deinem Motiv bedrucken: T-Shirts, Hoodies, Polos, Kinder, Baby, Taschen. Ab 1 Stück, DTF-Druck in Oberhausen, Versand in 1-3 Werktagen.`}>
  <section class="shop-head">
    <div class="container">
      <span class="eyebrow">Shop</span>
      <h1>Dein Motiv. Dein Textil.</h1>
      <p class="lede">{products.length} Textilien von Stanley/Stella und Stedman, ab 1 Stück per DTF bedruckt und in 1 bis 3 Werktagen bei dir. Motiv als PNG hochladen, Druckgröße wählen, fertig.</p>
      <ul class="shop-usps">
        <li><Icon name="printer" size={18} /> DTF-Druck, waschfest und deckend</li>
        <li><Icon name="truck" size={18} /> Versand 4,90 €, in 1 bis 3 Werktagen</li>
        <li><Icon name="seal-check" size={18} /> Bio-Baumwolle bei Stanley/Stella</li>
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="filters" role="tablist" aria-label="Kategorie">
        <button class="chip is-on" data-cat="alle" role="tab" aria-selected="true">Alle <span>{products.length}</span></button>
        {cats.map((c) => <button class="chip" data-cat={c} role="tab" aria-selected="false">{c} <span>{count(c)}</span></button>)}
        <span class="filters-sep"></span>
        <button class="chip chip-brand" data-brand="alle">Alle Marken</button>
        <button class="chip chip-brand" data-brand="Stanley/Stella">Stanley/Stella</button>
        <button class="chip chip-brand" data-brand="Stedman">Stedman</button>
      </div>
      <p class="muted result" data-result></p>
      <div class="pgrid" data-grid>
        {products.map((p, i) => (
          <a href={`/shop/${p.handle}`} class="pcard" data-cat={p.category} data-brand={p.brand}>
            <div class="pimg">
              <img src={p.image} alt={`${p.title} von ${p.brand}`} width="900" height="1125" loading={i < 8 ? 'eager' : 'lazy'} />
              {p.modelImage && p.modelImage !== p.image && <img class="hover" src={p.modelImage} alt="" width="900" height="1125" loading="lazy" />}
              {p.brand === 'Stanley/Stella' && <span class="badge-bio">Bio</span>}
            </div>
            <div class="pbody">
              <span class="pbrand">{p.brand} <span class="muted">{p.gender}</span></span>
              <strong>{p.title}</strong>
              <div class="pmeta">
                <span class="dots" aria-label={`${p.colors.length} Farben`}>
                  {p.colors.slice(0, 7).map((c) => <i style={`background:${c.hex || '#ccc'}`} title={c.name}></i>)}
                  {p.colors.length > 7 && <em>+{p.colors.length - 7}</em>}
                </span>
                <span class="sizes">{p.sizes[0]} bis {p.sizes[p.sizes.length - 1]}</span>
              </div>
              <span class="price">ab {euro(p.price)} <small>zzgl. Druck ab 5 €</small></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="Mehr als ein paar Stück?" text="Ab 50 Stück gibt es Staffelpreise. Schick uns Motiv, Textil und Stückzahl, du bekommst ein Angebot innerhalb von 24 Stunden." />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.pcard');
  const result = document.querySelector<HTMLElement>('[data-result]')!;
  let cat = 'alle', brand = 'alle';
  const params = new URLSearchParams(location.search); if (params.get('kategorie')) cat = params.get('kategorie')!;
  function apply() {
    let n = 0;
    cards.forEach((c) => { const on = (cat === 'alle' || c.dataset.cat === cat) && (brand === 'alle' || c.dataset.brand === brand); c.hidden = !on; if (on) n++; });
    chips.forEach((ch) => { const on = ch.dataset.cat ? ch.dataset.cat === cat : ch.dataset.brand === brand; ch.classList.toggle('is-on', on); ch.setAttribute('aria-selected', String(on)); });
    result.textContent = `${n} ${n === 1 ? 'Textil' : 'Textilien'}`;
    const u = new URL(location.href); cat === 'alle' ? u.searchParams.delete('kategorie') : u.searchParams.set('kategorie', cat); history.replaceState(null, '', u);
  }
  chips.forEach((ch) => ch.addEventListener('click', () => { if (ch.dataset.cat) cat = ch.dataset.cat; else brand = ch.dataset.brand!; apply(); }));
  apply();
</script>

<style>
  .shop-head { padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 3vw, 40px); background: radial-gradient(900px 400px at 15% 0%, var(--accent-soft), transparent 70%); border-bottom: 1px solid var(--line); }
  .shop-head .lede { margin-top: 14px; }
  .shop-usps { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 22px; font-size: 14px; color: var(--text-2); }
  .shop-usps li { display: flex; gap: 8px; align-items: center; } .shop-usps .icon { color: var(--accent); }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; position: sticky; top: calc(var(--nav-h) + 8px); z-index: 5; padding: 10px 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); }
  .filters-sep { width: 1px; height: 22px; background: var(--line-strong); margin: 0 6px; }
  .chip { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--text-2); font-size: 14px; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
  .chip span { color: var(--text-3); font-size: 12px; }
  .chip:hover { color: var(--text); border-color: var(--text-2); }
  .chip.is-on { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); } .chip.is-on span { color: var(--accent-ink); opacity: .7; }
  .result { font-size: 14px; margin: 10px 0 18px; }
  .pgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .pcard { display: flex; flex-direction: column; border-radius: var(--radius-card); overflow: hidden; border: 1px solid var(--line); background: var(--surface); transition: transform 0.35s var(--ease), border-color 0.35s var(--ease); }
  .pcard:hover { transform: translateY(-3px); border-color: var(--accent-line); }
  .pimg { position: relative; background: #f4f4f4; }
  .pimg img { aspect-ratio: 4 / 5; object-fit: contain; width: 100%; padding: 6%; box-sizing: border-box; }
  .pimg .hover { position: absolute; inset: 0; opacity: 0; transition: opacity 0.35s var(--ease); object-fit: cover; padding: 0; }
  .pcard:hover .hover { opacity: 1; }
  .badge-bio { position: absolute; top: 10px; left: 10px; padding: 3px 9px; border-radius: 999px; background: #1f8f42; color: #fff; font-size: 11.5px; font-weight: 600; }
  .pbody { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; font-size: 14.5px; }
  .pbrand { font-size: 12.5px; color: var(--text-2); }
  .pbrand .muted { color: var(--text-3); } .pbrand .muted::before { content: ' · '; }
  .pbody strong { font-size: 16px; }
  .pmeta { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; font-size: 12.5px; color: var(--text-3); }
  .dots { display: inline-flex; gap: 4px; align-items: center; }
  .dots i { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(128,128,128,.4); display: inline-block; }
  .dots em { font-style: normal; font-size: 12px; margin-left: 2px; }
  .price { margin-top: 8px; font-weight: 600; color: var(--accent); }
  .price small { font-weight: 400; color: var(--text-3); }
  @media (max-width: 1000px) { .pgrid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) { .pgrid { grid-template-columns: repeat(2, 1fr); gap: 12px; } .pbody { padding: 12px; } .filters { position: static; } }
</style>
