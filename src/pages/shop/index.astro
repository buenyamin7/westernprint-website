---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProducts, euro, CATEGORY_ORDER, PRINT_SIZES } from '../../lib/shopify';
const products = await getProducts();
const cats = CATEGORY_ORDER.filter((c) => products.some((p) => p.category === c));
const count = (c: string) => products.filter((p) => p.category === c).length;
// Kleinster kaufbarer Preis je Stück, gerechnet wie Konfigurator und Warenkorb (Variantenpreis + Druckaufschlag je Seite):
// günstigste verfügbare Variante plus kleinste Druckgröße auf nur einer Seite. Ohne Druck ist nichts bestellbar.
// Preislogik "pod" (Changer-Familie): der Variantenpreis enthält bereits eine Druckseite in beliebiger Größe.
const minPrint = PRINT_SIZES.filter((s) => !s.frontOnly).reduce((a, b) => (b.surcharge < a.surcharge ? b : a));
// Transparentes 1x1-GIF als src der Hover-Bilder, bis das Modelfoto beim ersten Maus-Hover nachgeladen wird.
const PLATZHALTER = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const fromPrice = (p: (typeof products)[number]) => {
  const av = p.variants.filter((v) => v.available).map((v) => v.price);
  return (av.length ? Math.min(...av) : p.price) + (p.pricing === 'pod' ? 0 : minPrint.surcharge);
};
---
<Base title="Textilien mit eigenem Motiv bedrucken" description={`${products.length} Textilien von Stanley/Stella und Stedman mit deinem Motiv bedrucken: T-Shirts, Hoodies, Polos, Kinder, Baby, Taschen. Ab 1 Stück, DTF-Druck in Oberhausen, Lieferung in 3 bis 5 Werktagen.`}>
  <section class="shop-head">
    <div class="container">
      <span class="eyebrow">Shop</span>
      <h1>Dein Motiv. Dein Textil.</h1>
      <p class="lede">{products.length} Textilien von Stanley/Stella und Stedman, ab 1 Stück per DTF bedruckt und in 3 bis 5 Werktagen bei dir. Motiv als PNG hochladen, Druckgröße wählen, fertig.</p>
      <ul class="shop-usps">
        <li><Icon name="printer" size={18} /> DTF-Druck, waschfest und deckend</li>
        <li><Icon name="truck" size={18} /> Versand Deutschland 4,90 €, Ausland 9,90 €, versandkostenfrei ab 500 €, Lieferung in 3 bis 5 Werktagen</li>
        <li><Icon name="seal-check" size={18} /> Bio-Baumwolle bei Stanley/Stella</li>
      </ul>
      {/* Shop-Preise sind Bruttopreise: der Kassen-Worker übergibt sie an Mollie mit vatRate 19 % (westernprint-checkout, src/index.js). */}
      <p class="price-note">Alle Preise inkl. MwSt., zzgl. <a href="/versand">Versand</a> (Deutschland 4,90 €, Österreich, Schweiz und übrige Lieferländer 9,90 €, ab 500 € Warenwert versandkostenfrei).</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="filters" role="tablist" aria-label="Kategorie">
        <button class="chip is-on" data-cat="alle" role="tab" aria-selected="true">Alle <span>{products.length}</span></button>
        {cats.map((c) => <button class="chip" data-cat={c} role="tab" aria-selected="false">{c} <span>{count(c)}</span></button>)}
        <span class="filters-sep"></span>
        <button class="chip chip-brand" data-brand="alle">Alle Marken</button>
        <button class="chip chip-brand" data-brand="Stanley/Stella">Stanley/Stella</button>
        <button class="chip chip-brand" data-brand="Stedman">Stedman</button>
      </div>
      <p class="muted result" data-result></p>
      <div class="pgrid" data-grid>
        {products.map((p, i) => (
          <a href={`/shop/${p.handle}`} class="pcard" data-cat={p.category} data-brand={p.brand}>
            <div class="pimg">
              <img src={p.image} alt={`${p.title} von ${p.brand}`} width="900" height="1125" loading={i < 8 ? 'eager' : 'lazy'} />
              {/* Modelfoto für den Maus-Hover: src ist ein transparentes 1x1-GIF (Pflichtattribut), das Skript unten lädt das Foto erst beim ersten Hover mit der Maus. */}
              {p.modelImage && p.modelImage !== p.image && <img class="hover" src={PLATZHALTER} data-src={p.modelImage} alt="" width="900" height="1125" decoding="async" />}
              {p.brand === 'Stanley/Stella' && <span class="badge-bio">Bio</span>}
            </div>
            <div class="pbody">
              <span class="pbrand">{p.brand} <span class="muted">{p.gender}</span></span>
              <strong>{p.title}</strong>
              <div class="pmeta">
                <span class="dots" aria-label={`${p.colors.length} Farben`}>
                  {p.colors.slice(0, 7).map((c) => <i style={`background:${c.hex || '#ccc'}`} title={c.name}></i>)}
                  {p.colors.length > 7 && <em>+{p.colors.length - 7}</em>}
                </span>
                <span class="sizes">{p.sizes[0]} bis {p.sizes[p.sizes.length - 1]}</span>
              </div>
              <span class="price">ab {euro(fromPrice(p))} <small>inkl. {p.pricing === 'pod' ? 'Druck einer Seite' : `${minPrint.label}-Druck`} und MwSt., zzgl. Versand</small></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="Mehr als ein paar Stück?" text="Staffelpreise gibt es ab 10 Stück, Großauflagen ab 50 Stück. Schick uns Motiv, Textil und Stückzahl, du bekommst ein Angebot innerhalb von 24 Stunden." />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.pcard');
  const result = document.querySelector<HTMLElement>('[data-result]')!;
  let cat = 'alle', brand = 'alle';
  const params = new URLSearchParams(location.search); if (params.get('kategorie')) cat = params.get('kategorie')!;
  function apply() {
    let n = 0;
    cards.forEach((c) => { const on = (cat === 'alle' || c.dataset.cat === cat) && (brand === 'alle' || c.dataset.brand === brand); c.hidden = !on; if (on) n++; });
    chips.forEach((ch) => { const on = ch.dataset.cat ? ch.dataset.cat === cat : ch.dataset.brand === brand; ch.classList.toggle('is-on', on); ch.setAttribute('aria-selected', String(on)); });
    result.textContent = `${n} ${n === 1 ? 'Textil' : 'Textilien'}`;
    const u = new URL(location.href); cat === 'alle' ? u.searchParams.delete('kategorie') : u.searchParams.set('kategorie', cat); history.replaceState(null, '', u);
  }
  chips.forEach((ch) => ch.addEventListener('click', () => { if (ch.dataset.cat) cat = ch.dataset.cat; else brand = ch.dataset.brand!; apply(); }));
  apply();

  // Hover-Modelfotos (zusammen rund 4 MB) erst laden, wenn eine Maus über die Kachel fährt.
  // Touch und Stift lösen nichts aus, auf dem Handy wird also kein Modelfoto geladen.
  // Eingeblendet wird erst nach dem Laden (.is-loaded), damit die Überblendung wie bisher weich bleibt.
  cards.forEach((card) => {
    const img = card.querySelector<HTMLImageElement>('img.hover[data-src]');
    if (!img) return;
    const load = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      card.removeEventListener('pointerenter', load);
      card.removeEventListener('pointermove', load);
      img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
      img.src = img.dataset.src!;
    };
    card.addEventListener('pointerenter', load);
    // Steht der Mauszeiger beim Laden schon auf einer Kachel, kommt kein pointerenter. Die erste Bewegung lädt dann.
    card.addEventListener('pointermove', load);
  });
</script>

<style>
  .shop-head { padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 3vw, 40px); background: radial-gradient(900px 400px at 15% 0%, var(--accent-soft), transparent 70%); border-bottom: 1px solid var(--line); }
  .shop-head .lede { margin-top: 14px; }
  .shop-usps { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 22px; font-size: 14px; color: var(--text-2); }
  .shop-usps li { display: flex; gap: 8px; align-items: center; } .shop-usps .icon { color: var(--accent); }
  .price-note { margin-top: 14px; font-size: 13px; color: var(--text-3); }
  .price-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; position: sticky; top: calc(var(--nav-h) + 8px); z-index: 5; padding: 10px 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); }
  .filters-sep { width: 1px; height: 22px; background: var(--line-strong); margin: 0 6px; }
  .chip { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--text-2); font-size: 14px; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
  .chip span { color: var(--text-3); font-size: 12px; }
  .chip:hover { color: var(--text); border-color: var(--text-2); }
  .chip.is-on { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); } .chip.is-on span { color: var(--accent-ink); opacity: .7; }
  .result { font-size: 14px; margin: 10px 0 18px; }
  .pgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px 22px; }
  .pcard { display: flex; flex-direction: column; border-radius: 18px; transition: transform 0.45s var(--ease); }
  .pcard:hover { transform: translateY(-4px); }
  .pimg { position: relative; border-radius: 18px; overflow: hidden; background: radial-gradient(80% 70% at 50% 40%, #a9afab 0%, #858b87 55%, #6b716d 100%); }
  .pimg::after { content: ''; position: absolute; left: 12%; right: 12%; bottom: 4%; height: 10%; border-radius: 50%; background: radial-gradient(ellipse, rgba(0,0,0,0.55), transparent 70%); filter: blur(10px); opacity: 0; transition: opacity 0.45s var(--ease); pointer-events: none; }
  :global([data-theme="light"]) .pimg::after { background: radial-gradient(ellipse, rgba(0,0,0,0.18), transparent 70%); }
  .pimg img { aspect-ratio: 4 / 5; object-fit: contain; width: 100%; padding: 8% 6% 4%; box-sizing: border-box; transition: transform 0.6s var(--ease); filter: drop-shadow(0 22px 26px rgba(0,0,0,0.45)); }
  .pcard:hover .pimg img { transform: scale(1.04); }
  .pimg .hover { position: absolute; inset: 0; opacity: 0; transition: opacity 0.45s var(--ease); object-fit: cover; padding: 0; filter: none; border-radius: 18px; }
  .pcard:hover .hover.is-loaded { opacity: 1; }
  .badge-bio { position: absolute; top: 10px; left: 10px; padding: 3px 9px; border-radius: 999px; background: #1f8f42; color: #fff; font-size: 11.5px; font-weight: 600; }
  .pbody { display: flex; flex-direction: column; gap: 4px; padding: 14px 4px 0; font-size: 14.5px; }
  .pbrand { font-size: 12.5px; color: var(--text-2); }
  .pbrand .muted { color: var(--text-3); } .pbrand .muted::before { content: ' · '; }
  .pbody strong { font-size: 16px; }
  .pmeta { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; font-size: 12.5px; color: var(--text-3); }
  .dots { display: inline-flex; gap: 4px; align-items: center; }
  .dots i { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(128,128,128,.4); display: inline-block; }
  .dots em { font-style: normal; font-size: 12px; margin-left: 2px; }
  .price { margin-top: 8px; font-weight: 600; color: var(--accent); }
  .price small { display: block; margin-top: 2px; font-weight: 400; font-size: 12.5px; color: var(--text-3); }
  @media (max-width: 1000px) { .pgrid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) { .pgrid { grid-template-columns: repeat(2, 1fr); gap: 26px 14px; } .pbody { padding: 10px 2px 0; } .filters { position: static; } }
</style>
