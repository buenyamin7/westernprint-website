---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import ContactForm from '../../components/ContactForm.astro';
import Tiles from '../../components/Tiles.astro';
import { site } from '../../data/site';
import { zielgruppen } from '../../data/zielgruppen';

export function getStaticPaths() { return zielgruppen.map((z) => ({ params: { slug: z.slug }, props: { z } })); }
const { z } = Astro.props;
const related = zielgruppen.filter((o) => o.slug !== z.slug && o.group === z.group).slice(0, 3);
const more = zielgruppen.filter((o) => o.slug !== z.slug && o.group !== z.group).slice(0, 3 - related.length);
const rel = [...related, ...more];
const iconFor = (t: string) => /hoodie|sweat|pullover/i.test(t) ? 'hoodie' : /cap|beanie|mütze/i.test(t) ? 'baseball-cap' : /beutel|tote|tasche|bag/i.test(t) ? 'tote' : /jacke|softshell|weste/i.test(t) ? 'coat-hanger' : /print-on-demand|versand|shop/i.test(t) ? 'package' : /short|hose|jogger/i.test(t) ? 'pants' : 't-shirt';
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: z.title, serviceType: 'Textildruck', description: z.description, provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: [{ '@type': 'City', name: 'Oberhausen' }, { '@type': 'AdministrativeArea', name: 'Ruhrgebiet' }, { '@type': 'AdministrativeArea', name: 'Nordrhein-Westfalen' }, { '@type': 'Country', name: 'Deutschland' }], audience: { '@type': 'Audience', audienceType: z.name }, url: `${site.url}/fuer/${z.slug}`, offers: { '@type': 'Offer', description: 'Angebot innerhalb von 24 Stunden, ab 1 Stück, Staffelpreise ab 10 bis 50 Stück' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: z.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Start', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Für wen wir drucken', item: `${site.url}/fuer` }, { '@type': 'ListItem', position: 3, name: z.name, item: `${site.url}/fuer/${z.slug}` }] },
];
---
<Base title={`${z.title} | westernprint Oberhausen`} description={z.description} jsonLd={ld} ogImage={z.image}>
  <PageHero eyebrow={z.name} title={z.h1} lede={z.lede} cta={{ label: 'Angebot in 24h', href: '#anfrage' }} cta2={{ label: 'Per WhatsApp', href: site.whatsapp }} image={z.image} imageAlt={z.imageAlt} />

  <section class="section-tight">
    <div class="container zg-intro">
      <p class="lede answer">{z.intro}</p>
      <ul class="facts">
        <li><Icon name="clock" size={18} /> Angebot in 24 Stunden</li>
        <li><Icon name="printer" size={18} /> Produktion in Oberhausen</li>
        <li><Icon name="truck" size={18} /> Versand mit DHL oder Abholung</li>
        <li><Icon name="seal-check" size={18} /> Korrekturabzug vor dem Druck</li>
      </ul>
    </div>
  </section>

  <section class="section-tight offer">
    <div class="container">
      <div class="offer-head">
        <h2>Was wir für {z.name} drucken</h2>
        <p class="muted">Typische Teile, die wir für diese Gruppe bedrucken. Alles ab Lager, in allen Größen, mit eurem Motiv.</p>
      </div>
      <ul class="products">
        {z.products.map((p, i) => (
          <li class={`product reveal reveal-d${i % 4}`}>
            <span class="product-icon"><Icon name={iconFor(p)} size={34} /></span>
            <span class="product-name">{p}</span>
          </li>
        ))}
      </ul>
      <ul class="benefits">
        {z.benefits.map((b, i) => (
          <li class={`benefit reveal reveal-d${i}`}>
            <span class="benefit-icon"><Icon name="check-circle" weight="fill" size={22} /></span>
            <div><h3>{b.t}</h3><p>{b.d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section steps-section">
    <div class="container">
      <div class="steps-head">
        <h2>In drei Schritten zu euren Textilien</h2>
        <p class="muted">Kein Ticketsystem, kein Warten. Ihr schreibt, wir antworten innerhalb von 24 Stunden mit einem festen Preis.</p>
      </div>
      <ol class="steps">
        {[
          { icon: 'chat-circle-dots', t: 'Anfrage senden', d: 'Motiv, Textil, Stückzahl und Wunschtermin. Per Formular, WhatsApp oder Mail, auch als Skizze oder Foto.' },
          { icon: 'file-text', t: 'Angebot in 24 Stunden', d: 'Fester Stückpreis, Korrekturabzug mit eurem Motiv auf dem Textil, verbindlicher Liefertermin. Ihr gebt frei.' },
          { icon: 'package', t: 'Druck und Lieferung', d: 'Produktion in Oberhausen, jedes Teil geprüft. Versand mit DHL, sortiert nach Größe, oder Abholung.' },
        ].map((st, i) => (
          <li class={`reveal reveal-d${i}`}>
            <div class="step-badge"><span class="step-no">0{i + 1}</span><Icon name={st.icon} size={26} /></div>
            <h3>{st.t}</h3>
            <p>{st.d}</p>
          </li>
        ))}
      </ol>
      <div class="steps-cta reveal"><a href="#anfrage" class="btn btn-primary btn-lg">Jetzt anfragen <Icon name="arrow-right" size={18} /></a><span class="muted">Kostenlos und unverbindlich.</span></div>
    </div>
  </section>

  <Faq items={z.faqs} title={`Fragen von ${z.name}`} />

  <section class="section" id="anfrage">
    <div class="container zg-form">
      <div>
        <h2>Angebot anfragen</h2>
        <p class="muted">Schreib uns, was du brauchst. Antwort werktags innerhalb von 24 Stunden, meist schneller. Für schnelle Fragen: <a href={site.whatsapp} class="accent" target="_blank" rel="noopener">WhatsApp</a>.</p>
        <p class="muted small">Druckerei in Oberhausen. Lieferung ins Ruhrgebiet, nach NRW und deutschlandweit.</p>
      </div>
      <div class="card card-pad"><ContactForm topic={z.topic} /></div>
    </div>
  </section>

  <section class="section-tight related">
    <div class="container"><h2>Auch für</h2></div>
    <Tiles items={rel.map((o) => ({ href: `/fuer/${o.slug}`, img: o.image, pos: o.imagePos, t: o.name, d: o.lede.split('. ')[0] + '.', cta: 'Zur Seite' }))} rows="clamp(220px, 20vw, 300px)" />
  </section>
</Base>

<style>
  .zg-intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .answer { max-width: 68ch; font-size: 1.12rem; color: var(--text); }
  .facts { display: grid; gap: 10px; } .facts li { display: flex; gap: 10px; align-items: center; color: var(--text-2); font-size: 15px; }
  .facts :global(svg) { color: var(--accent); flex: none; }
  .offer-head { max-width: 62ch; margin-bottom: clamp(24px, 3vw, 40px); } .offer-head p { margin-top: 10px; }
  .products { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .product { position: relative; display: grid; gap: 18px; padding: 26px 24px 22px; border-radius: 18px; background: linear-gradient(180deg, var(--surface-2), var(--surface)); overflow: hidden; transition: transform 0.5s var(--ease); }
  .product::after { content: ''; position: absolute; inset: auto -40px -60px auto; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, var(--accent-soft), transparent 70%); pointer-events: none; }
  .product:hover { transform: translateY(-4px); }
  .product-icon { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line); }
  .product-name { font-weight: 600; font-size: 15.5px; line-height: 1.35; text-wrap: balance; }
  .benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); margin-top: clamp(36px, 5vw, 56px); padding-top: clamp(28px, 4vw, 40px); border-top: 1px solid var(--line); }
  .benefit { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }
  .benefit-icon { color: var(--accent); display: grid; place-items: center; height: 28px; }
  .benefit h3 { font-size: 17px; margin-bottom: 6px; } .benefit p { color: var(--text-2); font-size: 15px; }
  @media (max-width: 900px) { .products { grid-template-columns: 1fr 1fr; } .benefits { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .products { grid-template-columns: 1fr; } }
  .steps-section { position: relative; overflow: hidden; background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .steps-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(700px 320px at 50% 0%, var(--accent-soft), transparent 70%); pointer-events: none; }
  .steps-head { text-align: center; max-width: 62ch; margin: 0 auto clamp(36px, 5vw, 64px); position: relative; }
  .steps-head p { margin-top: 12px; font-size: 1.05rem; }
  .steps { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); text-align: center; }
  .steps::before { content: ''; position: absolute; top: 44px; left: calc(100% / 6); right: calc(100% / 6); height: 1px; background: linear-gradient(90deg, transparent, var(--accent-line) 20%, var(--accent-line) 80%, transparent); }
  .steps li { position: relative; display: grid; justify-items: center; gap: 10px; padding: 0 clamp(8px, 2vw, 24px); }
  .step-badge { position: relative; width: 88px; height: 88px; border-radius: 22px; display: grid; place-items: center; color: var(--accent); background: linear-gradient(180deg, var(--surface-2), var(--surface)); border: 1px solid var(--accent-line); box-shadow: 0 0 0 6px var(--bg-2), 0 0 40px -8px rgba(79, 207, 120, 0.45); margin-bottom: 10px; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .steps li:hover .step-badge { transform: translateY(-4px); box-shadow: 0 0 0 6px var(--bg-2), 0 0 56px -6px rgba(79, 207, 120, 0.6); }
  .step-no { position: absolute; top: -12px; right: -12px; min-width: 32px; height: 32px; padding: 0 8px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-family: 'Bricolage Grotesque Variable', sans-serif; font-weight: 750; font-size: 14px; display: grid; place-items: center; }
  .steps h3 { font-size: 19px; }
  .steps p { color: var(--text-2); font-size: 15px; max-width: 32ch; }
  .steps-cta { display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: clamp(36px, 5vw, 56px); position: relative; }
  @media (max-width: 800px) {
    .steps { grid-template-columns: 1fr; gap: 28px; text-align: left; }
    .steps::before { top: 0; bottom: 0; left: 43px; right: auto; width: 1px; height: auto; background: linear-gradient(180deg, transparent, var(--accent-line) 10%, var(--accent-line) 90%, transparent); }
    .steps li { grid-template-columns: 88px 1fr; justify-items: start; column-gap: 18px; padding: 0; }
    .steps li h3 { grid-column: 2; align-self: end; } .steps li p { grid-column: 2; }
    .step-badge { grid-row: 1 / span 2; margin: 0; }
  }
  .zg-form { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .zg-form .muted { margin-top: 10px; } .small { font-size: 13px; }
  .related { padding-bottom: 0; } .related h2 { margin-bottom: 20px; }
  @media (max-width: 900px) { .zg-intro, .zg-form { grid-template-columns: 1fr; } }
</style>
