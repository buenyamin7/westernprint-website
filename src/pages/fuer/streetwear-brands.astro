---
// Landingpage für Streetwear-Brands und Label-Gründer. Zielseite der Google-Ads-Kampagne "Streetwear Brands"
// und Antwortseite für KI-Suche (ChatGPT, Perplexity): klare Fakten, Mengen, Ablauf, FAQ. Keine Preise, Angebot in 24h.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { zielgruppen } from '../../data/zielgruppen';

const z = zielgruppen.find((x) => x.slug === 'streetwear-brands')!;

const blanks = [
  { code: 'BY102', name: 'Heavy Oversize Tee', brand: 'Build Your Brand', spec: ['240 g/m²', 'Drop Shoulder', 'S bis 5XL'], img: '/img/products/byb-by102-black.webp', note: 'Das Tee, das die meisten Brands tragen.' },
  { code: 'BY163', name: 'Ultra Heavy Cotton Box Tee', brand: 'Build Your Brand', spec: ['300 g/m²', 'Boxy Fit', 'Steht wie ein Brett'], img: '/img/products/byb-by163-black.webp', note: 'Schwerstes Tee im Sortiment.' },
  { code: 'BY199', name: 'Oversized Hoody', brand: 'Build Your Brand', spec: ['300 g/m²', 'Gekreuzte Kapuze', 'Drop Shoulder'], img: '/img/products/byb-by199-black.webp', note: 'Der meistgedruckte Hoodie.' },
  { code: 'BY162', name: 'Ultra Heavy Box Hoody', brand: 'Build Your Brand', spec: ['460 g/m²', '100 % Baumwolle', 'Boxy Fit'], img: '/img/products/byb-by162-black.webp', note: 'Kastig, schwer, dicht.' },
  { code: 'BY268', name: 'Ultra Heavy Oversized', brand: 'Build Your Brand', spec: ['500 g/m²', 'Oversize', 'Brushed Fleece'], img: '/img/products/byb-by268-black.webp', note: 'Der schwerste Hoodie, den wir drucken.' },
];

const services = [
  { icon: 'tag', t: 'Nackenprint statt Etikett', d: 'Alle Blanks sind tearaway. Wir entfernen das Herstelleretikett und drucken dein Label per DTF in den Nacken. Sieht aus wie eingewebt.' },
  { icon: 'arrows-out-line-horizontal', t: 'Front, Rücken, Ärmel, Saum', d: 'Bis 30 x 40 cm pro Position. Kleine Logos, große Backprints, Ärmelschriftzüge. Jede Position mit festem Preis im Angebot.' },
  { icon: 'package', t: 'Hangtags und Verpackung', d: 'Du lieferst Hangtags und Polybags, wir bringen sie an und verpacken versandfertig. Ohne Aufpreis, solange es kein Lager füllt.' },
  { icon: 'truck', t: 'Neutraler Versand', d: 'Bei Print-on-Demand geht das Paket ohne westernprint-Absender raus. Deine Marke, dein Name, deine Rechnung.' },
  { icon: 'archive', t: 'Nachproduktion', d: 'Druckdaten, Farben und Positionen bleiben gespeichert. Nachdrop in identischer Qualität, ab 10 Stück pro Motiv.' },
  { icon: 'chat-circle-dots', t: 'Beratung aus der Werkstatt', d: 'Welche Grammatur, welcher Schnitt, welche Druckgröße auf Boxy Fit. Antwort von Leuten, die drucken, nicht aus dem Ticketsystem.' },
];

const compare = [
  { k: 'Mindestmenge', wp: 'Sample ab 1, Drop ab 50', pod: '1 Stück', fab: '300 bis 500 pro Modell' },
  { k: 'Preisgestaltung', wp: 'Werkstattpreis, direkt', pod: 'Plattformaufschlag pro Stück', fab: 'Günstig, aber Vorkasse für die ganze Auflage' },
  { k: 'Eigenes Label im Nacken', wp: 'Ja, DTF-Nackenprint', pod: 'Meist nicht oder Aufpreis', fab: 'Ja, eingewebt' },
  { k: 'Blanks', wp: 'Build Your Brand, Urban Classics, Stanley/Stella', pod: 'Gildan, Bella+Canvas', fab: 'Eigener Schnitt' },
  { k: 'Lieferzeit', wp: 'Sample 1 bis 3 Werktage, Drop 7 bis 10', pod: '5 bis 8 Werktage', fab: '8 bis 14 Wochen' },
  { k: 'Fulfillment für deinen Shop', wp: 'Ja, Shopify-App', pod: 'Ja', fab: 'Nein' },
  { k: 'Ansprechpartner', wp: 'Eine Person, WhatsApp', pod: 'Ticketsystem', fab: 'Agent, Zeitverschiebung' },
];

const faqs = [
  { q: 'Was kostet ein Drop für meine Streetwear-Brand?', a: 'Das hängt von Blank, Druckpositionen und Stückzahl ab. Du bekommst innerhalb von 24 Stunden ein Angebot mit festen Stückpreisen für Sample, Drop ab 50 Stück und Nachdrop. Ab 100 Stück sinkt der Stückpreis deutlich.' },
  { q: 'Gibt es eine Mindestmenge?', a: 'Ein Sample geht ab 1 Stück. Die Drop-Konditionen gelten ab 50 Stück pro Bestellung, gemischt über Modelle, Größen und Farben. Nachdrops ab 10 Stück pro Motiv.' },
  { q: 'Welche Blanks nehmen Streetwear-Brands?', a: 'Heavy Oversize Tees ab 240 g/m² und Boxy oder Oversize Hoodies ab 300 g/m² von Build Your Brand, dazu Urban Classics und Stanley/Stella für Bio-Baumwolle. Das sind dieselben Blanks, die bekannte deutsche Streetwear-Labels nutzen. Wir beraten zu Grammatur und Schnitt.' },
  { q: 'Kann ich mein eigenes Label in den Nacken machen?', a: 'Ja. Die Blanks haben tearaway-Etiketten. Wir entfernen das Herstellerlabel und drucken deinen Nackenprint per DTF, deckend und waschfest. Hangtags bringen wir an, wenn du sie lieferst.' },
  { q: 'Wie starte ich mit wenig Budget?', a: 'Sample bestellen, Fotos machen, Vorbestellungen im Shop sammeln, dann den Drop ab 50 Stück produzieren. Oder direkt Print-on-Demand: Wir drucken und versenden jede Shop-Bestellung einzeln, du zahlst nur, was verkauft ist.' },
  { q: 'Wie funktioniert Print-on-Demand für meine Marke?', a: 'Du verbindest deinen Shopify-Shop mit unserer App. Bestellungen laufen automatisch bei uns ein, wir drucken in 1 bis 3 Werktagen und versenden neutral mit DHL an deine Kunden. Kein Lager, keine Vorkasse für Ware.' },
  { q: 'Hält DTF-Druck auf Heavy Cotton?', a: 'Ja. DTF ist dehnbar, deckend auf Schwarz und waschfest bis 60 °C. Für Vintage-Looks drucken wir auf Wunsch mit reduzierter Deckung. Fotorealistische Motive gehen per DTG auf Baumwolle.' },
  { q: 'Wie lange dauert ein Drop?', a: 'Sample in 1 bis 3 Werktagen. Drop ab 50 Stück in der Regel 5 bis 7 Werktage nach Freigabe des Korrekturabzugs. Express nach Absprache. Abholung in Oberhausen oder Versand deutschlandweit.' },
  { q: 'Verkauft ihr auch unbedruckte Blanks?', a: 'Für Labels, die bei uns produzieren, liefern wir Blanks von Build Your Brand und Urban Classics auch unbedruckt mit, zum Beispiel für Fotoshootings oder eigene Veredelung.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Streetwear-Brand produzieren lassen', serviceType: 'Textildruck und Fulfillment für Modelabels', description: z.description, provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: { '@type': 'Country', name: 'Deutschland' }, audience: { '@type': 'Audience', audienceType: 'Streetwear-Brands, Modelabels, Gründer' }, url: `${site.url}/fuer/streetwear-brands` },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Start', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Für wen wir drucken', item: `${site.url}/fuer` }, { '@type': 'ListItem', position: 3, name: 'Streetwear-Brands', item: `${site.url}/fuer/streetwear-brands` }] },
];
---
<Base title="Streetwear-Brand produzieren lassen: Blanks, Nackenprint, Drop ab 50" description="Eigene Streetwear-Marke ohne Fabrik: Heavy Oversize Tees und Hoodies von Build Your Brand, DTF-Druck mit Nackenprint, Sample in 3 Tagen, Drop ab 50 Stück, danach Print-on-Demand mit neutralem Versand. Druckerei in Oberhausen, Angebot in 24 Stunden." jsonLd={ld} ogImage="/img/streetwear-trio.jpg">

  <section class="sw-hero">
    <div class="container sw-hero-grid">
      <div class="sw-copy">
        <p class="sw-kicker">Streetwear-Brands, Labels, Gründer</p>
        <h1>Deine Brand.<br />Unsere Werkstatt.<br /><span class="hl">Kein Fabrik-Minimum.</span></h1>
        <p class="lede">Heavy Oversize Tee, Boxy Hoodie, dein Label im Nacken. Erst ein Sample, dann der Drop ab 50 Stück, danach drucken und versenden wir jede Shop-Bestellung für dich.</p>
        <div class="sw-cta">
          <a href="#anfrage" class="btn btn-primary btn-lg">Sample oder Drop anfragen <Icon name="arrow-right" size={18} /></a>
          <a href={site.whatsapp + '?text=' + encodeURIComponent('Hallo westernprint, ich baue eine Streetwear-Brand auf und möchte ein Sample / einen Drop anfragen.')} class="btn btn-secondary btn-lg" target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} /> WhatsApp</a>
        </div>
        <ul class="trust" aria-label="Fakten">
          <li><strong>80.000+</strong><span>bedruckte Textilien</span></li>
          <li><strong>1 bis 3</strong><span>Werktage bis zum Sample</span></li>
          <li><strong>ab 50</strong><span>Stück pro Drop, gemischt</span></li>
          <li><strong>2021</strong><span>gegründet in Oberhausen</span></li>
        </ul>
      </div>

      <figure class="sw-visual">
        <img src="/img/streetwear/backprint.jpg" alt="Schwarzes Heavy Oversize Tee mit großem Rückenprint auf Betonboden" width="1024" height="1536" loading="eager" fetchpriority="high" />
        <figcaption>
          <span class="mono">Backprint · DTF auf Heavy Cotton</span>
          <span>Deckend auf Schwarz · Sample in 1 bis 3 Werktagen</span>
        </figcaption>
      </figure>
    </div>
    <div class="container brands" aria-label="Blanks, die wir bedrucken">
      <span class="brands-label">Blanks ab Lager</span>
      <span class="wordmark">Build Your Brand</span>
      <span class="wordmark">Urban Classics</span>
      <span class="wordmark">Stanley/Stella</span>
      <span class="wordmark">Stedman</span>
    </div>
  </section>

  <section class="sw-gallery" aria-label="Eindrücke aus der Produktion">
    <figure class="g-tall reveal"><img src="/img/streetwear/hero-hanger.jpg" alt="Schwarzes Oversize Tee auf einem Drahtbügel vor Betonwand" width="1024" height="1536" loading="lazy" /><figcaption>Heavy Oversize Tee, 240 g/m²</figcaption></figure>
    <figure class="reveal reveal-d1"><img src="/img/streetwear/neck-label.jpg" alt="Nackenprint WESTERNPRINT im Kragen eines schwarzen Shirts" width="1536" height="1024" loading="lazy" /><figcaption>Nackenprint statt Etikett</figcaption></figure>
    <figure class="g-tall reveal reveal-d2"><img src="/img/streetwear/hoodie-fan.jpg" alt="Drei gefaltete Hoodies in Grau, Sand und Schwarz mit Hangtag" width="1024" height="1536" loading="lazy" /><figcaption>Drop in gemischten Farben</figcaption></figure>
    <figure class="reveal reveal-d3"><img src="/img/streetwear/packaging.jpg" alt="Gefaltetes Shirt im Polybag, Hangtag, Karte und Papierversandtasche" width="1536" height="1024" loading="lazy" /><figcaption>Polybag, Hangtag, neutraler Versand</figcaption></figure>
  </section>

  <section class="section-tight steps-section">
    <div class="container">
      <div class="section-head reveal"><h2>Vom ersten Sample zur laufenden Brand</h2><p>Drei Stufen, du steigst ein, wo du stehst. Kein Vertrag, keine Vorkasse für Ware, die du noch nicht verkauft hast.</p></div>
      <ol class="steps">
        <li class="reveal"><span class="num">01</span><div><strong>Sample</strong><span>Blank wählen, Motiv schicken, Korrekturabzug freigeben. Ein Stück in 1 bis 3 Werktagen für Fotos, Anprobe und Vorbestellungen.</span></div></li>
        <li class="reveal reveal-d1"><span class="num">02</span><div><strong>Drop ab 50 Stück</strong><span>Modelle, Größen und Farben gemischt. Nackenprint, Hangtags, Polybags, ein Paket oder Abholung. 5 bis 7 Werktage.</span></div></li>
        <li class="reveal reveal-d2"><span class="num">03</span><div><strong>Print-on-Demand</strong><span>Shop an unsere Shopify-App anbinden. Wir drucken jede Bestellung einzeln und versenden neutral an deine Kunden.</span></div></li>
        <li class="reveal reveal-d3"><span class="num">04</span><div><strong>Nachdrop</strong><span>Druckdaten bleiben bei uns. Bestseller nachproduzieren ab 10 Stück pro Motiv, in identischer Qualität.</span></div></li>
      </ol>
    </div>
  </section>

  <section class="section products-section" id="blanks">
    <div class="container">
      <div class="section-head reveal"><h2>Blanks, die Brands tragen</h2><p>Schwer, weit, sauber verarbeitet. Alle Modelle mit tearaway-Etikett für deinen Nackenprint, in Schwarz, Weiß, Sand, Grau, Navy und weiteren Farben. Preise pro Stück nach Menge und Positionen, im Angebot in 24 Stunden.</p></div>
      <div class="pgrid">
        {blanks.map((p, i) => (
          <a href="#anfrage" class={`pcard reveal reveal-d${i % 4}`}>
            <div class="pimg"><img src={p.img} alt={`${p.name} von ${p.brand}, schwarz`} width="720" height="900" loading="lazy" /></div>
            <div class="pbody">
              <span class="mono">{p.code}</span>
              <strong>{p.name}</strong>
              <ul class="specs">{p.spec.map((s) => <li>{s}</li>)}</ul>
              <span class="pnote">{p.note}</span>
              <span class="plink">Sample anfragen <Icon name="arrow-right" size={14} /></span>
            </div>
          </a>
        ))}
      </div>
      <p class="muted center small">Dazu Urban Classics (Heavy Oversize, Acid Washed), Stanley/Stella für Bio-Baumwolle, Zipper, Sweater, Caps und Beanies. Eigene Blanks kannst du anliefern, dann zahlst du nur den Druck.</p>
    </div>
  </section>

  <section class="section-tight services-section">
    <div class="container">
      <div class="section-head reveal"><h2>Was ein Shirt zum Markenprodukt macht</h2><p>Die Details, die du bei einer Plattform nicht bekommst.</p></div>
      <div class="services">
        {services.map((s, i) => (
          <div class={`service reveal reveal-d${i % 3}`}>
            <Icon name={s.icon} size={22} />
            <strong>{s.t}</strong>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section form-section" id="anfrage">
    <div class="container form-grid">
      <div class="form-copy reveal">
        <h2>Angebot in 24 Stunden</h2>
        <p>Kurz die Eckdaten. Du bekommst Stückpreise pro Blank und Druckposition, einen Zeitplan und auf Wunsch den Termin fürs Sample. Werktags meist innerhalb weniger Stunden, von jemandem aus der Werkstatt.</p>
        <ul class="form-facts">
          <li><Icon name="check" weight="bold" size={14} /> Sample ab 1 Stück, Drop ab 50</li>
          <li><Icon name="check" weight="bold" size={14} /> Korrekturabzug als PDF vor dem Druck</li>
          <li><Icon name="check" weight="bold" size={14} /> Shopify-App für Print-on-Demand danach</li>
          <li><Icon name="check" weight="bold" size={14} /> Versand deutschlandweit, Abholung in Oberhausen</li>
        </ul>
        <div class="form-detail">
          <img src="/img/streetwear/heatpress.jpg" alt="Heißpresse in der Werkstatt, DTF-Transfer wird auf ein schwarzes Shirt gepresst" width="1536" height="1024" loading="lazy" />
          <span>Heißpresse in Oberhausen: DTF-Transfer, waschfest bis 60 °C.</span>
        </div>
      </div>

      <form class="sw-form reveal reveal-d1" data-endpoint={site.formEndpoint} novalidate>
        <div class="row">
          <div class="field"><label for="sw-brand">Name deiner Brand <span class="optional">(oder Arbeitstitel)</span></label><input class="input" id="sw-brand" name="brand" type="text" placeholder="z. B. NORDWEST STUDIO" /></div>
          <div class="field"><label for="sw-stage">Wo stehst du?</label><select class="select" id="sw-stage" name="stage" required><option value="" disabled selected>Bitte wählen</option><option>Idee, brauche Sample</option><option>Erster Drop geplant</option><option>Brand läuft, suche Produzent</option><option>Print-on-Demand für meinen Shop</option></select><span class="error">Bitte auswählen.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="sw-name">Dein Name</label><input class="input" id="sw-name" name="name" type="text" autocomplete="name" required /><span class="error">Bitte Namen angeben.</span></div>
          <div class="field"><label for="sw-email">E-Mail</label><input class="input" id="sw-email" name="email" type="email" autocomplete="email" required /><span class="error">Bitte gültige E-Mail angeben.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="sw-phone">Telefon / WhatsApp <span class="optional">(optional)</span></label><input class="input" id="sw-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="field"><label for="sw-qty">Stückzahl</label><select class="select" id="sw-qty" name="qty" required><option value="" disabled selected>Bitte wählen</option><option>Sample, 1 bis 5</option><option>10 bis 49</option><option>50 bis 99</option><option>100 bis 249</option><option>250 und mehr</option><option>Print-on-Demand, laufend</option></select><span class="error">Bitte Stückzahl wählen.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="sw-product">Was willst du produzieren?</label><select class="select" id="sw-product" name="product"><option>Heavy Oversize Tees</option><option>Hoodies</option><option>Tees und Hoodies</option><option>Sweater, Zipper, Caps</option><option>Noch offen</option></select></div>
          <div class="field"><label for="sw-source">Wie hast du uns gefunden? <span class="optional">(optional)</span></label><select class="select" id="sw-source" name="source"><option value="">Bitte wählen</option><option>Google</option><option>ChatGPT / KI-Suche</option><option>Instagram</option><option>TikTok</option><option>Empfehlung</option><option>Shopify App Store</option><option>Sonstiges</option></select></div>
        </div>
        <div class="field"><label for="sw-msg">Motiv, Positionen, Fragen <span class="optional">(optional)</span></label><textarea class="textarea" id="sw-msg" name="message" rows="3" placeholder="z. B. Backprint 30 x 40 auf BY102 schwarz, Logo klein vorne, Nackenprint, 60 Stück, Link zum Insta"></textarea></div>
        <div class="field"><label class="checkbox"><input type="checkbox" name="privacy" required /><span>Ich habe die <a href="/datenschutz" class="accent">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Daten zur Bearbeitung der Anfrage einverstanden.</span></label><span class="error">Bitte bestätige den Datenschutzhinweis.</span></div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
        <button type="submit" class="btn btn-primary btn-lg" data-submit>Angebot anfragen <Icon name="arrow-right" size={18} /></button>
        <p class="form-trust"><span><Icon name="check" weight="bold" size={13} /> Kein Spam</span><span><Icon name="check" weight="bold" size={13} /> Unverbindlich</span><span><Icon name="check" weight="bold" size={13} /> Antwort aus der Werkstatt</span></p>
        <p class="form-note" data-note role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section compare-section">
    <div class="container">
      <div class="section-head reveal"><h2>Werkstatt statt Plattform, Drop statt Fabrik</h2><p>Ehrlicher Vergleich für ein Label, das mit einem Drop starten will.</p></div>
      <div class="table-wrap reveal">
        <table class="cmp-table">
          <thead><tr><th></th><th class="hi">westernprint</th><th>POD-Plattform</th><th>Fabrik (PT/TR)</th></tr></thead>
          <tbody>
            {compare.map((r) => (<tr><th scope="row">{r.k}</th><td class="hi">{r.wp}</td><td>{r.pod}</td><td>{r.fab}</td></tr>))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section quality-section">
    <div class="container quality-grid">
      <div class="quality-img reveal">
        <img src="/img/streetwear/model-man.jpg" alt="Model in schwarzem Zip-Hoodie und weiter Sweathose vor Betonwand" width="1024" height="1536" loading="lazy" />
      </div>
      <div class="reveal reveal-d1">
        <h2>Druck, der nach der zehnten Wäsche noch nach Marke aussieht</h2>
        <p class="muted">Kein Plastisol-Gefühl, kein Riss nach drei Wäschen. DTF auf Heavy Cotton, deckend auf Schwarz, dehnbar. Jedes Teil wird vor dem Verpacken geprüft.</p>
        <ul class="quality-list">
          <li><strong>DTF, waschfest bis 60 °C</strong><span>Feine Linien, Farbverläufe, Fotos. Auf Wunsch reduzierte Deckung für Vintage-Look.</span></li>
          <li><strong>Blanks bis 500 g/m²</strong><span>Build Your Brand, Urban Classics, Stanley/Stella. Die gängigen Modelle in Schwarz und Weiß liegen bei uns auf Lager.</span></li>
          <li><strong>Gedruckt in Oberhausen</strong><span>Eigene Epson-Maschinen, eigene Heißpressen, kein Zwischenhändler.</span></li>
          <li><strong>Shopify-App für danach</strong><span>Bestellungen laufen automatisch ein, Versand neutral mit DHL, Tracking an deine Kunden.</span></li>
        </ul>
        <div class="sw-cta"><a href="/print-on-demand" class="btn btn-secondary">Print-on-Demand ansehen</a><a href="/druckverfahren" class="btn btn-secondary">Druckverfahren</a></div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Fragen von Label-Gründern" />
  <CtaBand title="Bereit für dein erstes Sample?" text="Schick uns Motiv und Wunsch-Blank. Du bekommst innerhalb von 24 Stunden ein Angebot mit Stückpreisen für Sample, Drop und Nachdrop." />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.sw-form');
  if (form) {
    const note = form.querySelector<HTMLElement>('[data-note]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const setNote = (kind: string, text: string) => { note.className = 'form-note ' + kind; note.textContent = text; };
    const validate = () => {
      let ok = true;
      form.querySelectorAll<HTMLElement>('.field').forEach((f) => {
        const input = f.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
        if (!input || !input.hasAttribute('required')) return;
        const valid = input instanceof HTMLInputElement && input.type === 'checkbox' ? input.checked : input.checkValidity() && input.value.trim() !== '';
        f.classList.toggle('has-error', !valid); if (!valid) ok = false;
      });
      return ok;
    };
    form.addEventListener('input', (e) => (e.target as HTMLElement).closest('.field')?.classList.remove('has-error'));
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); setNote('', '');
      if (!validate()) { setNote('err', 'Bitte prüfe die markierten Felder.'); return; }
      const d = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (d._gotcha) return;
      const message = [`Anfrage Streetwear-Brand über westernprint.de`, d.brand ? `Brand: ${d.brand}` : '', `Stand: ${d.stage}`, `Stückzahl: ${d.qty}`, `Produkt: ${d.product}`, '', d.message || ''].filter((l) => l !== '').join('\n');
      submit.disabled = true; submit.textContent = 'Wird gesendet...';
      try {
        const res = await fetch(form.dataset.endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: d.name, email: d.email, phone: d.phone, topic: 'Streetwear-Brand', qty: d.qty, message, gclid: (window as any).wpGclid?.() || '', page: location.pathname, source: d.source }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.ok) throw new Error(j.error || String(res.status));
        form.reset();
        (window as any).wpTrack?.('lead');
        setNote('ok', 'Danke! Deine Anfrage ist angekommen. Wir melden uns werktags meist innerhalb weniger Stunden per E-Mail oder WhatsApp.');
      } catch (err) {
        setNote('err', `Senden hat nicht geklappt (${(err as Error).message}). Schreib uns direkt per WhatsApp oder an info@westernprint.de.`);
      } finally { submit.disabled = false; submit.innerHTML = 'Angebot anfragen'; }
    });
  }
</script>

