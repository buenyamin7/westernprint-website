---
// Landingpage für Streetwear-Brands und Label-Gründer. Zielseite der Google-Ads-Kampagne "Streetwear Brands"
// und Antwortseite für KI-Suche (ChatGPT, Perplexity): klare Fakten, Mengen, Preise, Ablauf, FAQ.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { zielgruppen } from '../../data/zielgruppen';

const z = zielgruppen.find((x) => x.slug === 'streetwear-brands')!;

// Blanks für Labels. Preise netto je Stück ab 50 Stück, inkl. Frontdruck (bis 30 x 40 cm) und Nackenprint.
// Zahlen sind kalkuliert aus EK + Druckstaffel, bitte mit Bünyamin abgleichen, bevor sie skaliert werden.
const blanks = [
  { code: 'BY102', name: 'Heavy Oversize Tee', brand: 'Build Your Brand', tag: 'Der Standard', spec: '240 g/m², 100 % Baumwolle, Drop Shoulder, S bis 5XL', price: '16,90', img: '/img/products/byb-by102-black.webp', proof: 'Das Shirt der meisten Brands' },
  { code: 'BY163', name: 'Ultra Heavy Cotton Box Tee', brand: 'Build Your Brand', tag: 'Boxy, 300 g', spec: '300 g/m², kastiger Schnitt, steht wie ein Brett', price: '20,90', img: '/img/products/byb-by163-black.webp', proof: 'Schwerstes Tee im Sortiment' },
  { code: 'BY199', name: 'Oversized Hoody', brand: 'Build Your Brand', tag: 'Oversize-Favorit', spec: '300 g/m², Drop Shoulder, gekreuzte Kapuze', price: '31,90', img: '/img/products/byb-by199-black.webp', proof: 'Meistverkaufter Hoodie' },
  { code: 'BY162', name: 'Ultra Heavy Box Hoody', brand: 'Build Your Brand', tag: 'Boxy Fit', spec: '460 g/m², 100 % Baumwolle, kastig', price: '38,90', img: '/img/products/byb-by162-black.webp', proof: 'Peso-Look' },
  { code: 'BY268', name: 'Ultra Heavy Oversized', brand: 'Build Your Brand', tag: 'Schwerster Hoodie', spec: '500 g/m², Oversize, 80 % Baumwolle', price: '43,90', img: '/img/products/byb-by268-black.webp', proof: 'Wie bei LFDY und 6PM' },
];

const services = [
  { icon: 'tag', t: 'Nackenprint statt Etikett', d: 'Alle Blanks sind tearaway. Wir entfernen das Herstelleretikett und drucken dein Label per DTF in den Nacken. Sieht aus wie eingewebt.' },
  { icon: 'arrows-out-line-horizontal', t: 'Front, Rücken, Ärmel, Saum', d: 'Bis 30 x 40 cm pro Position. Kleine Logos, große Backprints, Ärmelschriftzüge. Jede Position hat einen festen Preis.' },
  { icon: 'package', t: 'Hangtags und Verpackung', d: 'Du lieferst Hangtags und Polybags, wir bringen sie an und verpacken versandfertig. Ohne Aufpreis, solange es nicht ein Lager füllt.' },
  { icon: 'truck', t: 'Neutraler Versand an deine Kunden', d: 'Bei Print-on-Demand geht das Paket ohne westernprint-Absender raus. Deine Marke, dein Name, deine Rechnung.' },
  { icon: 'archive', t: 'Lager und Nachproduktion', d: 'Druckdaten, Farben und Positionen bleiben gespeichert. Nachdrop in identischer Qualität, ab 10 Stück pro Motiv.' },
  { icon: 'chat-circle-dots', t: 'Beratung von Leuten, die drucken', d: 'Welche Grammatur, welcher Schnitt, welche Druckgröße auf Boxy Fit. Antwort kommt aus der Werkstatt, nicht aus dem Ticketsystem.' },
];

const compare = [
  { k: 'Stückpreis Heavy Oversize Tee', wp: 'ab 16,90 € netto ab 50 Stück', pod: '25 bis 30 € pro Stück', fab: 'ab 8 € bei 300+ Stück' },
  { k: 'Mindestmenge', wp: 'Sample ab 1, Drop ab 50', pod: '1 Stück', fab: '300 bis 500 pro Modell' },
  { k: 'Deine Marge bei 49 € Verkaufspreis', wp: 'rund 30 €', pod: 'rund 15 €', fab: 'rund 38 €, aber Vorkasse für 300 Stück' },
  { k: 'Eigenes Label im Nacken', wp: 'Ja, DTF-Nackenprint', pod: 'Meist nicht oder Aufpreis', fab: 'Ja, eingewebt' },
  { k: 'Blanks', wp: 'Build Your Brand, Urban Classics, Stanley/Stella', pod: 'Gildan, Bella+Canvas', fab: 'Eigener Schnitt' },
  { k: 'Lieferzeit', wp: 'Sample 1 bis 3 Werktage, Drop 7 bis 10', pod: '5 bis 8 Werktage', fab: '8 bis 14 Wochen' },
  { k: 'Fulfillment für deinen Shop', wp: 'Ja, Shopify-App', pod: 'Ja', fab: 'Nein' },
];

const faqs = [
  { q: 'Was kostet ein Drop für meine Streetwear-Brand?', a: 'Ab 50 Stück liegt das Heavy Oversize Tee (240 g/m²) bei 16,90 € netto pro Stück inklusive Frontdruck und Nackenprint, der Oversized Hoody (300 g/m²) bei 31,90 €, der Ultra Heavy Hoody mit 500 g/m² bei 43,90 €. Ab 100 Stück wird es günstiger. Das genaue Angebot bekommst du innerhalb von 24 Stunden.' },
  { q: 'Gibt es eine Mindestmenge?', a: 'Ein Sample geht ab 1 Stück zum Einzelpreis. Die Drop-Preise gelten ab 50 Stück pro Bestellung, gemischt über Modelle, Größen und Farben. Nachdrops ab 10 Stück pro Motiv.' },
  { q: 'Welche Blanks nehmen Streetwear-Brands?', a: 'Heavy Oversize Tees ab 240 g/m² und Boxy oder Oversize Hoodies ab 300 g/m² von Build Your Brand, dazu Urban Classics und Stanley/Stella für Bio-Baumwolle. Das sind dieselben Blanks, die bekannte deutsche Streetwear-Labels nutzen. Wir beraten zu Grammatur und Schnitt.' },
  { q: 'Kann ich mein eigenes Label in den Nacken machen?', a: 'Ja. Die Blanks haben tearaway-Etiketten. Wir entfernen das Herstellerlabel und drucken deinen Nackenprint per DTF, deckend und waschfest. Hangtags bringen wir an, wenn du sie lieferst.' },
  { q: 'Wie starte ich mit wenig Budget?', a: 'Sample bestellen, Fotos machen, Vorbestellungen im Shop sammeln, dann den Drop ab 50 Stück produzieren. Oder direkt Print-on-Demand: Wir drucken und versenden jede Shop-Bestellung einzeln, du zahlst nur, was verkauft ist.' },
  { q: 'Wie funktioniert Print-on-Demand für meine Marke?', a: 'Du verbindest deinen Shopify-Shop mit unserer App. Bestellungen laufen automatisch bei uns ein, wir drucken in 1 bis 3 Werktagen und versenden neutral mit DHL an deine Kunden. Kein Lager, keine Vorkasse für Ware.' },
  { q: 'Hält DTF-Druck auf Heavy Cotton?', a: 'Ja. DTF ist dehnbar, deckend auf Schwarz und waschfest bis 60 °C. Für Vintage-Looks drucken wir auf Wunsch mit reduzierter Deckung. Fotorealistische Motive gehen per DTG auf Baumwolle.' },
  { q: 'Wie lange dauert ein Drop?', a: 'Sample in 1 bis 3 Werktagen. Drop ab 50 Stück in der Regel 7 bis 10 Werktage nach Freigabe des Korrekturabzugs. Express nach Absprache. Abholung in Oberhausen oder Versand deutschlandweit.' },
  { q: 'Verkauft ihr auch unbedruckte Blanks?', a: 'Ja, für Labels, die bei uns produzieren, liefern wir Blanks von Build Your Brand und Urban Classics auch unbedruckt mit, zum Beispiel für Fotoshootings oder eigene Veredelung.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Streetwear-Brand produzieren lassen', serviceType: 'Textildruck und Fulfillment für Modelabels', description: z.description, provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: { '@type': 'Country', name: 'Deutschland' }, audience: { '@type': 'Audience', audienceType: 'Streetwear-Brands, Modelabels, Gründer' }, url: `${site.url}/fuer/streetwear-brands`, offers: { '@type': 'Offer', priceCurrency: 'EUR', price: '16.90', description: 'Heavy Oversize Tee ab 16,90 € netto inklusive Frontdruck und Nackenprint, ab 50 Stück. Sample ab 1 Stück.' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Start', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Für wen wir drucken', item: `${site.url}/fuer` }, { '@type': 'ListItem', position: 3, name: 'Streetwear-Brands', item: `${site.url}/fuer/streetwear-brands` }] },
];
---
<Base title="Streetwear-Brand produzieren lassen: Blanks, Nackenprint, Drop ab 50" description="Eigene Streetwear-Marke ohne Fabrik: Heavy Oversize Tees und Hoodies von Build Your Brand, DTF-Druck mit Nackenprint, Sample in 3 Tagen, Drop ab 50 Stück ab 16,90 € netto, danach Print-on-Demand. Druckerei in Oberhausen." jsonLd={ld} ogImage={z.image}>

  <div class="usp-bar" aria-label="Vorteile">
    <div class="container usp-track">
      <span><Icon name="t-shirt" size={16} /> Sample ab 1 Stück in 1 bis 3 Werktagen</span>
      <span><Icon name="tag" size={16} /> Nackenprint statt Herstelleretikett</span>
      <span><Icon name="stack" size={16} /> Drop ab 50 Stück, gemischt</span>
      <span><Icon name="truck" size={16} /> Print-on-Demand mit neutralem Versand</span>
    </div>
  </div>

  <section class="sw-hero">
    <div class="container sw-hero-grid">
      <div class="sw-copy">
        <span class="eyebrow">Für Streetwear-Brands, Labels und Gründer</span>
        <h1>Deine Brand. Unsere Werkstatt. <span class="hl">Kein Fabrik-Minimum.</span></h1>
        <p class="lede">Heavy Oversize Tee, Boxy Hoodie, dein Label im Nacken. Erst ein Sample, dann der Drop ab 50 Stück, danach drucken und versenden wir jede Shop-Bestellung für dich. Aus Oberhausen, für ganz Deutschland.</p>

        <div class="offer-box">
          <img src="/img/products/byb-by102-black.webp" alt="Schwarzes Heavy Oversize Tee" width="360" height="450" loading="eager" />
          <div>
            <span class="offer-kicker">Einstieg</span>
            <strong>Sample in 3 Tagen, Drop ab 50 Stück</strong>
            <p>Heavy Oversize Tee ab 16,90 € netto, Oversized Hoody ab 31,90 € netto, jeweils inklusive Frontdruck und Nackenprint. Dieselben Blanks wie die bekannten Brands.</p>
            <ul class="offer-facts">
              <li><Icon name="check" weight="bold" size={14} /> Build Your Brand, Urban Classics, Stanley/Stella</li>
              <li><Icon name="check" weight="bold" size={14} /> Angebot in 24 Stunden, Korrekturabzug als PDF</li>
              <li><Icon name="check" weight="bold" size={14} /> Shopify-App für Print-on-Demand danach</li>
            </ul>
          </div>
        </div>

        <p class="trust-row"><span><strong>80.000+</strong> bedruckte Textilien</span><span><strong>seit 2021</strong> in Oberhausen</span><span><strong>12</strong> Shops auf unserer POD-App</span></p>

        <div class="sw-cta">
          <a href="#anfrage" class="btn btn-primary btn-lg">Sample oder Drop anfragen <Icon name="arrow-right" size={18} /></a>
          <a href={site.whatsapp + '?text=' + encodeURIComponent('Hallo westernprint, ich baue eine Streetwear-Brand auf und möchte ein Sample / einen Drop anfragen.')} class="btn btn-secondary btn-lg" target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} /> Per WhatsApp</a>
        </div>
      </div>

      <form class="sw-form" id="anfrage" data-endpoint={site.formEndpoint} novalidate>
        <h2>Angebot in 24 Stunden</h2>
        <p class="muted">Kurz die Eckdaten. Du bekommst Preise pro Blank, Druckpositionen und einen Zeitplan, werktags meist innerhalb weniger Stunden.</p>
        <div class="row">
          <div class="field"><label for="sw-brand">Name deiner Brand <span class="optional">(oder Arbeitstitel)</span></label><input class="input" id="sw-brand" name="brand" type="text" placeholder="z. B. NORDWEST STUDIO" /></div>
          <div class="field"><label for="sw-stage">Wo stehst du?</label><select class="select" id="sw-stage" name="stage" required><option value="" disabled selected>Bitte wählen</option><option>Idee, brauche Sample</option><option>Erster Drop geplant</option><option>Brand läuft, suche Produzent</option><option>Print-on-Demand für meinen Shop</option></select><span class="error">Bitte auswählen.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="sw-name">Dein Name</label><input class="input" id="sw-name" name="name" type="text" autocomplete="name" required /><span class="error">Bitte Namen angeben.</span></div>
          <div class="field"><label for="sw-email">E-Mail</label><input class="input" id="sw-email" name="email" type="email" autocomplete="email" required /><span class="error">Bitte gültige E-Mail angeben.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="sw-phone">Telefon / WhatsApp <span class="optional">(optional)</span></label><input class="input" id="sw-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="field"><label for="sw-qty">Stückzahl</label><select class="select" id="sw-qty" name="qty" required><option value="" disabled selected>Bitte wählen</option><option>Sample, 1 bis 5</option><option>10 bis 49</option><option>50 bis 99</option><option>100 bis 249</option><option>250 und mehr</option><option>Print-on-Demand, laufend</option></select><span class="error">Bitte Stückzahl wählen.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="sw-product">Was willst du produzieren?</label><select class="select" id="sw-product" name="product"><option>Heavy Oversize Tees</option><option>Hoodies</option><option>Tees und Hoodies</option><option>Sweater, Zipper, Caps</option><option>Noch offen</option></select></div>
          <div class="field"><label for="sw-source">Wie hast du uns gefunden? <span class="optional">(optional)</span></label><select class="select" id="sw-source" name="source"><option value="">Bitte wählen</option><option>Google</option><option>ChatGPT / KI-Suche</option><option>Instagram</option><option>TikTok</option><option>Empfehlung</option><option>Shopify App Store</option><option>Sonstiges</option></select></div>
        </div>
        <div class="field"><label for="sw-msg">Motiv, Positionen, Fragen <span class="optional">(optional)</span></label><textarea class="textarea" id="sw-msg" name="message" rows="3" placeholder="z. B. Backprint 30 x 40 auf BY102 schwarz, Logo klein vorne, Nackenprint, 60 Stück, Link zum Insta"></textarea></div>
        <div class="field"><label class="checkbox"><input type="checkbox" name="privacy" required /><span>Ich habe die <a href="/datenschutz" class="accent">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Daten zur Bearbeitung der Anfrage einverstanden.</span></label><span class="error">Bitte bestätige den Datenschutzhinweis.</span></div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
        <button type="submit" class="btn btn-primary btn-lg" data-submit>Angebot anfragen <Icon name="arrow-right" size={18} /></button>
        <p class="form-trust"><span><Icon name="check" weight="bold" size={13} /> Kein Spam</span><span><Icon name="check" weight="bold" size={13} /> Unverbindlich</span><span><Icon name="check" weight="bold" size={13} /> Antwort aus der Werkstatt</span></p>
        <p class="form-note" data-note role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section-tight steps-section">
    <div class="container">
      <div class="section-head reveal"><h2>Vom ersten Sample zur laufenden Brand</h2><p class="muted">Drei Stufen, du steigst ein, wo du stehst. Kein Vertrag, keine Vorkasse für Ware, die du noch nicht verkauft hast.</p></div>
      <ol class="steps">
        <li class="reveal"><span class="num">1</span><div><strong>Sample</strong><span>Blank wählen, Motiv schicken, Korrekturabzug freigeben. Ein Stück in 1 bis 3 Werktagen für Fotos, Anprobe und Vorbestellungen.</span></div></li>
        <li class="reveal reveal-d1"><span class="num">2</span><div><strong>Drop ab 50 Stück</strong><span>Modelle, Größen und Farben gemischt. Nackenprint, Hangtags, Polybags, ein Paket oder Abholung. 7 bis 10 Werktage.</span></div></li>
        <li class="reveal reveal-d2"><span class="num">3</span><div><strong>Print-on-Demand</strong><span>Shop an unsere Shopify-App anbinden. Wir drucken jede Bestellung einzeln und versenden neutral an deine Kunden.</span></div></li>
        <li class="reveal reveal-d3"><span class="num">4</span><div><strong>Nachdrop</strong><span>Druckdaten bleiben bei uns. Bestseller nachproduzieren ab 10 Stück pro Motiv, in identischer Qualität.</span></div></li>
      </ol>
    </div>
  </section>

  <section class="section products-section" id="blanks">
    <div class="container">
      <div class="section-head reveal"><h2>Blanks, die Brands tragen</h2><p class="muted">Preise netto pro Stück ab 50 Stück, inklusive Frontdruck bis 30 x 40 cm und Nackenprint. Ab 100 Stück günstiger, Sample zum Einzelpreis. Farben: Schwarz, Weiß, Sand, Grau, Navy und weitere.</p></div>
      <div class="pgrid">
        {blanks.map((p, i) => (
          <a href="#anfrage" class={`pcard reveal reveal-d${i % 4}`}>
            <span class="ptag">{p.tag}</span>
            <div class="pimg"><img src={p.img} alt={`${p.name} von ${p.brand}, schwarz`} width="720" height="900" loading="lazy" /></div>
            <div class="pbody">
              <span class="pbrand">{p.brand} · {p.code}</span>
              <strong>{p.name}</strong>
              <span class="pspec">{p.spec}</span>
              <span class="proof"><Icon name="fire" weight="fill" size={13} /> {p.proof}</span>
              <span class="price">ab {p.price} € <small>netto, inkl. Druck</small></span>
            </div>
          </a>
        ))}
      </div>
      <p class="muted center small">Dazu Urban Classics (Heavy Oversize, Acid Washed), Stanley/Stella für Bio-Baumwolle, Zipper, Sweater, Caps und Beanies. Eigene Blanks kannst du anliefern, dann zahlst du nur den Druck.</p>
    </div>
  </section>

  <section class="section-tight services-section">
    <div class="container">
      <div class="section-head reveal"><h2>Was du bekommst, außer Druck</h2><p class="muted">Die Details, die ein Shirt von einem Markenprodukt unterscheiden.</p></div>
      <div class="services">
        {services.map((s, i) => (
          <div class={`service reveal reveal-d${i % 3}`}>
            <span class="icon-box"><Icon name={s.icon} size={22} /></span>
            <strong>{s.t}</strong>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section compare-section">
    <div class="container">
      <div class="section-head reveal"><h2>Werkstatt statt Plattform, Drop statt Fabrik</h2><p class="muted">Ehrlicher Vergleich für ein Heavy Oversize Tee, das du für 49 € verkaufst.</p></div>
      <div class="table-wrap reveal">
        <table class="cmp-table">
          <thead><tr><th></th><th class="hi">westernprint</th><th>POD-Plattform</th><th>Fabrik (PT/TR)</th></tr></thead>
          <tbody>
            {compare.map((r) => (<tr><th scope="row">{r.k}</th><td class="hi">{r.wp}</td><td>{r.pod}</td><td>{r.fab}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="muted center small">Plattformpreise sind Marktdurchschnitt Stand 2026, Fabrikpreise Richtwerte für Cut-and-Sew in Portugal oder der Türkei ohne Versand und Zoll.</p>
    </div>
  </section>

  <section class="section quality-section">
    <div class="container quality-grid">
      <div class="reveal">
        <span class="eyebrow">Qualität</span>
        <h2>Druck, der nach der zehnten Wäsche noch nach Marke aussieht</h2>
        <p class="muted">Kein Plastisol-Gefühl, kein Riss nach drei Wäschen. DTF auf Heavy Cotton, deckend auf Schwarz, dehnbar. Jedes Teil wird vor dem Verpacken geprüft.</p>
        <ul class="quality-list">
          <li><span class="icon-box"><Icon name="drop" size={20} /></span><div><strong>DTF, waschfest bis 60 °C</strong><span>Feine Linien, Farbverläufe, Fotos. Auf Wunsch reduzierte Deckung für Vintage-Look.</span></div></li>
          <li><span class="icon-box"><Icon name="t-shirt" size={20} /></span><div><strong>Blanks bis 500 g/m²</strong><span>Build Your Brand, Urban Classics, Stanley/Stella. Wir lagern die gängigen Modelle in Schwarz und Weiß.</span></div></li>
          <li><span class="icon-box"><Icon name="factory" size={20} /></span><div><strong>Gedruckt in Oberhausen</strong><span>Eigene Epson-Maschinen, eigene Heißpressen, kein Zwischenhändler.</span></div></li>
          <li><span class="icon-box"><Icon name="storefront" size={20} /></span><div><strong>Shopify-App für danach</strong><span>Bestellungen laufen automatisch ein, Versand neutral mit DHL, Tracking an deine Kunden.</span></div></li>
        </ul>
        <div class="sw-cta"><a href="/print-on-demand" class="btn btn-secondary">Print-on-Demand ansehen</a><a href="/druckverfahren" class="btn btn-secondary">Druckverfahren</a></div>
      </div>
      <div class="quality-img reveal reveal-d1">
        <img src="/img/streetwear-trio.jpg" alt="Drei Personen in schweren Oversize-Shirts" width="900" height="1000" loading="lazy" />
        <img class="detail" src="/img/druck-makro.jpg" alt="Nahaufnahme eines DTF-Drucks" width="600" height="450" loading="lazy" />
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Fragen von Label-Gründern" />
  <CtaBand title="Bereit für dein erstes Sample?" text="Schick uns Motiv und Wunsch-Blank. Du bekommst innerhalb von 24 Stunden ein Angebot mit Stückpreisen für Sample, Drop und Nachdrop." />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.sw-form');
  if (form) {
    const note = form.querySelector<HTMLElement>('[data-note]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const setNote = (kind: string, text: string) => { note.className = 'form-note ' + kind; note.textContent = text; };
    const validate = () => {
      let ok = true;
      form.querySelectorAll<HTMLElement>('.field').forEach((f) => {
        const input = f.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
        if (!input || !input.hasAttribute('required')) return;
        const valid = input instanceof HTMLInputElement && input.type === 'checkbox' ? input.checked : input.checkValidity() && input.value.trim() !== '';
        f.classList.toggle('has-error', !valid); if (!valid) ok = false;
      });
      return ok;
    };
    form.addEventListener('input', (e) => (e.target as HTMLElement).closest('.field')?.classList.remove('has-error'));
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); setNote('', '');
      if (!validate()) { setNote('err', 'Bitte prüfe die markierten Felder.'); return; }
      const d = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (d._gotcha) return;
      const message = [`Anfrage Streetwear-Brand über westernprint.de`, d.brand ? `Brand: ${d.brand}` : '', `Stand: ${d.stage}`, `Stückzahl: ${d.qty}`, `Produkt: ${d.product}`, '', d.message || ''].filter((l) => l !== '').join('\n');
      submit.disabled = true; submit.textContent = 'Wird gesendet...';
      try {
        const res = await fetch(form.dataset.endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: d.name, email: d.email, phone: d.phone, topic: 'Streetwear-Brand', qty: d.qty, message, page: location.pathname, source: d.source }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.ok) throw new Error(j.error || String(res.status));
        form.reset();
        (window as any).wpTrack?.('lead');
        setNote('ok', 'Danke! Deine Anfrage ist angekommen. Wir melden uns werktags meist innerhalb weniger Stunden per E-Mail oder WhatsApp.');
      } catch (err) {
        setNote('err', `Senden hat nicht geklappt (${(err as Error).message}). Schreib uns direkt per WhatsApp oder an info@westernprint.de.`);
      } finally { submit.disabled = false; submit.innerHTML = 'Angebot anfragen'; }
    });
  }
</script>

