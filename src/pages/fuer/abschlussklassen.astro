---
// Landingpage für Abschlussklassen. Zielseite der Google-Ads-Kampagne "Abschluss".
// Aufbau nach dem Muster erfolgreicher Anbieter: Angebot oben, Kurzformular, Ablauf, Produkte mit Preis, Motiv-Ideen, Qualität, FAQ.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { zielgruppen } from '../../data/zielgruppen';

const z = zielgruppen.find((x) => x.slug === 'abschlussklassen')!;
const year = new Date().getMonth() >= 6 ? new Date().getFullYear() + 1 : new Date().getFullYear();

// Klassenpreise: ab 20 Stück, inkl. Druck vorne + hinten (Namensliste), inkl. MwSt.
// proof = Social Proof auf der Karte. Zahlen bitte mit Bünyamin abgleichen, bevor sie skaliert werden.
const oversize = [
  { handle: null, name: 'Oversized Hoody', brand: 'Build Your Brand', tag: 'Oversize-Favorit', spec: '300 g/m², Drop Shoulder, gekreuzte Kapuze, bis 5XL', price: '38,90', img: '/img/products/byb-by199-black.webp', proof: 'Neu im Sortiment' },
  { handle: null, name: 'Ultra Heavy Box Hoody', brand: 'Build Your Brand', tag: 'Boxy Fit', spec: '460 g/m², 100 % Baumwolle, kastiger Schnitt', price: '46,90', img: '/img/products/byb-by162-black.webp', proof: 'Streetwear-Qualität' },
  { handle: null, name: 'Ultra Heavy Oversized', brand: 'Build Your Brand', tag: 'Schwerster Hoodie', spec: '500 g/m², Oversize, 80 % Baumwolle', price: '52,90', img: '/img/products/byb-by268-black.webp', proof: 'Wie bei Peso und LFDY' },
  { handle: 'cruiser-2-0', name: 'Cruiser 2.0', brand: 'Stanley/Stella', tag: 'Bio, Relaxed Fit', spec: '350 g/m², Bio-Baumwolle, 43 Farben', price: '39,90', img: '/img/products/cruiser-2-0-black-flat.webp', proof: 'Über 3.000× gedruckt' },
];
const classic = [
  { handle: 'classic-hoodie', name: 'Classic Hoodie', brand: 'Stedman', tag: 'Beliebteste Wahl', spec: '280 g/m², Kängurutasche, 11 Farben', price: '28,90', img: '/img/products/classic-hoodie-black-opal.webp', proof: 'Über 8.000× gedruckt' },
  { handle: null, name: 'Heavy Hoody', brand: 'Build Your Brand', tag: 'Regular Fit, schwer', spec: '300 g/m², Regular Fit, bis 5XL', price: '32,90', img: '/img/products/byb-by011-black.webp', proof: 'Neu im Sortiment' },
  { handle: 'classic-t', name: 'Classic-T', brand: 'Stedman', tag: 'Günstigster Einstieg', spec: '155 g/m², 34 Farben, Damen und Unisex', price: '16,90', img: '/img/products/classic-t-black-opal.webp', proof: 'Über 20.000× gedruckt' },
  { handle: 'creator-2-0', name: 'Creator 2.0', brand: 'Stanley/Stella', tag: 'Bio-Shirt', spec: '180 g/m², Bio-Baumwolle, 46 Farben', price: '20,90', img: '/img/products/creator-2-0-black-flat.webp', proof: 'Über 12.000× gedruckt' },
];

const styles = [
  { t: 'Namensliste', d: 'Alle Namen der Stufe untereinander auf dem Rücken. Der Klassiker.', kind: 'list' },
  { t: 'Playlist', d: 'Jeder Name als Song, das Motto als Album. Sieht aus wie eure Lieblings-App.', kind: 'playlist' },
  { t: 'Zeitung', d: 'Schlagzeile, Datum, Namen als Artikel. „The Abschluss Times“.', kind: 'news' },
  { t: 'Flaggen', d: 'Name plus Herkunftsflagge. Für Stufen, die aus der ganzen Welt kommen.', kind: 'flags' },
  { t: 'Autogramme', d: 'Alle unterschreiben, wir drucken die echten Unterschriften.', kind: 'sign' },
  { t: 'Eigenes Motiv', d: 'Screenshot von Pinterest oder Skizze reicht. Wir machen es druckfertig.', kind: 'own' },
];

const faqs = [
  { q: 'Was kostet ein Abschluss-Hoodie bei euch?', a: `Ab 20 Stück liegt der Stedman Classic Hoodie bei 28,90 € pro Stück, inklusive Druck vorne und hinten, Namensliste und MwSt. Oversize-Hoodies von Build Your Brand ab 38,90 €, der Ultra Heavy mit 500 g/m² ab 52,90 €. Shirts ab 16,90 €. Ab 50 Stück wird es günstiger, das genaue Angebot bekommt ihr innerhalb von 24 Stunden.` },
  { q: 'Gibt es eine Mindestmenge?', a: 'Nein. Ab 1 Stück ist alles möglich, die Klassenpreise gelten ab 20 Stück. Nachzügler können später zum gleichen Preis nachbestellen.' },
  { q: 'Kostet das Design extra?', a: 'Nein. Schriftzug, Motto, Namensliste und Korrekturabzug sind inklusive. Ihr bekommt eine Vorschau als PDF und wir ändern so lange, bis alles passt. Erst dann wird gedruckt.' },
  { q: 'Wie lange dauert die Lieferung?', a: 'Nach Freigabe des Korrekturabzugs in der Regel 5 bis 10 Werktage. Wenn die Stufe spät dran ist, geht Express in 2 bis 3 Werktagen, bitte früh anfragen. Abholung in Oberhausen ist kostenlos.' },
  { q: 'Können wir Größen und Farben mischen?', a: 'Ja, ohne Aufpreis. Ein Ansprechpartner sammelt die Liste, wir liefern alles sortiert und beschriftet in einem Paket.' },
  { q: 'Wie bezahlen wir als Klasse?', a: 'Nach Freigabe bekommt ihr eine Rechnung mit Zahlungslink: Überweisung, Kreditkarte, PayPal oder Klarna. Eine Person zahlt gesammelt, wir brauchen keine Einzelzahlungen.' },
  { q: 'Hält der Druck?', a: 'Wir drucken per DTF, deckend auf dunklen Stoffen, dehnbar, waschfest bis 60 °C. Das Verfahren nutzen wir auch für Vereine und Firmen, die ihre Sachen täglich waschen.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Abschluss-Hoodies und Abishirts bedrucken', serviceType: 'Textildruck', description: z.description, provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: [{ '@type': 'City', name: 'Oberhausen' }, { '@type': 'AdministrativeArea', name: 'Ruhrgebiet' }, { '@type': 'Country', name: 'Deutschland' }], audience: { '@type': 'Audience', audienceType: 'Abschlussklassen, Abiturjahrgänge, Schulklassen' }, url: `${site.url}/fuer/abschlussklassen`, offers: { '@type': 'Offer', priceCurrency: 'EUR', price: '16.90', description: 'Abschluss-Shirts ab 16,90 €, Hoodies ab 28,90 € inklusive Druck vorne und hinten, ab 20 Stück' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Start', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Für wen wir drucken', item: `${site.url}/fuer` }, { '@type': 'ListItem', position: 3, name: 'Abschlussklassen', item: `${site.url}/fuer/abschlussklassen` }] },
];
---
<Base title={`Abschluss-Hoodies und Abishirts ${year} bedrucken lassen`} description={`Abschluss-Hoodies ab 28,90 € und Abishirts ab 16,90 € inklusive Druck vorne und hinten. Gratis Design, Korrekturabzug, Lieferung in 5 bis 10 Werktagen. Druckerei in Oberhausen, Angebot in 24 Stunden.`} jsonLd={ld} ogImage={z.image}>

  <div class="usp-bar" aria-label="Vorteile">
    <div class="container usp-track">
      <span><Icon name="pen-nib" size={16} /> Gratis Design und Korrekturabzug</span>
      <span><Icon name="t-shirt" size={16} /> Druck vorne und hinten inklusive</span>
      <span><Icon name="truck" size={16} /> Lieferung in 5 bis 10 Werktagen</span>
      <span><Icon name="map-pin" size={16} /> Abholung in Oberhausen gratis</span>
    </div>
  </div>

  <section class="ak-hero">
    <div class="container ak-hero-grid">
      <div class="ak-copy">
        <span class="eyebrow">Für Abschluss, Abi und Klassenfahrt {year}</span>
        <h1>Eure Abschlussklamotten. <span class="hl">Ohne Stress, ohne Risiko.</span></h1>
        <p class="lede">Motto vorne, alle Namen hinten, Mischgrößen ohne Aufpreis. Ihr schickt uns die Idee, wir liefern Design, Druck und ein Paket für die ganze Stufe. Aus Oberhausen, nicht aus dem Callcenter.</p>

        <div class="offer-box">
          <img src="/img/products/byb-by268-black.webp" alt="Schwarzer Oversize-Hoodie" width="360" height="450" loading="eager" />
          <div>
            <span class="offer-kicker">Bei jeder Bestellung ab 20 Stück</span>
            <strong>Design und Druck vorne + hinten inklusive</strong>
            <p>Motto, Namensliste, Korrekturabzug als PDF. Ihr zahlt nur die Textilien mit Druck, keine Grafikkosten, kein Aufpreis für Mischgrößen.</p>
            <ul class="offer-facts">
              <li><Icon name="check" weight="bold" size={14} /> Oversize-Hoodies bis 500 g/m²</li>
              <li><Icon name="check" weight="bold" size={14} /> Angebot in 24 Stunden</li>
              <li><Icon name="check" weight="bold" size={14} /> Zahlung gesammelt per Rechnung</li>
            </ul>
          </div>
        </div>

        <p class="trust-row"><span><strong>80.000+</strong> bedruckte Textilien</span><span><strong>seit 2021</strong> in Oberhausen</span><span><strong>1-3 Tage</strong> Produktion bei Einzelstücken</span></p>

        <div class="ak-cta">
          <a href="#anfrage" class="btn btn-primary btn-lg">Jetzt gratis anfragen <Icon name="arrow-right" size={18} /></a>
          <a href={site.whatsapp + '?text=' + encodeURIComponent('Hallo westernprint, wir haben Interesse an Abschlussklamotten für unsere Stufe.')} class="btn btn-secondary btn-lg" target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} /> Per WhatsApp</a>
        </div>
      </div>

      <form class="ak-form" id="anfrage" data-endpoint={site.formEndpoint} novalidate>
        <h2>Kostenloses Angebot anfragen</h2>
        <p class="muted">Kurz die Eckdaten, wir melden uns werktags meist innerhalb weniger Stunden mit eurem Angebot.</p>
        <div class="field"><label for="ak-school">Schule / Klasse oder Stufe</label><input class="input" id="ak-school" name="school" type="text" required placeholder="z. B. Gymnasium Oberhausen, Q2" /><span class="error">Bitte Schule oder Klasse angeben.</span></div>
        <div class="row">
          <div class="field"><label for="ak-name">Dein Name</label><input class="input" id="ak-name" name="name" type="text" autocomplete="name" required /><span class="error">Bitte Namen angeben.</span></div>
          <div class="field"><label for="ak-email">E-Mail</label><input class="input" id="ak-email" name="email" type="email" autocomplete="email" required /><span class="error">Bitte gültige E-Mail angeben.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="ak-phone">Telefon / WhatsApp <span class="optional">(optional)</span></label><input class="input" id="ak-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="field"><label for="ak-qty">Wie viele seid ihr?</label><select class="select" id="ak-qty" name="qty" required><option value="" disabled selected>Bitte wählen</option><option>10 bis 19</option><option>20 bis 49</option><option>50 bis 99</option><option>100 und mehr</option></select><span class="error">Bitte Stückzahl wählen.</span></div>
        </div>
        <div class="row">
          <div class="field"><label for="ak-product">Was soll es werden?</label><select class="select" id="ak-product" name="product"><option>Hoodies</option><option>Shirts</option><option>Hoodies und Shirts</option><option>Noch offen</option></select></div>
          <div class="field"><label for="ak-when">Wann braucht ihr es?</label><input class="input" id="ak-when" name="when" type="text" placeholder="z. B. bis Ende Juni" /></div>
        </div>
        <div class="field"><label for="ak-msg">Motto, Ideen, Fragen <span class="optional">(optional)</span></label><textarea class="textarea" id="ak-msg" name="message" rows="3" placeholder="z. B. Motto ABIkalypse, Namensliste hinten, schwarz und bordeaux"></textarea></div>
        <div class="field"><label class="checkbox"><input type="checkbox" name="privacy" required /><span>Ich habe die <a href="/datenschutz" class="accent">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Daten zur Bearbeitung der Anfrage einverstanden.</span></label><span class="error">Bitte bestätige den Datenschutzhinweis.</span></div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
        <button type="submit" class="btn btn-primary btn-lg" data-submit>Angebot anfragen <Icon name="arrow-right" size={18} /></button>
        <p class="form-trust"><span><Icon name="check" weight="bold" size={13} /> Kein Spam</span><span><Icon name="check" weight="bold" size={13} /> Unverbindlich</span><span><Icon name="check" weight="bold" size={13} /> Echte Ansprechpartner</span></p>
        <p class="form-note" data-note role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section-tight steps-section">
    <div class="container">
      <div class="section-head reveal"><h2>So läuft es ab</h2><p class="muted">Vier Schritte, eine Person aus eurer Stufe kümmert sich, wir machen den Rest.</p></div>
      <ol class="steps">
        <li class="reveal"><span class="num">1</span><div><strong>Anfrage schicken</strong><span>Formular oder WhatsApp. Stückzahl grob, Motto grob, alles andere klären wir.</span></div></li>
        <li class="reveal reveal-d1"><span class="num">2</span><div><strong>Design gratis</strong><span>Wir setzen Motto und Namensliste und schicken einen Korrekturabzug als PDF.</span></div></li>
        <li class="reveal reveal-d2"><span class="num">3</span><div><strong>Größen sammeln</strong><span>Ihr schickt die Liste mit Größen und Farben. Mischen ist ohne Aufpreis möglich.</span></div></li>
        <li class="reveal reveal-d3"><span class="num">4</span><div><strong>Druck und Lieferung</strong><span>5 bis 10 Werktage nach Freigabe. Ein Paket, sortiert und beschriftet, oder Abholung in Oberhausen.</span></div></li>
      </ol>
    </div>
  </section>

  <section class="section products-section" id="produkte">
    <div class="container">
      <div class="section-head reveal"><h2>Hoodies und Shirts für eure Stufe</h2><p class="muted">Klassenpreise ab 20 Stück, inklusive Druck vorne und hinten, Namensliste und MwSt. Gedruckt wird in Oberhausen.</p></div>
      <h3 class="group-title"><span class="chip chip-good">Oversize</span> Schwer, weit, Streetwear-Schnitt</h3>
      <div class="pgrid">
        {oversize.map((p, i) => (
          <a href={p.handle ? `/shop/${p.handle}` : '#anfrage'} class={`pcard reveal reveal-d${i}`}>
            <span class="ptag">{p.tag}</span>
            <div class="pimg"><img src={p.img} alt={`${p.name} von ${p.brand}, schwarz`} width="720" height="900" loading="lazy" /></div>
            <div class="pbody">
              <span class="pbrand">{p.brand}</span>
              <strong>{p.name}</strong>
              <span class="pspec">{p.spec}</span>
              <span class="proof"><Icon name="fire" weight="fill" size={13} /> {p.proof}</span>
              <span class="price">ab {p.price} € <small>inkl. Druck</small></span>
            </div>
          </a>
        ))}
      </div>
      <h3 class="group-title"><span class="chip">Klassisch</span> Regular Fit, große Farbauswahl</h3>
      <div class="pgrid">
        {classic.map((p, i) => (
          <a href={p.handle ? `/shop/${p.handle}` : '#anfrage'} class={`pcard reveal reveal-d${i}`}>
            <span class="ptag">{p.tag}</span>
            <div class="pimg"><img src={p.img} alt={`${p.name} von ${p.brand}, schwarz`} width="720" height="900" loading="lazy" /></div>
            <div class="pbody">
              <span class="pbrand">{p.brand}</span>
              <strong>{p.name}</strong>
              <span class="pspec">{p.spec}</span>
              <span class="proof"><Icon name="fire" weight="fill" size={13} /> {p.proof}</span>
              <span class="price">ab {p.price} € <small>inkl. Druck</small></span>
            </div>
          </a>
        ))}
      </div>
      <p class="muted center small">Unter 20 Stück drucken wir auch, dann zum Einzelpreis. Ab 50 Stück gibt es weitere Staffelpreise im Angebot. Build-Your-Brand-Modelle gibt es in Schwarz, Weiß, Grau, Sand, Navy und weiteren Farben, Auswahl schicken wir mit dem Angebot.</p>
    </div>
  </section>

  <section class="section-tight styles-section">
    <div class="container">
      <div class="section-head reveal"><h2>Wir drucken jedes Motiv</h2><p class="muted">Screenshot von Pinterest, Skizze auf Papier oder fertige Datei: Wir machen es druckfertig und passen es an, bis die Stufe einverstanden ist. Beliebte Rückseiten:</p></div>
      <div class="styles">
        {styles.map((s, i) => (
          <div class={`style-card reveal reveal-d${i % 3}`}>
            <div class={`preview ${s.kind}`} aria-hidden="true">
              {s.kind === 'list' && <div class="pv-list"><b>ABI {year}</b><i>Lena · Yusuf · Marie · Elias</i><i>Noah · Amira · Tim · Sara</i><i>Leon · Mia · Deniz · Emma</i></div>}
              {s.kind === 'playlist' && <div class="pv-play"><b>ABIkalypse</b><i><em>1</em> Lena K. <small>3:21</small></i><i><em>2</em> Yusuf D. <small>2:58</small></i><i><em>3</em> Marie S. <small>4:02</small></i></div>}
              {s.kind === 'news' && <div class="pv-news"><b>THE ABSCHLUSS TIMES</b><i>Stufe {year} verlässt das Gebäude</i><span></span><span></span><span></span></div>}
              {s.kind === 'flags' && <div class="pv-flags"><i>🇹🇷 Yusuf</i><i>🇩🇪 Lena</i><i>🇵🇱 Kasia</i><i>🇮🇹 Marco</i><i>🇸🇾 Amira</i><i>🇬🇷 Nikos</i></div>}
              {s.kind === 'sign' && <div class="pv-sign"><b>Class of {year}</b><i>Lena</i><i>Yusuf</i><i>Marie</i><i>Elias</i></div>}
              {s.kind === 'own' && <div class="pv-own"><Icon name="image-square" size={34} /><b>Euer Motiv</b></div>}
            </div>
            <strong>{s.t}</strong>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section quality-section">
    <div class="container quality-grid">
      <div class="reveal">
        <span class="eyebrow">Qualität</span>
        <h2>Wird nach dem Abiball noch getragen</h2>
        <p class="muted">Kein dünner Werbestoff, kein Druck, der nach drei Wäschen rissig wird. Wir drucken Abschlussklamotten mit demselben Verfahren wie Arbeitskleidung für Betriebe, die täglich gewaschen wird.</p>
        <ul class="quality-list">
          <li><span class="icon-box"><Icon name="drop" size={20} /></span><div><strong>DTF-Druck, waschfest bis 60 °C</strong><span>Deckend auf schwarz, dehnbar, feine Linien und Fotos möglich.</span></div></li>
          <li><span class="icon-box"><Icon name="t-shirt" size={20} /></span><div><strong>Stoffe bis 350 g/m²</strong><span>Stedman und Stanley/Stella, auf Wunsch Bio-Baumwolle mit GOTS-Zertifikat.</span></div></li>
          <li><span class="icon-box"><Icon name="factory" size={20} /></span><div><strong>Gedruckt in Oberhausen</strong><span>Eigene Epson-Maschinen, jedes Teil wird vor dem Verpacken geprüft.</span></div></li>
          <li><span class="icon-box"><Icon name="chat-circle-dots" size={20} /></span><div><strong>Ein Ansprechpartner</strong><span>WhatsApp, Telefon, E-Mail. Wer anruft, spricht mit jemandem aus der Werkstatt.</span></div></li>
        </ul>
        <a href="/druckverfahren" class="btn btn-secondary">Mehr zum Druckverfahren</a>
      </div>
      <div class="quality-img reveal reveal-d1">
        <img src="/img/streetwear-group.jpg" alt="Vier junge Leute in Oversize-Hoodies" width="900" height="1000" loading="lazy" />
        <img class="detail" src="/img/druck-makro.jpg" alt="Nahaufnahme eines DTF-Drucks" width="600" height="450" loading="lazy" />
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Fragen von Abschlussklassen" />
  <CtaBand title={`Bereit für euren Abschluss ${year}?`} text="Schickt uns Stückzahl und Motto. Ihr bekommt innerhalb von 24 Stunden ein Angebot mit festem Liefertermin." />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.ak-form');
  if (form) {
    const note = form.querySelector<HTMLElement>('[data-note]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const setNote = (kind: string, text: string) => { note.className = 'form-note ' + kind; note.textContent = text; };
    const validate = () => {
      let ok = true;
      form.querySelectorAll<HTMLElement>('.field').forEach((f) => {
        const input = f.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
        if (!input || !input.hasAttribute('required')) return;
        const valid = input instanceof HTMLInputElement && input.type === 'checkbox' ? input.checked : input.checkValidity() && input.value.trim() !== '';
        f.classList.toggle('has-error', !valid); if (!valid) ok = false;
      });
      return ok;
    };
    form.addEventListener('input', (e) => (e.target as HTMLElement).closest('.field')?.classList.remove('has-error'));
    form.addEventListener('submit', async (e) => {
      e.preventDefault(); setNote('', '');
      if (!validate()) { setNote('err', 'Bitte prüfe die markierten Felder.'); return; }
      const d = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (d._gotcha) return;
      const message = [`Anfrage Abschlussklassen über westernprint.de`, `Schule/Klasse: ${d.school}`, `Stückzahl: ${d.qty}`, `Produkt: ${d.product}`, d.when ? `Termin: ${d.when}` : '', '', d.message || ''].filter((l) => l !== '').join('\n');
      submit.disabled = true; submit.textContent = 'Wird gesendet...';
      try {
        const res = await fetch(form.dataset.endpoint!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: d.name, email: d.email, phone: d.phone, topic: 'Abschlussklassen', qty: d.qty, message, page: location.pathname }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.ok) throw new Error(j.error || String(res.status));
        form.reset();
        (window as any).wpTrack?.('lead');
        setNote('ok', 'Danke! Eure Anfrage ist angekommen. Wir melden uns werktags meist innerhalb weniger Stunden per E-Mail oder WhatsApp.');
      } catch (err) {
        setNote('err', `Senden hat nicht geklappt (${(err as Error).message}). Schreibt uns direkt per WhatsApp oder an ${form.dataset.email || 'info@westernprint.de'}.`);
      } finally { submit.disabled = false; submit.innerHTML = 'Angebot anfragen'; }
    });
  }
</script>

<style>
  .usp-bar { background: var(--accent); color: var(--accent-ink); font-size: 13.5px; font-weight: 600; overflow: hidden; }
