    trust={[{ v: 'ab 1', l: 'Stück, keine Mindestmenge' }, { v: '24 h', l: 'bis zum Angebot an Werktagen' }, { v: '5 bis 7', l: 'Werktage bis zur fertigen Serie' }, { v: 'einzeln', l: 'nachbestellen für neue Mitarbeitende' }]}
