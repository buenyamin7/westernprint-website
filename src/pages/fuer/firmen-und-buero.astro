    formText="Kurz die Eckdaten. Ihr bekommt einen festen Stückpreis je Teil und einen Liefertermin, von jemandem aus der Werkstatt."
    formFacts={['Ab 1 Stück, keine Mindestmenge', 'Staffelpreise ab 10 Stück', 'Größenliste, pro Person beschriftet', 'Eigene Kleidung bedrucken möglich']}
    formImage="/img/workwear-team-halle.jpg" formImageAlt="Team in Poloshirts mit Firmenlogo"
