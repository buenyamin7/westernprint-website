const services = [
  { icon: 'arrows-clockwise', t: 'Einzeln nachbestellen', d: 'Neue Kollegin, neuer Praktikant: Ihr bestellt ein einzelnes Teil nach, mit demselben Logo in derselben Position. Die Druckdaten bleiben bei uns gespeichert.' },
  { icon: 'list-checks', t: 'Größenliste statt Rätselraten', d: 'Ihr schickt eine Excel-Liste mit Name, Teil und Größe, wir packen pro Person beschriftet. Damen- und Herrenschnitte lassen sich mischen, ohne Aufpreis.' },
  { icon: 'palette', t: 'Firmenfarbe getroffen', d: 'Das Logo drucken wir nach Pantone- oder HEX-Wert. Beim Textil wählen wir aus über 500 Farben die passende, oft ist es die exakte.' },
  { icon: 'leaf', t: 'Belegbar nachhaltig', d: 'Stanley/Stella ist GOTS- und OEKO-TEX-zertifiziert und Mitglied der Fair Wear Foundation. Das passt in jeden CSR-Bericht, ohne dass ihr etwas erfinden müsst.' },
  { icon: 'file-text', t: 'Rechnung, die die Buchhaltung mag', d: 'Rechnung der westernprint GmbH mit ausgewiesener Umsatzsteuer. Für Stammkunden Zahlung auf Rechnung nach Absprache.' },
  { icon: 'chat-circle-dots', t: 'Ein Ansprechpartner', d: 'WhatsApp, Telefon oder Mail, beantwortet von Leuten aus der Werkstatt in Oberhausen. Kein Ticketsystem, keine Warteschleife.' },
