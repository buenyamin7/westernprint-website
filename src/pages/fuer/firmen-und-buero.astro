const branchen = ['Agenturen und Studios', 'Steuerberater und Kanzleien', 'Immobilien und Makler', 'IT und Software', 'Autohäuser und Kfz-Handel', 'Arztpraxen und Physiotherapie', 'Pflegedienste', 'Logistik und Spedition', 'Versicherungen und Finanzvertrieb', 'Einzelhandel und Filialen', 'Start-ups', 'Vereine mit Geschäftsstelle', 'Außendienst und Vertrieb', 'Empfang und Kundenservice'];
