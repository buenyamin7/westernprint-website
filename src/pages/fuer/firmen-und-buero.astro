const blocks = [
  { h: 'Wie groß soll das Logo sein?', p: 'Auf der Brust wirkt ein Logo zwischen 8 und 12 Zentimetern Breite ruhig und erkennbar, links auf Herzhöhe. Auf dem Rücken sind 25 bis 30 Zentimeter üblich, zum Beispiel für den Firmennamen mit Webadresse. Am Ärmel passen 5 bis 7 Zentimeter. Im Korrekturabzug stehen die Maße in Zentimetern, bevor gedruckt wird.' },
  { h: 'Ist Firmenkleidung mit Logo steuerlich absetzbar?', p: 'In der Regel ja: Kleidung mit dauerhaft angebrachtem, sichtbarem Firmenlogo gilt als typische Berufskleidung und kann als Betriebsausgabe gebucht werden, die Umsatzsteuer aus unserer Rechnung ist als Vorsteuer abziehbar. Für Mitarbeitende entsteht dadurch normalerweise kein geldwerter Vorteil. Das ist eine Orientierung, keine Steuerberatung, fragt im Zweifel euren Steuerberater.' },
  { h: 'Wie hält der Druck im Alltag?', p: 'Wir drucken Firmenkleidung per DTF: deckend, dehnbar, waschfest, auch auf Polyester, Softshell und Mischgewebe. Gewaschen wird bei 30 Grad auf links, ohne Weichspüler, ohne Trockner, dann sieht das Logo auch nach vielen Wäschen aus wie am ersten Tag. Für Teile, die in die Industriewäsche gehen, sprecht uns vorher an.', items: ['30 Grad, auf links gedreht', 'Kein Weichspüler, kein Trockner', 'Gilt für Baumwolle, Polyester und Softshell'] },
  { h: 'Größenliste: der typische Fehler', p: 'Teams bestellen zu viele M und zu wenige XL und XXL. Lasst jede Person ihre Größe selbst eintragen und bestellt für Neuzugänge nichts auf Vorrat: Einzelne Teile bestellt ihr bei uns in 1 bis 3 Werktagen nach, mit demselben Druck. Eine Vorlage für die Größenliste schicken wir euch mit dem Angebot.', items: ['Name, Abteilung, Teil, Größe, Schnitt (Damen/Herren)', 'Mischgrößen ohne Aufpreis', 'Nachbestellung einzeln statt Lager'] },
];
const faqs = [
  { q: 'Wo bekommen Firmen Teamkleidung mit Logo in kleinen Mengen?', a: `Bei westernprint in Oberhausen bekommen Firmen, Büros und Dienstleister Poloshirts, T-Shirts, Hoodies, Hemden und Softshelljacken mit Firmenlogo ab 1 Stück, ohne Mindestmenge. Ein Poloshirt mit Logo kostet bei 10 Stück 17,90 € netto (${brutto('17,90')} € brutto) pro Stück. Die Serie ist 5 bis 7 Werktage nach Freigabe fertig, einzelne Teile für neue Mitarbeitende bestellt ihr später nach. Stand ${STAND}.` },
  { q: 'Was kostet Firmenkleidung mit Logo?', a: `Ein Poloshirt (Stedman Classic Polo) mit einem Druck kostet bei westernprint 22,90 € netto (${brutto('22,90')} € brutto) als Einzelstück, 17,90 € netto (${brutto('17,90')} € brutto) bei 10 Stück und 14,50 € netto (${brutto('14,50')} € brutto) bei 50 Stück. Ein Hoodie (Stedman Classic Hoodie) kostet 24,90 € netto (${brutto('24,90')} € brutto) bei 10 Stück, ein Bio-T-Shirt (Stanley/Stella Creator 2.0) 14,90 € netto (${brutto('14,90')} € brutto) bei 10 Stück. Alle Preise pro Stück inklusive Textil und einem Druck, Stand ${STAND}. Einrichtungskosten fallen nicht an.` },
  { q: 'Gibt es eine Mindestbestellmenge für Firmenkleidung?', a: 'Nein. westernprint bedruckt Firmenkleidung ab 1 Stück. Staffelpreise gelten ab 10 Stück, ab 50 Stück wird es noch einmal günstiger. Modelle, Farben, Damen- und Herrenschnitte und Größen könnt ihr in einer Bestellung mischen, ohne Aufpreis.' },
  { q: 'Besticken oder bedrucken, was ist besser für Firmenkleidung?', a: 'Alles Gedruckte entsteht in unserer eigenen Produktion in Oberhausen per DTF: mehrfarbig, mit feinen Details und Verläufen, deckend auf dunklen Textilien, dehnbar und waschfest. Für kleine Auflagen und Nachbestellungen ab 1 Stück ist Druck der schnellere und günstigere Weg, weil keine Einrichtung anfällt. Stickerei bieten wir auf Anfrage über einen Partnerbetrieb an.' },
  { q: 'Wie lange dauert eine Bestellung für das ganze Team?', a: `Das Angebot kommt an Werktagen innerhalb von 24 Stunden. Nach Freigabe des Korrekturabzugs ist die Serie in 5 bis 7 Werktagen fertig, Einzelstücke in 1 bis 3 Werktagen. Die Ware geht per DHL mit Sendungsnummer in die Firma, oder ihr holt sie kostenlos in der Schenkendorfstraße 45 in Oberhausen ab, ${oeffnungszeiten.text}.` },
  { q: 'Können wir später einzelne Teile für neue Mitarbeitende nachbestellen?', a: 'Ja. westernprint speichert Logo, Farbe und Position. Eine neue Kollegin bekommt ihr Polo einzeln nachbestellt, mit demselben Druck wie das Team, in 1 bis 3 Werktagen. Ihr müsst nichts auf Vorrat kaufen.' },
  { q: 'Bekommen wir vorher ein Muster?', a: 'Ja. Ein Muster mit eurem Logo bestellt ihr über das Angebot oder direkt im Shop, ab 1 Stück. So seht ihr Stoff, Farbe und Druck, bevor das Team ausgestattet wird. Einzelne Muster sind etwas teurer als die Serie, weil jedes Teil einzeln eingerichtet wird.' },
  { q: 'Ist Firmenkleidung mit Logo steuerlich absetzbar?', a: 'Kleidung mit dauerhaft angebrachtem, sichtbarem Firmenlogo gilt in der Regel als Berufskleidung: Betriebsausgabe für die Firma, Vorsteuerabzug aus unserer Rechnung, normalerweise kein geldwerter Vorteil für Mitarbeitende. Das ist eine Orientierung und keine Steuerberatung, klärt es mit eurem Steuerberater.' },
  { q: 'Können wir unsere eigene Kleidung bedrucken lassen?', a: 'Ja. westernprint bedruckt angelieferte Polos, Hemden, Jacken oder Westen, ihr zahlt nur den Druck. Nennt vorher kurz das Material, wir prüfen die Eignung. Plant 2 bis 3 Prozent Reserve ein, für Materialfehler an angelieferter Ware haften wir nicht.' },
  { q: 'Welche Datei braucht ihr von unserem Logo?', a: 'Am besten eine Vektordatei (PDF, AI, SVG) oder ein PNG mit transparentem Hintergrund. Wir prüfen jede Datei kostenlos. Habt ihr nur ein Bild von der Website oder einer Visitenkarte, bauen wir das Logo sauber neu auf, den Preis dafür nennen wir im Angebot.' },
  { q: 'Können Name oder Abteilung auf das Shirt?', a: 'Ja. Jedes Teil bekommt auf Wunsch Vornamen, Funktion oder Abteilung, zum Beispiel auf der Brust oder am Ärmel. Eine Liste mit Name und Größe reicht, den Aufpreis nennen wir im Angebot.' },
  { q: 'Druckt ihr auch Hemden und Softshelljacken mit Logo?', a: `Ja. Hemden (Stanley/Stella Styler, Bio-Baumwolle) kosten mit Logo 30,90 € netto (${brutto('30,90')} € brutto) bei 10 Stück, Softshelljacken (Stedman Lux Softshell) 39,90 € netto (${brutto('39,90')} € brutto) bei 10 Stück. Das Logo sitzt auf der Brust, auf Wunsch zusätzlich auf dem Rücken oder Ärmel. Stand ${STAND}.` },
  { q: 'Kann der Nacken unser Logo statt des Herstelleretiketts zeigen?', a: 'Ja. Wir drucken euer Logo mit Größenangabe in den Nacken, den Aufpreis nennen wir im Angebot. Viele Textilien von Stanley/Stella haben ein Tearaway-Label, das wir entfernen, Build-Your-Brand-Modelle kommen ohne Etikett. Die Kleidung wirkt dann wie eine eigene Kollektion.' },
  { q: 'Bekommen wir eine Rechnung mit ausgewiesener Umsatzsteuer?', a: 'Ja. Ihr bekommt eine Rechnung der westernprint GmbH mit ausgewiesener Umsatzsteuer. Neue Kunden zahlen vorab per Überweisung, für Stammkunden ist Zahlung auf Rechnung nach Absprache möglich.' },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Firmenkleidung mit Logo bedrucken', serviceType: 'Textildruck für Firmen und Büros', description: 'Firmenkleidung mit Logo für Firmen, Büros und Dienstleister: Poloshirts, T-Shirts, Hoodies, Hemden und Softshelljacken, ab 1 Stück ohne Mindestmenge, Staffelpreise ab 10 Stück, einzeln nachbestellbar. Eigene Kleidung kann angeliefert werden.', provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: [{ '@type': 'City', name: 'Oberhausen' }, { '@type': 'AdministrativeArea', name: 'Ruhrgebiet' }, { '@type': 'AdministrativeArea', name: 'Nordrhein-Westfalen' }, { '@type': 'Country', name: 'Deutschland' }], audience: { '@type': 'BusinessAudience', audienceType: 'Firmen, Büros, Agenturen, Kanzleien, Praxen und Dienstleister' }, url: `${site.url}/fuer/firmen-und-buero`,
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Firmenkleidung mit Logo, Preis pro Stück bei 10 Stück, ein Druck', itemListElement: preise.filter((r) => /^\d/.test(r.p[1])).map((r) => ({ '@type': 'Offer', name: `${r.t} mit Firmenlogo (${r.m})`, price: r.p[1].replace(',', '.'), priceCurrency: 'EUR', eligibleQuantity: { '@type': 'QuantitativeValue', minValue: 10 }, priceSpecification: { '@type': 'UnitPriceSpecification', price: r.p[1].replace(',', '.'), priceCurrency: 'EUR', valueAddedTaxIncluded: false } })) },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: bewertungen.schnitt, reviewCount: bewertungen.anzahl } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Startseite', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Für wen wir drucken', item: `${site.url}/fuer` }, { '@type': 'ListItem', position: 3, name: 'Firmen und Büro', item: `${site.url}/fuer/firmen-und-buero` }] },
];
---
<Base title="Firmenkleidung mit Logo bedrucken lassen, ab 1 Stück" description="Firmenkleidung mit Logo für Firmen, Büros, Agenturen, Kanzleien und Praxen: Poloshirts, Hemden, Hoodies, Softshelljacken ab 1 Stück ohne Mindestmenge. Polo mit Logo ab 14,50 € netto, Größenliste, einzeln nachbestellbar, Bio-Baumwolle. Druckerei in Oberhausen, Angebot in 24 Stunden." jsonLd={ld} ogImage="/img/firmen-polos-buero.jpg">
