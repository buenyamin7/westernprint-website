];
const faqs = [
  { q: 'Wo bekommen Fitnessstudios und Kampfsportschulen Shirts mit Logo?', a: `Bei westernprint in Oberhausen: T-Shirts, Tank Tops, Funktionsshirts, Hoodies, Oversize Tees und Caps mit eurem Logo, ab 1 Stück ohne Mindestmenge, fürs Trainerteam oder zum Verkauf an Mitglieder. Ein T-Shirt mit Logo kostet bei 10 Stück 12,90 € netto (${brutto('12,90')} € brutto), ein Hoodie 24,90 € netto (${brutto('24,90')} € brutto) pro Stück, Stand ${STAND}. Die Serie ist 5 bis 7 Werktage nach Freigabe fertig, einzelne Teile in 1 bis 3 Werktagen.` },
  { q: 'Was kostet ein bedrucktes Shirt oder ein Hoodie für unser Studio?', a: `Ein T-Shirt Basic (Stedman Classic-T) mit einem Druck kostet bei westernprint 12,90 € netto (${brutto('12,90')} € brutto) bei 10 Stück und 9,40 € netto (${brutto('9,40')} € brutto) bei 50 Stück. Ein Hoodie (Stedman Classic Hoodie, 280 g) kostet 24,90 € netto (${brutto('24,90')} € brutto) bei 10 Stück und 21,40 € netto (${brutto('21,40')} € brutto) bei 50 Stück. Preise pro Stück inklusive Textil, Stand ${STAND}. Ein Tank Top (Stedman Comfort) kostet 10,13 € netto bei 25 Stück, ein Heavy Oversize Tee (Build Your Brand BY102) 13,95 € netto bei 25 Stück, Stand 18.10.2026.` },
  { q: 'Können Funktionsshirts aus Polyester bedruckt werden?', a: 'Ja. westernprint bedruckt Funktionsshirts, Trikots und Rashguards aus Polyester per DTF. Der Druck wird mit niedrigerer Temperatur aufgepresst, bleibt dehnbar und hält Schweiß und Wäsche aus. Gewaschen wird bei 30 Grad auf links, ohne Weichspüler und Trockner.' },
  { q: 'Druckt ihr auch Tank Tops und Oversize Tees?', a: 'Ja. Tank Tops von Stedman und Build Your Brand, Heavy Oversize Tees (Build Your Brand BY102, 240 g), Boxy Hoodies und Jogger. Das sind die Blanks, die im Gym getragen werden. Ein Tank Top mit Logo kostet 14,13 € netto als Einzelstück und 10,13 € netto bei 25 Stück, ein Heavy Oversize Tee 17,95 € netto einzeln und 13,95 € netto bei 25 Stück, Stand 18.10.2026.' },
  { q: 'Gibt es eine Mindestmenge?', a: 'Nein. westernprint druckt ab 1 Stück. Staffelpreise gelten ab 10 Stück, ab 50 Stück wird es noch einmal günstiger. Trainer-Shirts, Tank Tops und Hoodies könnt ihr in einer Bestellung mischen, auch Größen und Farben, ohne Aufpreis.' },
  { q: 'Können wir Merch an unsere Mitglieder verkaufen, ohne ein Lager zu haben?', a: 'Ja, auf zwei Wegen. Entweder bestellt ihr eine kleine Auflage zum Staffelpreis, verkauft an der Theke und bestellt verkaufte Größen einzeln nach. Oder ihr verkauft online über einen Shopify-Shop mit der kostenlosen westernprint-App: Jede Bestellung drucken wir einzeln und versenden sie neutral in eurem Namen an das Mitglied. Kein Lager, keine Grundgebühr, keine Mindestmenge.' },
  { q: 'Macht ihr Shirts für Kampfabende und Turniere?', a: 'Ja. Event-Shirts mit Datum und Kampfpaarung, Team-Hoodies für die Ecke, Helfer-Shirts: westernprint druckt auch 20 Teile mit mehreren Motiven. Nennt uns den Termin, im Angebot steht ein Liefertermin davor. Serien brauchen 5 bis 7 Werktage nach Freigabe, Express auf Anfrage.' },
  { q: 'Können Trainernamen oder der Gürtelgrad auf das Shirt?', a: 'Ja. „Coach“, „Personal Trainer“, Vorname oder Graduierung drucken wir einzeln je Teil, auf dem Rücken, der Brust oder am Ärmel. Eine Liste mit Name und Größe reicht, den Aufpreis nennen wir im Angebot.' },
  { q: 'Wie groß darf das Rückenmotiv sein?', a: 'Im DTG-Druck bis 40 x 50 Zentimeter, im DTF-Druck bis 30 x 40 Zentimeter pro Position. Den Aufpreis für einen größeren Rückendruck nennen wir im Angebot. Im Korrekturabzug stehen alle Maße in Zentimetern, gedruckt wird erst nach eurer Freigabe.' },
  { q: 'Bedruckt ihr Shirts oder Rashguards, die wir schon haben?', a: 'Ja. westernprint bedruckt angelieferte Textilien per DTF, auch Rashguards und Trikots aus Polyester, ihr zahlt nur den Druck. Vorher prüfen wir das Material. Für Materialfehler an angelieferter Ware haften wir nicht, plant 2 bis 3 Prozent Reserve ein.' },
  { q: 'Macht ihr sublimierte All-over-Shirts?', a: 'Nein. Sublimierte All-over-Trikots bietet westernprint nicht an. Logo, Schriftzug und Motiv auf Funktionsshirts, Tank Tops und Hoodies drucken wir per DTF, auch auf Polyester. Das deckt Trainerteam, Mitglieder-Merch und Kampfabend ab.' },
  { q: 'Wie schnell kommt Nachschub, wenn eine Größe ausverkauft ist?', a: 'Einzelne Teile druckt westernprint in 1 bis 3 Werktagen nach, mit demselben Druck. Mit Versand sind sie in der Regel 3 bis 5 Werktage nach der Bestellung im Studio, oder ihr holt sie in Oberhausen ab. Die Druckdaten bleiben gespeichert.' },
  { q: 'Wie sollen Mitglieder die Shirts waschen?', a: 'Bei 30 Grad, auf links gedreht, ohne Weichspüler und nicht in den Trockner. Das gilt für Baumwolle und Funktionsware. Den Hinweis könnt ihr beim Verkauf an der Theke mitgeben, wir legen auf Wunsch eine Pflegekarte bei.' },
  { q: 'Können wir die Teile in Oberhausen abholen?', a: `Ja, kostenlos in der Schenkendorfstraße 45 in Oberhausen, ${oeffnungszeiten.text}, nach kurzer Absprache. Alternativ schickt westernprint die Bestellung per DHL mit Sendungsnummer ins Studio, deutschlandweit.` },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Gym- und Kampfsport-Kleidung mit Logo bedrucken', serviceType: 'Textildruck für Fitnessstudios und Kampfsportschulen', description: 'Trainer-Shirts, Tank Tops, Funktionsshirts, Hoodies, Heavy Oversize Tees und Caps mit Logo für Fitnessstudios, Crossfit-Boxen, Boxclubs, MMA- und Kampfsportschulen, Yoga-Studios und Personal Trainer, ab 1 Stück ohne Mindestmenge, Staffelpreise ab 10 Stück, Mitglieder-Merch auch per Print-on-Demand ohne Lager.', provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: [{ '@type': 'City', name: 'Oberhausen' }, { '@type': 'AdministrativeArea', name: 'Ruhrgebiet' }, { '@type': 'AdministrativeArea', name: 'Nordrhein-Westfalen' }, { '@type': 'Country', name: 'Deutschland' }], audience: { '@type': 'BusinessAudience', audienceType: 'Fitnessstudios, Crossfit-Boxen, Kampfsportschulen, Yoga-Studios, Personal Trainer' }, url: `${site.url}/fuer/fitness-und-kampfsport`,
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Gym-Kleidung mit Logo, Preis pro Stück bei 10 Stück, ein Druck', itemListElement: preise.filter((r) => /^\d/.test(r.p[1])).map((r) => ({ '@type': 'Offer', name: `${r.t} mit Studio-Logo (${r.m})`, price: r.p[1].replace(',', '.'), priceCurrency: 'EUR', eligibleQuantity: { '@type': 'QuantitativeValue', minValue: 10 }, priceSpecification: { '@type': 'UnitPriceSpecification', price: r.p[1].replace(',', '.'), priceCurrency: 'EUR', valueAddedTaxIncluded: false } })) },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Startseite', item: site.url }, { '@type': 'ListItem', position: 2, name: 'Für wen wir drucken', item: `${site.url}/fuer` }, { '@type': 'ListItem', position: 3, name: 'Fitness und Kampfsport', item: `${site.url}/fuer/fitness-und-kampfsport` }] },
];
