---
import Base from '../layouts/Base.astro';
import Tiles from '../components/Tiles.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
const svcLd = { '@context': 'https://schema.org', '@type': 'Service', name: 'DTF-, DTG- und Sublimationsdruck', serviceType: 'Textildruck', provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: 'DE', url: 'https://westernprint.de/druckverfahren' };
---
<Base title="Druckverfahren: DTF, DTG und Sublimation" description="Welches Druckverfahren für welches Textil: DTF, DTG und Sublimation im Vergleich. Haltbarkeit, Farben, Stückzahlen. Alles auf Epson-Maschinen in Oberhausen." jsonLd={svcLd}>
  <PageHero
    eyebrow="Druckverfahren"
    title="DTF, DTG oder Sublimation? <span class='hl'>Wir wählen das passende Verfahren.</span>"
    lede="Höchste Qualität trifft auf moderne Technik. Bei uns läuft alles über Epson-Maschinen mit Fokus auf DTF und DTG, für Tassen und Accessoires auf Sublimation."
    image="/img/druck-makro.jpg"
    imageAlt="Detailaufnahme eines DTF-Drucks, jede Linie gestochen scharf"
  />

  <section class="section methods-section">
    <div class="container">
    </div>
    <Tiles items={[
      { img: '/img/druck-outside.jpg', pos: 'center 40%', tag: 'Standard für Auflagen und Einzelstücke', t: 'DTF (Direct to Film)', d: 'Motiv auf Folie gedruckt, mit Kleberpulver aufs Textil gepresst. Deckend auf hellen und dunklen Stoffen, dehnbar, waschfest bis 60 °C. Für komplexe Motive, Farbverläufe und alle Materialien von Baumwolle bis Polyester.', big: true },
      { img: '/img/druck-makro.jpg', tag: 'Fotorealistische Einzelstücke', t: 'DTG (Direct to Garment)', d: 'Direkt ins Gewebe gedruckt. Weicher Griff, feinste Details, ideal für Fotos und viele Farben auf Baumwolle.' },
      { img: '/img/tasse-sublimation.jpg', pos: 'center 55%', tag: 'Tassen, Taschen, Accessoires', t: 'Sublimation', d: 'Farbe wird per Hitze in die Beschichtung eingedampft. Satte Farben, spülmaschinenfest, praktisch unzerstörbar.' },
    ]} rows="clamp(260px, 26vw, 380px)" />
  </section>

  <section class="section-tight table-section">
    <div class="container">
      <div class="section-head reveal"><h2>Welches Verfahren wofür?</h2></div>
      <div class="table-wrap reveal">
        <table>
          <thead><tr><th>Anforderung</th><th>DTF</th><th>DTG</th><th>Sublimation</th></tr></thead>
          <tbody>
            <tr><td>Dunkle Textilien</td><td><span class="chip chip-good">Sehr gut</span></td><td><span class="chip chip-ok">Gut, mit Vorbehandlung</span></td><td><span class="chip chip-bad">Nicht möglich</span></td></tr>
            <tr><td>Fotorealistische Motive</td><td><span class="chip chip-ok">Gut</span></td><td><span class="chip chip-good">Sehr gut</span></td><td><span class="chip chip-good">Sehr gut</span></td></tr>
            <tr><td>Polyester und Mischgewebe</td><td><span class="chip chip-good">Sehr gut</span></td><td><span class="chip chip-bad">Ungeeignet</span></td><td><span class="chip chip-good">Sehr gut (hell)</span></td></tr>
            <tr><td>Waschbeständigkeit</td><td><span class="chip chip-good">Sehr hoch</span></td><td><span class="chip chip-ok">Hoch</span></td><td><span class="chip chip-good">Sehr hoch</span></td></tr>
            <tr><td>Griff auf dem Stoff</td><td><span class="chip chip-ok">Leicht spürbar</span></td><td><span class="chip chip-good">Kaum spürbar</span></td><td><span class="chip chip-good">Nicht spürbar</span></td></tr>
            <tr><td>Stückzahl</td><td><span class="chip chip-good">1 bis 1.000+</span></td><td><span class="chip chip-ok">1 bis 100</span></td><td><span class="chip chip-ok">1 bis 500</span></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container brand-grid">
      <div class="reveal">
        <span class="eyebrow">Textilpartner</span>
        <h2>Warum wir auf Stanley/Stella setzen</h2>
        <p class="muted">Stanley/Stella ist europäischer Marktführer für Premium-Basics aus Bio-Baumwolle. Die Lieferkette ist vom Saatgut bis zum fertigen Shirt rückverfolgbar. Für uns der beste Untergrund für DTF und DTG: brillante Farben, bis zu 15 Prozent weniger Tinte.</p>
        <ul class="certs">
          <li><Icon name="seal-check" size={18} /> GOTS (Global Organic Textile Standard)</li>
          <li><Icon name="seal-check" size={18} /> GRS (Global Recycled Standard)</li>
          <li><Icon name="seal-check" size={18} /> OEKO-TEX Standard 100</li>
          <li><Icon name="seal-check" size={18} /> PETA-Approved Vegan</li>
          <li><Icon name="seal-check" size={18} /> Fair Wear Foundation, Leader-Status</li>
        </ul>
        <a href="/textilien" class="btn btn-secondary">Textilien ansehen</a>
      </div>
      <div class="brand-imgs reveal reveal-d1">
        <img src="/img/prod-crafter.jpg" alt="Stanley/Stella Crafter T-Shirt" width="720" height="900" loading="lazy" />
        <img src="/img/prod-chaser.jpg" alt="Stanley/Stella Chaser Oversized Hoodie" width="720" height="900" loading="lazy" />
      </div>
    </div>
  </section>

  <CtaBand title="Unsicher, welches Verfahren passt?" text="Schick uns dein Motiv und das Wunschtextil. Wir sagen dir, was am besten hält und am besten aussieht." />
</Base>

<style>
  .methods { display: grid; gap: 20px; }
  .method { display: grid; grid-template-columns: 1fr 1.4fr; gap: 28px; padding: 32px; border-radius: var(--radius-card); border: 1px solid var(--line); background: var(--surface); align-items: start; }
  .method-head { display: flex; gap: 16px; align-items: flex-start; }
  .method-head h2 { font-size: 1.4rem; }
  .method-head .muted { font-size: 14px; display: block; margin-top: 4px; }
  .method p { color: var(--text-2); }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
  .table-section { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 20px; background: linear-gradient(180deg, var(--surface-2), var(--surface)); box-shadow: 0 0 60px -30px color-mix(in srgb, var(--accent) 50%, transparent); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 640px; }
  th, td { text-align: left; padding: 16px 20px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  th { font-family: 'Bricolage Grotesque Variable', sans-serif; font-size: 16px; color: var(--accent); font-weight: 700; background: color-mix(in srgb, var(--accent) 6%, transparent); }
  th:first-child { color: var(--text-3); font-family: inherit; font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; }
  tbody tr { transition: background 0.25s var(--ease); } tbody tr:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
  tbody tr:last-child td { border-bottom: 0; }
  td:first-child { font-weight: 600; color: var(--text); }
  td { color: var(--text-2); }
  .brand-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .brand-grid .muted { margin-top: 14px; max-width: 58ch; font-size: 1.05rem; }
  .certs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 26px 0 30px; font-size: 14.5px; }
  .certs li { display: flex; gap: 10px; align-items: center; padding: 10px 14px; border-radius: 12px; background: linear-gradient(180deg, var(--surface-2), var(--surface)); border: 1px solid var(--line); }
  .certs .icon { color: var(--accent); flex: none; }
  .brand-imgs { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 24px 0 40px; }
  .brand-imgs::before { content: ''; position: absolute; inset: 10% 0; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%); filter: blur(30px); pointer-events: none; }
  .brand-imgs img { position: relative; border-radius: 20px; border: 1px solid var(--line); transition: transform 0.6s var(--ease); box-shadow: 0 30px 60px -30px rgba(0,0,0,0.8); }
  .brand-imgs img:first-child { transform: rotate(-4deg) translateY(10px); }
  .brand-imgs img:last-child { transform: rotate(3deg) translateY(50px); }
  .brand-imgs:hover img { transform: rotate(0) translateY(20px); }
  @media (max-width: 600px) { .certs { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .method, .brand-grid { grid-template-columns: 1fr; } }
</style>
