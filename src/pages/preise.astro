---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { podPrices, shipping } from '../data/site';
const featured = podPrices.slice(0, 4);
const rest = podPrices.slice(4);
---
<Base title="Print-on-Demand Preise 2026, transparent je Stück" description="Alle POD-Preise auf einen Blick: T-Shirt ab 10,47 €, Hoodie ab 21,45 € inklusive Druck. Keine Einrichtungsgebühr, keine Mindestmenge, Versand ab 5 €.">
  <PageHero
    eyebrow="Preise"
    title="Feste Preise pro Stück. <span class='hl'>Inklusive Druck.</span>"
    lede="Du verkaufst, wir produzieren on-demand, verpacken neutral und versenden direkt an deine Kunden. Alle Preise zzgl. MwSt. für einseitigen Frontdruck."
    cta={{ label: 'Angebot anfragen', href: '/kontakt' }}
  />

  <section class="section-tight">
    <div class="container">
      <div class="grid grid-4">
        {[
          { icon: 'cube', t: 'Ab 1 Stück', d: 'Kein Mindestabnahmezwang' },
          { icon: 'package', t: 'Neutraler Versand', d: 'Direkt an deinen Endkunden' },
          { icon: 'clock', t: '1 bis 3 Werktage', d: 'Regelmäßige Laufzeit, auch im Q4' },
          { icon: 'seal-check', t: 'Stanley/Stella', d: 'Premium-Basics, feste Artikel' },
        ].map((b, i) => (
          <div class={`mini reveal reveal-d${i}`}>
            <div class="icon-box"><Icon name={b.icon} size={20} /></div>
            <div><strong>{b.t}</strong><span>{b.d}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head reveal">
        <h2>Die beliebtesten Produkte</h2>
        <p>Preis pro Stück inklusive einseitigem Druck. Rückseitendruck plus 7 €.</p>
      </div>
      <div class="grid grid-4">
        {featured.map((p, i) => (
          <div class={`price-card reveal reveal-d${i}`}>
            <span class="tag">{p.type}</span>
            <h3>{p.name}</h3>
            <span class="sku">{p.sku}</span>
            <strong>{p.price}</strong>
            <span class="muted">pro Stück, einseitig</span>
          </div>
        ))}
      </div>
      <div class="table-wrap reveal">
        <table>
          <thead><tr><th>Produkt</th><th>Art</th><th>Artikel</th><th class="num">Preis</th></tr></thead>
          <tbody>
            {rest.map((p) => (
              <tr><td>{p.name}</td><td>{p.type}</td><td class="sku">{p.sku}</td><td class="num">{p.price}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted note">Rückseite plus 7 €. Ärmeldruck, Innenlabel, Nackenprint und Hangtags auf Anfrage. Modellbezeichnungen nach Stanley/Stella.</p>
    </div>
  </section>

  <section class="section-tight ship-section">
    <div class="container ship-grid">
      <div class="reveal">
        <h2>Versandkosten</h2>
        <p class="muted">Pro Sendung, versichert, mit Tracking zurück in deinen Shop.</p>
      </div>
      <ul class="ship reveal reveal-d1">
        {shipping.map((s) => (
          <li><span>{s.region}</span><strong>{s.price}</strong></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Größere Mengen oder ein Produkt, das fehlt?" text="Ab 50 Stück gibt es Staffelpreise. Und wenn du ein bestimmtes Textil brauchst, das hier nicht steht, fragen wir es für dich an." />
</Base>

<style>
  .mini { display: flex; gap: 14px; align-items: center; padding: 18px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  .mini div:last-child { display: flex; flex-direction: column; font-size: 14px; }
  .mini span { color: var(--text-2); }
  .price-card { display: grid; gap: 6px; padding: 24px; border-radius: var(--radius-card); border: 1px solid var(--line); background: var(--surface); }
  .price-card .tag { justify-self: start; margin-bottom: 8px; }
  .price-card .sku { font-size: 13px; color: var(--text-3); }
  .price-card strong { font-size: 2rem; letter-spacing: -0.03em; color: var(--accent); margin-top: 10px; line-height: 1; font-variant-numeric: tabular-nums; }
  .price-card .muted { font-size: 13px; }
  .table-wrap { margin-top: 20px; overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 520px; }
  th, td { text-align: left; padding: 13px 18px; border-bottom: 1px solid var(--line); }
  th { font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); font-weight: 600; }
  tbody tr:last-child td { border-bottom: 0; }
  td { color: var(--text-2); }
  td:first-child { color: var(--text); font-weight: 500; }
  .sku { font-size: 13px; color: var(--text-3); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  td.num { color: var(--text); font-weight: 600; }
  .note { margin-top: 16px; font-size: 14px; max-width: 70ch; }
  .ship-section { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ship-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .ship-grid .muted { margin-top: 10px; }
  .ship { display: grid; gap: 10px; }
  .ship li { display: flex; justify-content: space-between; padding: 14px 18px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
  .ship strong { font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) { .ship-grid { grid-template-columns: 1fr; } }
</style>
