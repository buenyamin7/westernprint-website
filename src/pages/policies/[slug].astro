---
import Redirect from '../../components/Redirect.astro';
export function getStaticPaths() {
  const map: Record<string, string> = { 'privacy-policy': '/datenschutz', 'terms-of-service': '/agb', 'refund-policy': '/widerruf', 'shipping-policy': '/versand', 'legal-notice': '/impressum' };
  return Object.entries(map).map(([slug, to]) => ({ params: { slug }, props: { to } }));
}
const { to } = Astro.props;
---
<Redirect to={to} />
