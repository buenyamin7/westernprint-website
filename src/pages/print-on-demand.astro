---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { site, oeffnungszeiten } from '../data/site';
import { bewertungen } from '../data/bewertungen';

// Quelle für alle Fakten auf dieser Seite: der Code der POD-App (~/dev/westernprint-pod, Stand 17.10.2026) und die
// Freigaben des Inhabers vom 17.10.2026. Produkt- und Branding-Preise bleiben bewusst draußen: Sie stehen nur in der App.
// Versandpauschalen und die Staffel stammen aus lib/pricing/index.ts der App und müssen bei Änderungen dort mitgezogen werden.
const schnitt = bewertungen.schnitt.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const appUrl = 'https://apps.shopify.com/pod-westerprint';

// Versandkosten stehen bewusst nicht auf der Seite (Inhaber 18.10.2026), nur in der App. Hier nur Zielländer und Lieferzeit.
const versand = [
  { land: 'Deutschland' },
  { land: 'Österreich' },
  { land: 'Übrige EU-Länder' },
  { land: 'Schweiz', hinweis: 'Zollpapiere (CN23) erstellen wir, Einfuhrabgaben trägt der Empfänger' },
];

// Onboarding-Schritte wie im Portal (app/portal/start). Zeiten sind die Richtwerte aus dem Portal.
const schritte = [
  { t: 'App installieren', zeit: 'ca. 2 Minuten', d: 'Kostenlos aus dem Shopify App Store. Keine Grundgebühr, kein Abo, kein Mindestumsatz. Dein Shop ist danach mit unserer Produktion in Oberhausen verbunden.' },
  { t: 'Textil wählen, Design hochladen', zeit: 'ca. 3 Minuten', d: 'Du suchst ein Textil von Stanley/Stella, Stedman oder Build Your Brand aus, lädst dein Motiv hoch und platzierst es im Live-Mockup. Produktionspreis und Margenvorschlag siehst du sofort. Das Produkt landet mit fertigen Mockups in deinem Shop.' },
  { t: 'Bestehende Produkte zuordnen', zeit: 'ca. 1 Minute pro Produkt', d: 'Optional: Produkte, die schon in deinem Shop stehen, verknüpfst du mit einem Textil bei uns. Die Varianten erkennt die App über Farbe und Größe, du musst nichts neu anlegen.' },
  { t: 'SEPA-Mandat erteilen', zeit: 'ca. 2 Minuten', d: 'Pflicht vor dem ersten Druck. Du zahlst die wöchentliche Sammelrechnung per Lastschrift, kein Guthaben, das du vorher aufladen musst.' },
  { t: 'Verkaufen, wir liefern', zeit: 'läuft automatisch', d: 'Sobald jemand in deinem Shop bezahlt, kommt die Bestellung zu uns. Wir drucken, prüfen, verpacken und versenden per DHL. Die Sendungsnummer geht automatisch zurück an Shopify, dein Kunde wird benachrichtigt.' },
];

// Funktionen der App, die im Code vorhanden sind (components/product/ProductDesigner.tsx, app/portal/*, lib/fulfillment/*).
const funktionen = [
  { icon: 't-shirt', t: 'Live-Mockup-Designer', d: 'Vorne, hinten und Nacken, feste Druckzonen je Textil, Breite in Zentimetern. Hell/Dunkel-Variante des Motivs je Textilfarbe. Die App warnt bei zu kleiner Auflösung oder weißem Hintergrund.' },
  { icon: 'calculator', t: 'Preis und Marge vor dem Veröffentlichen', d: 'Du siehst den Produktionspreis jedes Produkts in der App, bevor es online geht, und bekommst einen Verkaufspreis-Vorschlag. Die Warenkosten werden in Shopify hinterlegt.' },
  { icon: 'magic-wand', t: 'Produktbeschreibung per KI', d: 'Titel und Beschreibung lässt du dir auf Knopfdruck erstellen und passt sie an. Mockups wählst du aus, der Rest wird automatisch angelegt.' },
  { icon: 'plugs-connected', t: 'Bestehende Shopify-Produkte zuordnen', d: 'Produkte, die schon in deinem Shop verkaufen, laufen ohne Neuanlage über uns. Auch mehrere Shops kannst du in einem Account verbinden.' },
  { icon: 'user-focus', t: 'Personalisierbare Produkte', d: 'Produkte mit Namen oder Wunschtext, zum Beispiel über Teeinblue, laufen mit. Die fertige Datei kannst du vor dem Druck im Portal freigeben.' },
  { icon: 'package', t: 'Muster zum Produktionspreis', d: 'Muster und Eigenbedarf bestellst du direkt im Portal zum Produktionspreis, ohne Umweg über deinen Shop. Abgerechnet wird über die Sammelrechnung.' },
  { icon: 'list-checks', t: 'Jeder Auftrag mit Status', d: 'Neu, Druckbereit, Im Druck, Gepresst, Verpackt, Versendet: Du siehst im Portal, wo jede Bestellung steht. Fehlt eine Datei, bekommst du Bescheid.' },
  { icon: 'truck', t: 'DHL-Tracking automatisch', d: 'Die Sendungsnummer geht als Fulfillment an Shopify, dein Kunde bekommt die Versandbestätigung aus deinem Shop. Du musst nichts eintragen.' },
  { icon: 'camera', t: 'Reklamation im Portal', d: 'Stimmt etwas nicht, meldest du es im Portal mit Fotos. Druckfehler, die bei uns passieren, drucken wir kostenlos nach.' },
];

// Textilmarken und ihre Nachweise. Nur was die Hersteller selbst veröffentlichen (stedman.eu/nachhaltigkeit, Stanley/Stella,
// Build Your Brand über Fachhändler-Datenblätter). Welches Zertifikat ein Artikel trägt, steht am Produkt in der App.
const marken = [
  { t: 'Stanley/Stella', tag: 'Bio-Baumwolle, Premium', d: 'Über 150 Styles: Creator 2.0, Rocker, Crafter, Cruiser 2.0, Drummer 2.0, Sweatshirts, Zipper, Bodys, Taschen. Dichte Farbpaletten, weicher Griff, Passformen, die Marken tragen.', certs: ['GOTS (Bio-Baumwolle)', 'OEKO-TEX Standard 100', 'PETA-Approved Vegan', 'Fair Wear Foundation, Leader-Status'] },
  { t: 'Stedman', tag: 'Preisstark bis 5XL', d: 'Elf Klassiker für kalkulierbare Produkte: Classic-T, Comfort-T, Lux-T, Tank Tops, Classic Polo, Classic Hoodie, Fleece Jacket, Sweatpants und das Seamless Sports-T. Große Größen bis 5XL.', certs: ['OEKO-TEX Standard 100', 'amfori BSCI', 'PETA-Approved Vegan', 'Recyceltes Polyester, Organic Line mit Bio-Baumwolle'] },
  { t: 'Build Your Brand', tag: 'Streetwear, Heavy Oversize', d: 'Ausgewählte Modelle für Brands: Ultra Heavy Box Hoody, Fluffy Hoody, Vintage Heavy Hoodie und Tee, Loose Fit Tees, Oversized Polo, Wideleg Sweatpants. Schwerer Stoff, tiefe Schulter, viele Modelle ohne Nackenlabel.', certs: ['OEKO-TEX Standard 100', '100 % Baumwolle bei den Heavy-Modellen'] },
];

// Druckzonen mit maximaler Motivbreite am Beispiel Herren-T-Shirt (lib/catalog/stedmanAreas.ts). Je Textil kalibriert, der Designer zeigt die exakten Werte.
const zonen = [
  ['Brust mittig', '30 cm'],
  ['Brust links oder rechts', '12 cm'],
  ['Front groß', '35 cm'],
  ['Rücken groß', '32 cm'],
  ['Rücken ganz groß', '38 cm'],
  ['Nacken (Innenlabel-Ersatz)', '10 cm'],
];

// Ehrlicher Vergleich. Spalten 2 und 3 beschreiben, was auf den Seiten der großen Anbieter steht (Recherche 17.10.2026),
// bewusst ohne Namen und mit „häufig“, wo es nicht für alle gilt.
const vergleich = [
  { k: 'Wo wird gedruckt?', wp: 'In unserer eigenen Werkstatt in Oberhausen, auf eigenen Maschinen', pl: 'In eigenen Werken, Standort meist nicht genannt', mp: 'Bei wechselnden Partnerdruckereien, Qualität je Partner' },
  { k: 'Ansprechpartner', wp: 'Eine feste Person, per WhatsApp, Telefon und E-Mail', pl: 'Ticket, Chat oder Formular', mp: 'Ticket oder Chat' },
  { k: 'Bezahlung', wp: 'Wöchentliche Sammelrechnung, SEPA-Lastschrift, 14 Tage Zahlungsziel', pl: 'Häufig Prepaid-Guthaben, das du vorher auflädst', mp: 'Kreditkarte je Bestellung, Rabatte oft nur im Abo' },
  { k: 'Versandkosten', wp: 'Feste Pauschale pro Bestellung je Zielland, in der App einsehbar', pl: 'Meist nur im Hilfe-Center', mp: 'Je Partner und Land unterschiedlich' },
  { k: 'Textilien', wp: 'Stanley/Stella, Stedman, Build Your Brand, mit Zertifikaten am Produkt', pl: 'Großer Katalog, Herkunft je Artikel', mp: 'Sehr großer Katalog, je Partner anders' },
  { k: 'Branding', wp: 'Nackenprint, Ärmeldruck, dein eigenes Verpackungsmaterial, ab 1 Stück', pl: 'Häufig nur für bestimmte Linien oder mit Mindestmengen', mp: 'Je Partner, oft gar nicht' },
  { k: 'Lieferzeit DE', wp: 'Produktion 1 bis 3 Werktage, beim Kunden in 3 bis 5 Werktagen', pl: '2 bis 5 Werktage Produktion plus Versand', mp: 'Abhängig vom gewählten Partner' },
];

const faqs = [
  { q: 'Was ist Print-on-Demand?', a: 'Print-on-Demand heißt: Ein Produkt wird erst gedruckt, wenn ein Kunde es in deinem Shop gekauft und bezahlt hat. Du brauchst kein Lager und keine Vorkasse für Ware. Du legst Design und Verkaufspreis fest, wir drucken, verpacken und versenden jede Bestellung einzeln direkt an deinen Kunden.' },
  { q: 'Wie funktioniert Print-on-Demand mit westernprint?', a: 'Du installierst die kostenlose Shopify-App „westernprint POD“, wählst ein Textil, lädst dein Design hoch und platzierst es im Live-Mockup. Das Produkt landet automatisch in deinem Shop. Sobald eine Bestellung bezahlt ist, kommt sie zu uns nach Oberhausen. Wir drucken per DTF oder DTG, prüfen jedes Teil, verpacken neutral und versenden per DHL. Die Sendungsnummer geht automatisch zurück an Shopify.' },
  { q: 'Was kostet die App und was zahle ich pro Bestellung?', a: 'Die App ist kostenlos, es gibt keine Grundgebühr, kein Abo und keinen Mindestumsatz. Du zahlst nur Produktion und Versand der Artikel, die tatsächlich bestellt wurden. Den Produktionspreis jedes Produkts siehst du in der App, bevor du es veröffentlichst.' },
  { q: 'Gibt es eine Mindestbestellmenge?', a: 'Nein. Wir drucken ab 1 Stück. Jede Bestellung aus deinem Shop wird einzeln produziert, auch wenn sie nur aus einem T-Shirt besteht.' },
  { q: 'Wie lange dauern Produktion und Lieferung?', a: 'Die Produktion dauert 1 bis 3 Werktage, auch in der Black Week und im Weihnachtsgeschäft. Bei deinen Kunden kommt die Bestellung in der Regel 3 bis 5 Werktage nach der Bestellung an, in Deutschland genauso wie in Österreich, der Schweiz und den übrigen EU-Ländern.' },
  { q: 'In welche Länder versendet ihr und was kostet der Versand?', a: 'Wir liefern nach Deutschland, Österreich, in die Schweiz und in alle übrigen EU-Länder, per DHL mit Tracking. Der Versand ist eine feste Pauschale pro Bestellung je Zielland, du siehst sie in der App. Für die Schweiz erstellen wir die Zollpapiere, Einfuhrabgaben trägt der Empfänger. Länder außerhalb der EU beliefern wir nicht.' },
  { q: 'Welche Textilien kann ich anbieten?', a: 'Stanley/Stella mit über 150 Styles aus Bio-Baumwolle, elf Stedman-Klassiker bis 5XL und ausgewählte Modelle von Build Your Brand für Streetwear, zum Beispiel Ultra Heavy Box Hoody, Fluffy Hoody und Vintage Heavy Tee. Welche Zertifikate ein Artikel trägt, siehst du am Produkt in der App.' },
  { q: 'DTF oder DTG: Welches Druckverfahren bekomme ich?', a: 'Standard ist DTF: deckende, kräftige Farben auf hellen und dunklen Textilien, auch auf Mischgewebe und Polyester. Auf Wunsch drucken wir per DTG, also direkt in den Stoff, für einen besonders weichen Griff auf heller Baumwolle. Du wählst das Verfahren im Designer.' },
  { q: 'Welche Dateien brauche ich?', a: 'Am besten ein PNG mit transparentem Hintergrund in 300 dpi. Die App nimmt auch JPG, WEBP, SVG, PDF, AI und EPS bis 50 MB. Ist die Auflösung zu niedrig oder der Hintergrund weiß, warnt dich der Designer vor dem Veröffentlichen.' },
  { q: 'Kann ich bestehende Shopify-Produkte verknüpfen?', a: 'Ja. Im Portal ordnest du Produkte, die schon in deinem Shop stehen, einem Textil bei uns zu. Die Varianten erkennt die App über Farbe und Größe. Nichts muss neu angelegt werden, deine Bewertungen und Rankings bleiben.' },
  { q: 'Kann ich mehrere Shops verbinden?', a: 'Ja. Mehrere Shopify-Shops laufen in einem Account mit einer Abrechnung.' },
  { q: 'Sieht mein Kunde, dass westernprint gedruckt hat?', a: 'Nein. Der Versand ist neutral: kein westernprint-Logo, keine Rechnung von uns im Paket. Als Absender steht standardmäßig unsere Versandhalle auf dem Label. Hast du eine Adresse in Deutschland, kannst du sie in den Einstellungen als Absender wählen.' },
  { q: 'Welches Branding ist möglich?', a: 'Nackenprint mit deinem Logo anstelle des Herstelleretiketts, Ärmeldruck und dein eigenes gebrandetes Verpackungsmaterial, das du uns anlieferst. Alles ab 1 Stück, ohne Vorproduktion. Die Preise für Nacken- und Ärmeldruck siehst du im Designer.' },
  { q: 'Wie läuft die Abrechnung?', a: 'Einmal pro Woche bekommst du eine Sammelrechnung über alle produzierten Artikel von Montag bis Sonntag, mit 14 Tagen Zahlungsziel. Bezahlt wird per SEPA-Lastschrift. Das Mandat erteilst du in der App, es ist Pflicht vor dem ersten Druck. Guthaben musst du nicht aufladen.' },
  { q: 'Kann ich eine Bestellung stornieren?', a: 'Bis zum Druckstart ja, schreib uns kurz per WhatsApp oder E-Mail. Sobald ein Auftrag im Druck ist, ist eine Stornierung nicht mehr möglich. Eine Stornierung in Shopify allein genügt nicht, weil die Produktion bei uns schon laufen kann.' },
  { q: 'Was passiert bei einer Reklamation?', a: 'Du meldest sie im Portal mit Fotos, innerhalb von 7 Tagen nach Zustellung. Druckfehler, die bei uns passieren, drucken wir kostenlos nach. Vor dem Verpacken prüfen wir jedes Teil, deshalb kommt das selten vor.' },
  { q: 'Muss ich mich beim Verpackungsregister LUCID anmelden?', a: 'westernprint ist im Verpackungsregister LUCID registriert. Ob dein Shop zusätzlich registriert sein muss, hängt von deinem Fall ab, zum Beispiel davon, ob du auch selbst Ware versendest. Das klärst du am besten mit deinem Steuerberater. Wenn du dazu Fragen hast, sprich uns an.' },
];

const appLd = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'westernprint POD', applicationCategory: 'BusinessApplication', operatingSystem: 'Shopify', url: appUrl, applicationSubCategory: 'Print-on-Demand', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', description: 'Kostenlose Installation, keine App-Gebühr. Pro Bestellung fallen Produktion und Versand an.' }, publisher: { '@id': 'https://westernprint.de/#organization' }, description: 'Print-on-Demand und Fulfillment aus Deutschland: Textil wählen, Design per Live-Mockup platzieren, Produkte landen automatisch im Shopify-Shop. Bestellungen drucken und versenden wir per DHL, das Tracking geht zurück an Shopify.' };
const svcLd = { '@context': 'https://schema.org', '@type': 'Service', name: 'Print-on-Demand Fulfillment für Shopify-Shops', serviceType: 'Print-on-Demand Fulfillment', provider: { '@id': 'https://westernprint.de/#organization' }, areaServed: [{ '@type': 'Country', name: 'Deutschland' }, { '@type': 'Country', name: 'Österreich' }, { '@type': 'Country', name: 'Schweiz' }, { '@type': 'Place', name: 'Europäische Union' }], url: 'https://westernprint.de/print-on-demand', offers: { '@type': 'Offer', description: 'Keine Grundgebühr, keine Mindestmenge, Produktionspreis und Versandpauschale je Zielland in der App einsehbar' } };
const howToLd = { '@context': 'https://schema.org', '@type': 'HowTo', name: 'Print-on-Demand mit westernprint für einen Shopify-Shop einrichten', totalTime: 'PT10M', step: schritte.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })) };
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Print-on-Demand aus Deutschland für Shopify: Druck und Versand ab 1 Stück" description="Print-on-Demand-Anbieter mit eigener Produktion in Oberhausen: kostenlose Shopify-App, DTF und DTG, Stanley/Stella, Stedman und Build Your Brand, Produktion in 1 bis 3 Werktagen, DHL-Versand neutral in deinem Namen nach DE, AT, CH und EU, wöchentliche Sammelrechnung per SEPA." jsonLd={[svcLd, appLd, howToLd, faqLd]}>
  <PageHero
    eyebrow="Print-on-Demand für Shopify"
    title="Print-on-Demand aus Deutschland für deinen Shopify-Shop. <span class='hl'>Ab 1 Stück.</span>"
    lede="Du verkaufst, wir drucken jede bezahlte Bestellung in unserer Werkstatt in Oberhausen und versenden sie per DHL neutral in deinem Namen. Kostenlose Shopify-App, keine Grundgebühr, keine Mindestmenge, Produktion in 1 bis 3 Werktagen, Abrechnung einmal pro Woche per SEPA."
    image="/img/pod-versand.jpg"
    imageAlt="Packtisch bei westernprint: Reihen fertig verpackter Kraftpapier-Versandtaschen mit Etikett, vorne ein schwarzes Shirt in der offenen Tasche"
    cta={{ label: 'App im Shopify App Store', href: appUrl }}
    cta2={{ label: 'Fragen? Schreib uns', href: '/kontakt' }}
  />

  <section class="section-tight pod-answer-section">
    <div class="container pod-answer">
      <div class="reveal">
        <h2>Wie arbeitet westernprint als Print-on-Demand-Partner?</h2>
        <p class="lede pod-answer-text">westernprint produziert Print-on-Demand-Bestellungen für Shopify-Shops in der eigenen Werkstatt in Oberhausen, per DTF und auf Wunsch per DTG auf Epson SureColor F2100 und F2200. Als Textilien stehen Stanley/Stella, Stedman und Build Your Brand zur Wahl. Die Produktion dauert 1 bis 3 Werktage, jedes Teil wird vor dem Verpacken geprüft. Versendet wird per DHL mit Tracking nach Deutschland, Österreich, in die Schweiz und in alle übrigen EU-Länder, neutral im Namen deines Shops. Angebunden wird der Shop über die eigene App „westernprint POD“ aus dem Shopify App Store. Die Installation ist kostenlos, du zahlst Produktion und Versand der bestellten Artikel, einmal pro Woche per Sammelrechnung und SEPA-Lastschrift. Dein fester Ansprechpartner ist {oeffnungszeiten.text} erreichbar, per WhatsApp, Telefon und E-Mail. Seit 2021 hat westernprint über 80.000 Endkunden von Partner-Shops direkt beliefert. Über 1 Mio. € Umsatz haben unsere Partner-Shops seit 2021 mit Produkten aus unserer Produktion gemacht.</p>
        <a class="rating-line" href="/bewertungen">
          <span class="stars" aria-hidden="true">{Array.from({ length: 5 }).map(() => <Icon name="star" weight="fill" size={16} />)}</span>
          <span>{schnitt} von 5 Sternen bei {bewertungen.anzahl} Google-Bewertungen</span>
        </a>
      </div>
      <dl class="facts reveal reveal-d1" aria-label="Print-on-Demand bei westernprint auf einen Blick">
        <div><dt>Produktion</dt><dd>Eigene Werkstatt in Oberhausen, Deutschland</dd></div>
        <div><dt>Druck</dt><dd>DTF, auf Wunsch DTG</dd></div>
        <div><dt>Textilien</dt><dd>Stanley/Stella, Stedman, Build Your Brand</dd></div>
        <div><dt>Mindestmenge</dt><dd>Keine, ab 1 Stück</dd></div>
        <div><dt>Produktionszeit</dt><dd>1 bis 3 Werktage, auch im Q4</dd></div>
        <div><dt>Lieferzeit</dt><dd>3 bis 5 Werktage ab Bestellung</dd></div>
        <div><dt>Versand</dt><dd>DHL mit Tracking, feste Pauschale pro Bestellung, neutral in deinem Namen</dd></div>
        <div><dt>Liefergebiet</dt><dd>Deutschland, Österreich, Schweiz, alle EU-Länder</dd></div>
        <div><dt>App</dt><dd>Kostenlos, keine Grundgebühr, kein Abo</dd></div>
        <div><dt>Abrechnung</dt><dd>Wöchentliche Sammelrechnung, SEPA-Lastschrift</dd></div>
        <div><dt>Ansprechpartner</dt><dd>Eine feste Person, WhatsApp, Telefon, E-Mail</dd></div>
      </dl>
    </div>
  </section>

  <section class="section app-section" id="app">
    <div class="container app-grid">
      <div class="app-copy reveal">
        <a class="shopify-badge" href={appUrl} target="_blank" rel="noopener">
          <img src="/img/shopify-bag.svg" alt="" width="18" height="20" />
          <span>Verfügbar im <strong>Shopify App Store</strong></span>
        </a>
        <h2>In fünf Schritten startklar. <span class="hl">Dauert keine zehn Minuten.</span></h2>
        <p class="muted">„westernprint POD“ ist unsere eigene Shopify-App. Sie verbindet deinen Shop mit unserer Produktion in Oberhausen. Kein Excel, kein E-Mail-Pingpong, kein Guthaben aufladen.</p>
        <ol class="app-steps">
          {schritte.map((s, i) => (
            <li><span class="num">{i + 1}</span><div><strong>{s.t} <small>{s.zeit}</small></strong><span>{s.d}</span></div></li>
          ))}
        </ol>
        <div class="app-cta">
          <a href={appUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener">App installieren <Icon name="arrow-square-out" size={18} /></a>
          <span class="app-note">Kostenlos. Pro Bestellung zahlst du Produktion und Versand.</span>
        </div>
      </div>
      <a class="app-card reveal reveal-d1" href={appUrl} target="_blank" rel="noopener" aria-label="westernprint POD im Shopify App Store öffnen">
        <div class="app-card-head">
          <img src="/img/pod-app-icon.png" alt="westernprint POD App-Icon" width="72" height="72" />
          <div>
            <strong>westernprint POD</strong>
            <span>Print-on-Demand aus Deutschland: Design hoch, wir drucken, verpacken und versenden per DHL.</span>
          </div>
        </div>
        <ul class="app-facts">
          <li><Icon name="check" weight="bold" size={14} /> Kostenlos installieren, keine App-Gebühr</li>
          <li><Icon name="check" weight="bold" size={14} /> Live-Mockup-Designer mit Produktionspreis</li>
          <li><Icon name="check" weight="bold" size={14} /> Automatischer Bestellimport</li>
          <li><Icon name="check" weight="bold" size={14} /> DHL-Tracking zurück in den Shop</li>
          <li><Icon name="check" weight="bold" size={14} /> Bestehende Produkte zuordnen</li>
        </ul>
        <dl class="app-meta">
          <div><dt>Preis</dt><dd>Kostenlose Installation</dd></div>
          <div><dt>Pro Bestellung</dt><dd>Produktion und Versand</dd></div>
          <div><dt>Plattform</dt><dd>Shopify</dd></div>
          <div><dt>Textilien</dt><dd>Stanley/Stella, Stedman, Build Your Brand</dd></div>
          <div><dt>Im App Store seit</dt><dd>August 2026</dd></div>
        </dl>
        <div class="app-card-foot">
          <img src="/img/shopify-bag.svg" alt="" width="16" height="18" />
          <span>apps.shopify.com/pod-westerprint</span>
          <Icon name="arrow-right" size={16} />
        </div>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Was die App für dich erledigt</h2>
        <p>Alles, was zwischen Design und Paket passiert, läuft in der App und im Portal. Du kümmerst dich um Shop und Marketing.</p>
      </div>
      <div class="grid grid-3">
        {funktionen.map((b, i) => (
          <div class={`feat reveal reveal-d${i % 3}`}>
            <div class="icon-box"><Icon name={b.icon} size={22} /></div>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section marken-section" id="textilien">
    <div class="container">
      <div class="section-head reveal">
        <h2>Textilien von drei Herstellern, mit Nachweis</h2>
        <p>Du wählst in der App aus dem Katalog. Welche Zertifikate ein Artikel trägt, steht direkt am Produkt. Hier die drei Marken und das, was die Hersteller selbst nachweisen.</p>
      </div>
      <div class="grid grid-3">
        {marken.map((m, i) => (
          <div class={`marke reveal reveal-d${i % 3}`}>
            <span class="eyebrow">{m.tag}</span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
            <ul class="certs">
              {m.certs.map((c) => <li><Icon name="seal-check" size={16} /> {c}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="muted small marken-note reveal">Fair Wear ist eine Mitgliedschaft der Marke Stanley/Stella, kein Siegel auf dem Textil. Mehr zu den Standards auf <a href="/druckverfahren" class="accent">Druckverfahren und Zertifikate</a> und <a href="/textilien" class="accent">Textilien</a>.</p>
    </div>
  </section>

  <section class="section druck-section" id="druck">
    <div class="container druck-grid">
      <div class="reveal">
        <h2>Druck: DTF als Standard, DTG auf Wunsch</h2>
        <p class="muted">DTF deckt kräftig auf hellen und dunklen Textilien, auch auf Mischgewebe und Polyester, und bleibt dehnbar und waschfest. DTG druckt direkt in die Baumwollfaser, für einen besonders weichen Griff auf hellen Baumwollshirts. Du wählst das Verfahren im Designer, je Produkt.</p>
        <p class="muted">Vor dem Verpacken prüfen wir jedes Teil: Druckbild, Position, Textil. Druckfehler, die bei uns passieren, drucken wir kostenlos nach.</p>
        <h3>Dateien</h3>
        <ul class="plain">
          <li><Icon name="check" weight="bold" size={14} /> Empfohlen: PNG mit transparentem Hintergrund, 300 dpi in Druckgröße</li>
          <li><Icon name="check" weight="bold" size={14} /> Außerdem möglich: JPG, WEBP, SVG, PDF, AI, EPS, bis 50 MB</li>
          <li><Icon name="check" weight="bold" size={14} /> Der Designer warnt bei zu niedriger Auflösung, weißem Hintergrund und sehr hellen oder sehr dunklen Motiven</li>
          <li><Icon name="check" weight="bold" size={14} /> Je Textilfarbe kannst du eine helle und eine dunkle Motivvariante hinterlegen</li>
        </ul>
      </div>
      <div class="reveal reveal-d1">
        <h3>Druckzonen und maximale Motivbreite</h3>
        <p class="muted small">Beispiel Herren-T-Shirt. Die Zonen sind je Textil kalibriert, die exakten Werte zeigt der Designer. Die Breite stellst du in Zentimetern ein.</p>
        <table class="ptab">
          <thead><tr><th scope="col">Zone</th><th scope="col">Motivbreite bis</th></tr></thead>
          <tbody>
            {zonen.map(([z, b]) => (<tr><th scope="row">{z}</th><td>{b}</td></tr>))}
          </tbody>
        </table>
        <p class="muted small">Zweite Seite und Nackenprint sind Zusatzpositionen, der Ärmeldruck läuft als Zusatzposition über uns. Die Preise dafür siehst du im Designer.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Versand und Lieferzeiten</h2>
        <p>Jede Bestellung geht per DHL mit Tracking direkt an deinen Kunden, neutral verpackt im Namen deines Shops. Der Versand ist eine feste Pauschale pro Bestellung je Zielland, du siehst sie in der App.</p>
      </div>
      <div class="ship-table reveal">
        <div class="ship-row ship-head"><span>Zielland</span><span>Lieferzeit ab Bestellung</span></div>
        {versand.map((v) => (
          <div class="ship-row"><span>{v.land}{v.hinweis && <small class="ship-countries">{v.hinweis}</small>}</span><span>3 bis 5 Werktage</span></div>
        ))}
      </div>
      <p class="muted small ship-note">Die Lieferzeit enthält die Produktion von 1 bis 3 Werktagen. Länder außerhalb der EU beliefern wir nicht.</p>
      <div class="grid grid-3 versand-extra">
        {[
          { icon: 'package', t: 'Neutral in deinem Namen', d: 'Kein westernprint-Logo, keine Rechnung von uns im Paket. Dein Kunde sieht nur deinen Shop.' },
          { icon: 'map-pin', t: 'Absender nach Wahl', d: 'Standard ist unsere Versandhalle in Oberhausen. Mit einer Adresse in Deutschland kannst du deine eigene als Absender eintragen.' },
          { icon: 'truck', t: 'Tracking automatisch', d: 'Die DHL-Sendungsnummer geht als Fulfillment an Shopify. Dein Kunde bekommt die Versandbestätigung aus deinem Shop.' },
        ].map((b, i) => (
          <div class={`feat reveal reveal-d${i}`}>
            <div class="icon-box"><Icon name={b.icon} size={22} /></div>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight branding-section" id="branding">
    <div class="container branding-grid">
      <div class="reveal">
        <span class="eyebrow">Branding</span>
        <h2>Dein Label, ab dem ersten Teil</h2>
        <p class="muted">Bei vielen Anbietern gibt es Branding nur für bestimmte Produktlinien oder mit Mindestmengen und Wochen Vorlauf. Bei uns ab 1 Stück, ohne Vorproduktion.</p>
      </div>
      <ul class="branding-list reveal reveal-d1">
        <li><Icon name="tag" size={20} /><div><strong>Nackenprint statt Herstelleretikett</strong><span>Dein Logo oder Größenlabel im Nacken, per DTF gedruckt, waschfest. Viele Build-Your-Brand-Modelle kommen ohne Etikett, Stanley/Stella mit Tearaway-Label.</span></div></li>
        <li><Icon name="t-shirt" size={20} /><div><strong>Ärmeldruck</strong><span>Kleines Logo oder Schriftzug auf dem Ärmel als Zusatzposition.</span></div></li>
        <li><Icon name="package" size={20} /><div><strong>Dein eigenes Verpackungsmaterial</strong><span>Gebrandete Versandtaschen oder Kartons lieferst du an uns, wir verpacken deine Bestellungen damit.</span></div></li>
        <li><Icon name="eye-slash" size={20} /><div><strong>Neutraler Versand ist Standard</strong><span>Kein westernprint-Branding im oder am Paket, auf Wunsch deine Adresse als Absender.</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section-tight abrechnung-section" id="abrechnung">
    <div class="container">
      <div class="section-head reveal">
        <h2>Kosten und Abrechnung</h2>
        <p>Keine Grundgebühr, kein Abo, kein Mindestumsatz, kein Guthaben. Du zahlst, was produziert wurde.</p>
      </div>
      <div class="grid grid-3">
        {[
          { icon: 'eye', t: 'Produktionspreis vor dem Veröffentlichen', d: 'Jedes Produkt zeigt dir in der App den Produktionspreis inklusive Druck, bevor es in deinen Shop geht. Dazu ein Vorschlag für den Verkaufspreis. Deine Marge legst du selbst fest.' },
          { icon: 'receipt', t: 'Eine Sammelrechnung pro Woche', d: 'Montags bekommst du die Rechnung über alle Artikel der Vorwoche, mit 14 Tagen Zahlungsziel. Eine Rechnung statt vieler Einzelabbuchungen.' },
          { icon: 'bank', t: 'SEPA-Lastschrift', d: 'Das Mandat erteilst du in der App, es ist Pflicht vor dem ersten Druck. Die Rechnung wird per Lastschrift eingezogen, du musst nichts vorab aufladen.' },
        ].map((b, i) => (
          <div class={`feat reveal reveal-d${i}`}>
            <div class="icon-box"><Icon name={b.icon} size={22} /></div>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
      <p class="muted small abrechnung-note reveal">Produziert wird, sobald die Bestellung in deinem Shop bezahlt ist. Stornieren kannst du bis zum Druckstart, kurz per WhatsApp oder E-Mail.</p>
    </div>
  </section>

  <section class="section compare-section">
    <div class="container">
      <div class="section-head reveal">
        <h2>Werkstatt statt Plattform</h2>
        <p>Was auf den Seiten der großen Print-on-Demand-Anbieter steht, und was bei uns anders läuft. Ohne Namen, aber ehrlich.</p>
      </div>
      <div class="table-wrap reveal">
        <table class="cmp-table">
          <thead><tr><th></th><th class="hi">westernprint</th><th>Große POD-Plattform</th><th>POD-Marktplatz</th></tr></thead>
          <tbody>
            {vergleich.map((r) => (<tr><th scope="row">{r.k}</th><td class="hi">{r.wp}</td><td>{r.pl}</td><td>{r.mp}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="compare-summary reveal">Große Plattformen haben den größeren Katalog und mehr Integrationen. Wir haben eine Werkstatt, in der du anrufen kannst, feste Pauschalen statt Überraschungen, Branding ab dem ersten Teil und eine Rechnung pro Woche statt Guthaben. Wer das braucht, ist bei uns richtig.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="case-grid">
        <div class="reveal">
          <span class="eyebrow">Fallbeispiel</span>
          <h2>Miriam: von 8 Tagen Lieferzeit zu ruhigem Schlaf</h2>
          <p class="muted">Miriam betreibt seit über zwei Jahren einen Shopify-Store für personalisierte Geschenke. Beim alten Anbieter löste sich der Druck nach wenigen Wäschen, der Versand dauerte bis zu 8 Werktage, der Support war nicht erreichbar. Sie verlor Stammkunden und bekam schlechte Bewertungen.</p>
          <p class="muted">Seit Oktober 2023 produziert sie mit uns. Auch in der Black Week und zu Weihnachten produzieren und versenden wir ihre Bestellungen in 1 bis 3 Werktagen.</p>
          <blockquote>„Ich schlafe wieder ruhig, weil ich weiß, dass jede Bestellung sitzt. Egal ob im Januar oder mitten im Weihnachtsstress.“<footer>Miriam, Kundin seit Oktober 2023</footer></blockquote>
        </div>
        <ul class="results reveal reveal-d1">
          <li><strong>über 70 %</strong><span>weniger Reklamationen</span></li>
          <li><strong>+4 %</strong><span>wiederkehrende Kunden</span></li>
          <li><strong>+1.900 €</strong><span>Monatsumsatz durch zufriedenere Kunden</span></li>
          <li><strong>Bestpreis</strong><span>günstiger als der alte Anbieter, bei besserer Qualität</span></li>
        </ul>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Fragen zum Print-on-Demand" intro="Die Fragen, die uns Shopify-Händler vor dem Start stellen." />
  <CtaBand title="Shop verbinden oder erst mal reden?" text="Installiere die App und leg los, oder schreib uns per WhatsApp, was du verkaufst. Wir sagen dir ehrlich, ob und wie wir dein Sortiment produzieren." />
</Base>

