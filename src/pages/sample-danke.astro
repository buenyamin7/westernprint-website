---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Dein Sample" description="Bestätigung für dein kostenloses Sample." noindex={true} hideCta={true}>
  <section class="section">
    <div class="container done" data-endpoint={site.checkoutApi} data-state="loading" aria-busy="true">
      <div class="icon-box big">
        <span data-icon="loading" class="spin"><Icon name="circle-notch" weight="bold" size={28} /></span>
        <span data-icon="ok" hidden><Icon name="check" weight="bold" size={28} /></span>
        <span data-icon="pending" hidden><Icon name="hourglass" weight="bold" size={28} /></span>
        <span data-icon="problem" hidden><Icon name="warning" weight="bold" size={28} /></span>
      </div>
      <h1 data-h1>Wir prüfen deine Sample-Bestellung...</h1>
      <p class="lede" data-msg aria-live="polite">Einen Moment bitte.</p>
      <div class="card card-pad summary" data-summary hidden>
        <p><strong>Referenz:</strong> <span data-no></span></p>
        <p><strong>Shop:</strong> <span data-store></span> · Größe <span data-size></span></p>
        <p class="muted small">Bestätigung geht an <span data-email></span>.</p>
      </div>
      <p class="muted" data-pod hidden>Wenn dir das Shirt gefällt: Antworte einfach auf die Mail oder schreib uns per <a href={site.whatsapp} class="accent" target="_blank" rel="noopener">WhatsApp</a>, dann besprechen wir die Anbindung deines Shops.</p>
      <div class="card card-pad contact" data-contact hidden>
        <div class="actions">
          <a href={site.whatsapp} data-contact-wa data-no-track class="btn btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp-logo" size={18} /> Per WhatsApp</a>
          <a href={`mailto:${site.email}`} data-contact-mail class="btn btn-secondary"><Icon name="envelope" size={18} /> Per E-Mail</a>
        </div>
        <p class="muted small">WhatsApp {site.phone} · {site.email}</p>
      </div>
      <div class="actions">
        <a href="/sample" class="btn btn-primary" data-retry hidden>Erneut versuchen <Icon name="arrow-right" size={18} /></a>
        <button type="button" class="btn btn-secondary" data-reload hidden><Icon name="arrow-clockwise" size={18} /> Status neu laden</button>
        <a href="/print-on-demand" class="btn btn-secondary">So läuft Fulfillment mit westernprint</a>
      </div>
    </div>
  </section>
</Base>
<script>
  const root = document.querySelector<HTMLElement>('.done')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const no = new URLSearchParams(location.search).get('s');
  const sampleNo = no && /^SP-[A-Z0-9-]{6,20}$/.test(no) ? no : ''; // Format wie im Kassen-Worker (sampleStatus)

  // Statuswerte aus dem Kassen-Worker bzw. Airtable "Sample-Anfragen" (Feld Status). Neu = bezahlt.
  type State = 'ok' | 'pending' | 'failed' | 'cancelled' | 'unclear';
  const STATUS: Record<string, [State, string, string]> = {
    'Neu': ['ok', 'Danke, dein Sample ist reserviert.', 'Wir packen es in den nächsten 1 bis 2 Werktagen und schicken dir die Sendungsnummer.'],
    'Versendet': ['ok', 'Dein Sample ist unterwegs.', ''],
    'Zahlung offen': ['pending', 'Deine Zahlung wird noch verarbeitet.', 'Sobald sie bestätigt ist, geht das Sample raus. Bitte schick die Anfrage in der Zwischenzeit nicht noch einmal ab.'],
    'Abgebrochen': ['failed', 'Die Zahlung wurde nicht abgeschlossen.', 'Du kannst es erneut versuchen.'],
    'Storniert': ['cancelled', 'Dieses Sample wurde storniert.', 'Fragen dazu? Schreib uns per WhatsApp oder E-Mail.'],
  };

  function show(state: State, title: string, text: string, reload = state === 'pending' || (state === 'unclear' && !!sampleNo)) {
    root.dataset.state = state; root.removeAttribute('aria-busy');
    const icon = state === 'ok' ? 'ok' : state === 'pending' ? 'pending' : 'problem';
    root.querySelectorAll<HTMLElement>('[data-icon]').forEach((el) => (el.hidden = el.dataset.icon !== icon));
    $('[data-h1]').textContent = title; $('[data-msg]').textContent = text;
    $('[data-retry]').hidden = state !== 'failed';
    $('[data-reload]').hidden = !reload;
    $('[data-contact]').hidden = !(state === 'unclear' || state === 'cancelled');
    $('[data-pod]').hidden = state !== 'ok';
  }

  // Kontaktknöpfe mit Referenz vorbefüllen.
  function prefillContact() {
    const text = encodeURIComponent(`Hallo, ich habe eine Frage zu meinem Sample ${sampleNo}.`);
    $<HTMLAnchorElement>('[data-contact-wa]').href += `?text=${text}`;
    $<HTMLAnchorElement>('[data-contact-mail]').href += `?subject=${encodeURIComponent('Sample ' + sampleNo)}&body=${text}`;
  }

  // Keine Nummer, unbekannte Referenz, Fehler: nichts behaupten, Kontaktweg zeigen.
  function unclear() {
    if (!sampleNo) return show('unclear', 'Wir können diesen Link keinem Sample zuordnen.', 'Wenn du gerade bezahlt hast oder eine Frage zu deinem Sample hast, schreib uns per WhatsApp oder E-Mail.');
    show('unclear', 'Wir können dein Sample gerade nicht abrufen.', `Wenn du gerade bezahlt hast, schick die Anfrage bitte nicht noch einmal ab, sondern schreib uns per WhatsApp oder E-Mail mit deiner Referenz ${sampleNo}. Dann sehen wir nach.`);
    prefillContact();
  }

  // Sample gefunden, aber Status nicht in der Tabelle: neutral bleiben, Neuladen hilft hier nicht.
  function otherStatus() {
    show('unclear', `Dein Sample ${sampleNo}`, 'Den genauen Stand können wir dir hier nicht anzeigen. Schreib uns per WhatsApp oder E-Mail mit deiner Referenz, dann sehen wir für dich nach.', false);
    prefillContact();
  }

  function render(o: any) {
    const entry = STATUS[o.status];
    if (!entry) return otherStatus();
    const [state, title, text] = entry;
    show(state, title, text);
    if (state === 'ok' || state === 'pending') {
      $('[data-no]').textContent = o.no; $('[data-store]').textContent = o.store; $('[data-size]').textContent = o.size; $('[data-email]').textContent = o.email;
      $('[data-summary]').hidden = false;
    }
    if (o.status === 'Versendet') {
      const msg = $('[data-msg]'); msg.textContent = o.tracking ? `Sendungsnummer ${o.tracking}. ` : 'Das Paket wurde übergeben.';
      if (o.tracking && o.trackingUrl) { const a = document.createElement('a'); a.href = o.trackingUrl; a.className = 'accent'; a.target = '_blank'; a.rel = 'noopener'; a.textContent = 'Sendung verfolgen'; msg.append(a); }
    }
  }

  $('[data-reload]').addEventListener('click', () => location.reload());
  if (!sampleNo) unclear();
  else fetch(`${root.dataset.endpoint}/sample-status?s=${encodeURIComponent(sampleNo)}`, { signal: AbortSignal.timeout?.(15000) })
    .then(async (r) => { const o = await r.json(); if (!r.ok || !o.no) throw new Error('Sample nicht gefunden'); return o; })
    .then(render)
    .catch(unclear);
</script>
<style>
  .done { max-width: 640px; display: grid; gap: 22px; justify-items: start; }
  .big { width: 60px; height: 60px; border-radius: 16px; }
  .big > span { display: grid; place-items: center; }
  .done[data-state="loading"] .big, .done[data-state="pending"] .big, .done[data-state="unclear"] .big { color: var(--text-2); }
  .done[data-state="failed"] .big, .done[data-state="cancelled"] .big { color: var(--danger); }
  .spin { animation: wp-spin 1s linear infinite; }
  @keyframes wp-spin { to { transform: rotate(360deg); } }
  .summary { width: 100%; display: grid; gap: 8px; } .small { font-size: 13px; }
  .contact { width: 100%; display: grid; gap: 10px; justify-items: start; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
