---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Warenkorb" description="Dein Warenkorb bei westernprint." noindex={true}>
  <section class="section">
    <div class="container cart-wrap">
      <h1>Warenkorb</h1>
      <div data-cart-root data-endpoint={site.checkoutApi}>
        <div class="empty" data-cart-empty hidden>
          <p class="lede">Dein Warenkorb ist leer.</p>
          <a href="/shop" class="btn btn-primary">Zum Shop</a>
        </div>
        <div class="cart-grid" data-cart-full hidden>
          <ul class="lines" data-cart-lines></ul>
          <aside class="card card-pad summary">
            <dl>
              <div><dt>Zwischensumme</dt><dd data-cart-subtotal></dd></div>
            </dl>
            <p class="muted small">inkl. MwSt. Versand wird an der Kasse gewählt: Deutschland 4,90 €, Österreich, Schweiz und EU 9,90 €.</p>
            <a href="/kasse" class="btn btn-primary btn-lg" data-cart-checkout>Zur Kasse <Icon name="arrow-right" size={18} /></a>
            <a href="/shop" class="btn btn-secondary">Weiter einkaufen</a>
            <p class="muted small">Sichere Bezahlung über Mollie: PayPal, Klarna, Kreditkarte, Apple Pay, SEPA.</p>
          </aside>
        </div>
        <p class="form-note err" data-cart-error hidden></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { getCart, updateQty, removeItem, lineTotal, subtotal, euro, type CartItem } from '../scripts/cart';
  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const link = (u?: string) => !u ? 'Kein Motiv, wird nachgereicht' : /^https?:/.test(u) ? `<a href="${esc(u)}" target="_blank" rel="noopener" class="accent">Datei ansehen</a>` : esc(u);

  function render(items: CartItem[]) {
    const empty = items.length === 0;
    $('[data-cart-empty]').hidden = !empty;
    $('[data-cart-full]').hidden = empty;
    if (empty) return;
    $('[data-cart-subtotal]').textContent = euro(subtotal(items));
    $('[data-cart-lines]').innerHTML = items.map((i) => `<li class="line" data-line="${i.id}">
        ${i.image ? `<img src="${esc(i.image)}" alt="" width="90" height="112">` : '<div class="thumb-empty"></div>'}
        <div class="line-body">
          <strong>${esc(i.title)}</strong>
          <span class="muted">${esc(i.color)} / ${esc(i.size)}</span>
          <ul class="attrs">
            <li><span>Druckseite:</span> ${esc(i.side)}</li>
            ${i.sizeFront ? `<li><span>Vorne ${esc(i.sizeFront)} (+${euro(0).slice(0, 0)}${i.sizeFront === 'A6' ? '5' : i.sizeFront === 'A5' ? '6' : i.sizeFront === 'A4' ? '7' : '9'} €):</span> ${link(i.uploadFront)}</li>` : ''}
            ${i.sizeBack ? `<li><span>Hinten ${esc(i.sizeBack)}:</span> ${link(i.uploadBack)}</li>` : ''}
          </ul>
        </div>
        <div class="line-side">
          <div class="qty"><button type="button" data-qty="-1" aria-label="Weniger">−</button><span>${i.quantity}</span><button type="button" data-qty="1" aria-label="Mehr">+</button></div>
          <strong>${euro(lineTotal(i))}</strong>
          <button type="button" class="remove" data-remove>Entfernen</button>
        </div>
      </li>`).join('');
  }
  function fail(msg: string) { const el = $('[data-cart-error]'); el.hidden = false; el.textContent = msg; }

  $('[data-cart-lines]').addEventListener('click', (e) => {
    const t = e.target as HTMLElement; const li = t.closest<HTMLElement>('[data-line]'); if (!li) return;
    const id = li.dataset.line!;
    if (t.matches('[data-remove]')) render(removeItem(id));
    else if (t.matches('[data-qty]')) { const cur = Number(li.querySelector('.qty span')!.textContent); render(updateQty(id, cur + Number(t.getAttribute('data-qty')))); }
  });
  render(getCart());
</script>

<style>
  .cart-wrap h1 { margin-bottom: 28px; }
  .cart-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 32px; align-items: start; }
  .lines { display: grid; gap: 12px; }
  .lines :global(.line) { display: grid; grid-template-columns: 90px 1fr auto; gap: 16px; padding: 16px; border-radius: var(--radius-card); border: 1px solid var(--line); background: var(--surface); align-items: start; }
  .lines :global(.line img) { border-radius: 8px; background: #fff; }
  .lines :global(.thumb-empty) { width: 90px; height: 112px; border-radius: 8px; background: var(--surface-2); }
  .lines :global(.line-body) { display: flex; flex-direction: column; gap: 4px; font-size: 14.5px; }
  .lines :global(.attrs) { display: grid; gap: 2px; font-size: 13px; color: var(--text-2); margin-top: 6px; }
  .lines :global(.attrs span) { color: var(--text-3); }
  .lines :global(.line-side) { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .lines :global(.qty) { display: inline-flex; align-items: center; border: 1px solid var(--line-strong); border-radius: 999px; }
  .lines :global(.qty button) { width: 30px; height: 30px; border: 0; background: transparent; cursor: pointer; font-size: 16px; color: var(--text); }
  .lines :global(.qty span) { min-width: 24px; text-align: center; font-size: 14px; }
  .lines :global(.remove) { border: 0; background: transparent; color: var(--text-3); font-size: 13px; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .summary { display: grid; gap: 14px; position: sticky; top: calc(var(--nav-h) + 24px); }
  .summary dl { margin: 0; } .summary dl div { display: flex; justify-content: space-between; font-size: 16px; font-weight: 600; }
  .summary dd { margin: 0; }
  .small { font-size: 13px; }
  .empty { display: grid; gap: 20px; justify-items: start; }
  @media (max-width: 800px) { .cart-grid { grid-template-columns: 1fr; } .summary { position: static; } .lines :global(.line) { grid-template-columns: 70px 1fr; } .lines :global(.line-side) { grid-column: 1 / 3; flex-direction: row; justify-content: space-between; align-items: center; } }
</style>
